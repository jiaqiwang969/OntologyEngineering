{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-engineering:cad-evidence:v1",
  "title": "Source-bound, CAD-system-independent project evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "packet_id", "project", "sources", "objects", "relations", "requirements", "assertions", "questions"],
  "properties": {
    "record_type": {"const": "ontology-engineering.cad-evidence/v1"},
    "packet_id": {"$ref": "#/$defs/id"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "configuration_id", "model_revision", "product_state"],
      "properties": {
        "project_id": {"$ref": "#/$defs/id"},
        "configuration_id": {"$ref": "#/$defs/id"},
        "model_revision": {"type": "string", "minLength": 1},
        "product_state": {"type": "string", "minLength": 1}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "objects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/object"}},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "assertions": {"type": "array", "items": {"$ref": "#/$defs/assertion"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonempty_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "media_type", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 3},
        "role": {"enum": ["native_model", "native_readback", "drawing", "bom", "simulation_input", "simulation_result", "measurement", "process_record", "reference_media", "patent_document", "analysis_record", "other"]},
        "embedded_source_hashes": {"type": "object", "propertyNames": {"pattern": "^/"}, "additionalProperties": {"$ref": "#/$defs/id"}}
      }
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "statement", "identity_scope", "basis", "source_id", "source_locator"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["observed", "candidate"]},
        "identity_scope": {"enum": ["project_stable", "persistent_native", "model_revision", "provisional_import"]},
        "basis": {"$ref": "#/$defs/basis"},
        "source_id": {"$ref": "#/$defs/id"},
        "source_locator": {"type": "string", "minLength": 1},
        "expected": {"type": "object", "minProperties": 1}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "subject_id", "predicate", "object_id", "statement", "status", "basis", "source_id", "source_locator"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "subject_id": {"$ref": "#/$defs/id"},
        "predicate": {"type": "string", "minLength": 1},
        "object_id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["observed", "candidate"]},
        "basis": {"$ref": "#/$defs/basis"},
        "source_id": {"$ref": "#/$defs/id"},
        "source_locator": {"type": "string", "minLength": 1},
        "expected": {"type": "object", "minProperties": 1}
      }
    },
    "basis": {"enum": ["native_readback", "drawing_review", "bom_review", "simulation_result", "measurement", "visual_review", "patent_review", "analytic_derivation", "engineering_inference"]},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "status", "target_ids", "source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "status": {"enum": ["required", "candidate"]},
        "target_ids": {"$ref": "#/$defs/ids"},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "scope", "maturity", "target_ids", "depends_on_ids", "source_ids", "challenge_source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "maturity": {"enum": ["hypothesis", "bounded_observation"]},
        "target_ids": {"$ref": "#/$defs/ids"},
        "depends_on_ids": {"$ref": "#/$defs/ids"},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "challenge_source_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "status", "target_ids", "source_ids", "requested_evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "answered", "withdrawn"]},
        "target_ids": {"$ref": "#/$defs/nonempty_ids"},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "requested_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
