@@ -0,0 +1,156 @@
+package app
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"strconv"
+	"strings"
+	"testing"
+	"time"
+)
+
+// This stub observes actual CLI HTTP requests; it runs no connector or EDA work.
+func callTimeoutDaemon(t *testing.T, response string) (*appConfig, chan map[string]any) {
+	t.Helper()
+	requests := make(chan map[string]any, 8)
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/health":
+			_, _ = io.WriteString(w, `{"service":"easyeda-agent","windows":[]}`)
+		case "/action":
+			var body map[string]any
+			if err := json.NewDecoder(r.Body).Decode(&body); err != nil {
+				t.Error(err)
+				return
+			}
+			requests <- body
+			_, _ = io.WriteString(w, response)
+		default:
+			http.NotFound(w, r)
+		}
+	}))
+	t.Cleanup(srv.Close)
+	host, port, err := net.SplitHostPort(strings.TrimPrefix(srv.URL, "http://"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	return &appConfig{host: host, ports: port + "-" + port}, requests
+}
+
+func TestCallTimeoutWireBudget(t *testing.T) {
+	for _, tt := range []struct {
+		name, action, flag string
+		want               int
+	}{
+		{"ordinary-default", "system.health", "", 20000},
+		{"import-default", "pcb.import_changes", "", 90000},
+		{"import-explicit-shorter", "pcb.import_changes", "20s", 20000},
+		{"ordinary-explicit-longer", "system.health", "1m30s", 90000},
+		{"minimum", "system.health", "5s", 5000},
+		{"maximum", "system.health", "10m", 600000},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg, requests := callTimeoutDaemon(t, `{"ok":true,"result":{"ready":true}}`)
+			var out, errout bytes.Buffer
+			cmd := newCallCmd(cfg, &out, &errout)
+			args := []string{tt.action}
+			if tt.flag != "" {
+				args = append(args, "--timeout", tt.flag)
+			}
+			cmd.SetArgs(args)
+			if err := cmd.Execute(); err != nil {
+				t.Fatalf("call: %v", err)
+			}
+			body := <-requests
+			if body["action"] != tt.action || body["timeoutMs"] != float64(tt.want) {
+				t.Fatalf("wire budget not propagated: %v", body)
+			}
+		})
+	}
+}
+
+func TestCallInvalidTimeoutRefusedBeforeDispatch(t *testing.T) {
+	for _, value := range []string{"0s", "-1s", "4s", "1ms", "601s", "90", "NaNs", "999999999999999999999h"} {
+		t.Run(value, func(t *testing.T) {
+			cfg, requests := callTimeoutDaemon(t, `{"ok":true}`)
+			cmd := newCallCmd(cfg, io.Discard, io.Discard)
+			cmd.SetArgs([]string{"pcb.import_changes", "--timeout", value})
+			cmd.SetOut(io.Discard)
+			cmd.SetErr(io.Discard)
+			if err := cmd.Execute(); err == nil {
+				t.Fatal("invalid timeout accepted")
+			}
+			if len(requests) != 0 {
+				t.Fatal("invalid timeout issued an action")
+			}
+		})
+	}
+}
+
+func TestCallTimeoutDoesNotPromoteDispatchFailure(t *testing.T) {
+	response := `{"ok":false,"error":{"code":"DISPATCH_FAILED","message":"connector did not respond","detail":"context deadline exceeded"}}`
+	cfg, requests := callTimeoutDaemon(t, response)
+	var out bytes.Buffer
+	cmd := newCallCmd(cfg, &out, io.Discard)
+	cmd.SetArgs([]string{"pcb.import_changes", "--timeout", "90s"})
+	if err := cmd.Execute(); !errors.Is(err, errActionFailed) {
+		t.Fatalf("failed response promoted or changed: %v", err)
+	}
+	if strings.TrimSpace(out.String()) != response {
+		t.Fatalf("failure body not preserved: %s", out.String())
+	}
+	if (<-requests)["timeoutMs"] != float64(90000) {
+		t.Fatal("explicit budget lost")
+	}
+}
+
+func TestApplyRunCallTimeoutPropagationAndPrecedence(t *testing.T) {
+	ptr := func(n int) *int { return &n }
+	for _, tt := range []struct {
+		name, run      string
+		defaults, step *int
+		flags          map[string]any
+		args           []string
+		want           int
+	}{
+		{name: "unconfigured-import-keeps-special-default", run: "call pcb.import_changes", want: 90000},
+		{name: "default-policy-propagates", run: "call system.health", defaults: ptr(30), want: 30000},
+		{name: "step-policy-over-default", run: "call pcb.import_changes", defaults: ptr(30), step: ptr(90), want: 90000},
+		{name: "explicit-flag-over-policy", run: "call pcb.import_changes", step: ptr(90), flags: map[string]any{"timeout": "60s"}, want: 60000},
+		{name: "explicit-arg-over-policy", run: "call pcb.import_changes", step: ptr(90), args: []string{"--timeout=50s"}, want: 50000},
+		{name: "run-text-over-policy", run: "call pcb.import_changes --timeout 40s", step: ptr(90), want: 40000},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			cfg, requests := callTimeoutDaemon(t, `{"ok":true,"result":{"ready":true}}`)
+			runner := &applyRunner{cfg: cfg, pb: &playbook{Defaults: stepPolicy{TimeoutSec: tt.defaults}}, vars: map[string]string{}, stdout: io.Discard, stderr: io.Discard, quiet: true}
+			step := &playbookStep{Run: tt.run, Args: tt.args, Flags: tt.flags, stepPolicy: stepPolicy{TimeoutSec: tt.step}}
+			budget, _, _ := runner.policy(step)
+			if _, err := runner.executeOnce(step, budget); err != nil {
+				t.Fatalf("execute: %v", err)
+			}
+			if got := (<-requests)["timeoutMs"]; got != float64(tt.want) {
+				t.Fatalf("budget got %v want %d", got, tt.want)
+			}
+		})
+	}
+}
+
+func TestApplyRunCallInvalidPolicyRefusedBeforeDispatch(t *testing.T) {
+	for _, seconds := range []int{0, -1, 4, 601} {
+		t.Run(strconv.Itoa(seconds), func(t *testing.T) {
+			cfg, requests := callTimeoutDaemon(t, `{"ok":true}`)
+			runner := &applyRunner{cfg: cfg, pb: &playbook{}, vars: map[string]string{}, stdout: io.Discard, stderr: io.Discard, quiet: true}
+			step := &playbookStep{Run: "call pcb.import_changes", stepPolicy: stepPolicy{TimeoutSec: &seconds}}
+			_, err := runner.executeOnce(step, time.Duration(seconds)*time.Second)
+			if err == nil || len(requests) != 0 {
+				t.Fatal(fmt.Sprintf("invalid policy dispatched: %d, %v", seconds, err))
+			}
+		})
+	}
+}
