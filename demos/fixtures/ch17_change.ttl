# ch17 场景：变更 0091 换掉软件维旧值；三张绑定旧值的通过 + 冲振卡（环境维）
@prefix chg: <https://product-trustworthiness.local/change#> .

chg:Change_0091 chg:changedDimension chg:Dim_Software ;
                chg:changedFrom      chg:SW_183 .

chg:Pass_SwReg          a chg:PassRecord ; chg:boundValue chg:SW_183 .
chg:Pass_HilRun         a chg:PassRecord ; chg:boundValue chg:SW_183 .
chg:Pass_FaultInjection a chg:PassRecord ; chg:boundValue chg:SW_183 .
chg:boundValue chg:bindsDimension chg:Dim_Software .

# 冲振卡：绑定环境维，本次变更未触碰
chg:Pass_Vibration a chg:PassRecord ; chg:boundEnv chg:Env_V2 .
chg:boundEnv chg:bindsDimension chg:Dim_Environment .
