+package app
+
+import (
+	"bytes"
+	"testing"
+
+	"github.com/zhoushoujianwork/easyeda-agent/internal/protocol"
+)
+
+func TestPCBInspectionCommandsCarryExplicitInputs(t *testing.T) {
+	for _, tc := range []struct {
+		args   []string
+		action string
+		want   map[string]any
+	}{
+		{[]string{"export-netlist", "--project-uuid", "P", "--pcb-uuid", "B", "--name", "native"}, "pcb.export.netlist", map[string]any{"projectUuid": "P", "pcbUuid": "B", "fileName": "native"}},
+		{[]string{"list", "--include-properties", "--include-pads"}, "pcb.components.list", map[string]any{"includeProperties": true, "includePads": true}},
+		{[]string{"list"}, "pcb.components.list", nil},
+	} {
+		cfg, cap, cleanup := newCapturingDaemon(t)
+		var stdout, stderr bytes.Buffer
+		cmd := newPcbCmd(cfg, &stdout, &stderr)
+		cmd.SetArgs(tc.args)
+		if err := cmd.Execute(); err != nil {
+			cleanup()
+			t.Fatal(err)
+		}
+		cap.mu.Lock()
+		if cap.action != tc.action {
+			t.Errorf("action = %s, want %s", cap.action, tc.action)
+		}
+		for key, val := range tc.want {
+			if cap.payload[key] != val {
+				t.Errorf("payload[%s] = %#v, want %#v", key, cap.payload[key], val)
+			}
+		}
+		if len(tc.want) == 0 {
+			if _, ok := cap.payload["includeProperties"]; ok {
+				t.Error("properties enabled without explicit opt-in")
+			}
+		}
+		cap.mu.Unlock()
+		cleanup()
+	}
+}
+
+func TestPCBNetlistRequiresBothIdentities(t *testing.T) {
+	for _, args := range [][]string{nil, {"--project-uuid", "P"}, {"--pcb-uuid", "B"}} {
+		var stdout, stderr bytes.Buffer
+		window := ""
+		cmd := newPcbNetlistExportCmd(&appConfig{}, &window, &stdout, &stderr)
+		cmd.SetArgs(args)
+		if err := cmd.Execute(); err == nil {
+			t.Fatal("unbound netlist export was accepted")
+		}
+	}
+}
+
+func TestPCBInspectionCatalogIsReadOnly(t *testing.T) {
+	wanted := map[string]bool{"pcb.export.netlist": false, "pcb.components.list": false}
+	for _, action := range protocol.AllActions() {
+		if _, ok := wanted[action.Name]; !ok {
+			continue
+		}
+		wanted[action.Name] = true
+		if action.Mutates || action.NeedsConfirm || !action.NeedsWindow {
+			t.Errorf("incorrect inspection classification: %+v", action)
+		}
+	}
+	for name, found := range wanted {
+		if !found {
+			t.Errorf("missing action %s", name)
+		}
+	}
+}
