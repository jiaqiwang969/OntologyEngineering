+
+test('context changes while producing or reading the file reject the result', async () => {
+	for (const target of ['project', 'pcb', 'tab', 'duringByteRead']) {
+		const { state } = fixture();
+		state.afterExport = () => {
+			if (target === 'project') state.project = 'other';
+			if (target === 'pcb') state.pcb = 'other';
+			if (target === 'tab') state.doc.tabId = 'other';
