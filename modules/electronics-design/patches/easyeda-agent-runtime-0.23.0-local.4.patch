+++ b/internal/app/cmd_native_exports.go
@@ -0,0 +1,54 @@
+package app
+
+import (
+	"fmt"
+	"io"
+	"time"
+
+	"github.com/spf13/cobra"
+)
+
+// Both exports assert an explicit project identity inside the connector, in
+// addition to daemon window routing. Exported bytes do not imply acceptance.
+func newNativeExportCmd(cfg *appConfig, window *string, pcb bool, stdout, stderr io.Writer) *cobra.Command {
+	use, action := "export", "project.export"
+	if pcb {
+		use, action = "export-gerber", "pcb.export.gerber"
+	}
+	return newBoundNativeExportCmd(cfg, window, use, action, pcb, stdout, stderr)
+}
+
+func newPcbNetlistExportCmd(cfg *appConfig, window *string, stdout, stderr io.Writer) *cobra.Command {
+	return newBoundNativeExportCmd(cfg, window, "export-netlist", "pcb.export.netlist", true, stdout, stderr)
+}
+
+func newBoundNativeExportCmd(cfg *appConfig, window *string, use, action string, pcb bool, stdout, stderr io.Writer) *cobra.Command {
+	var projectUUID, pcbUUID, name string
+	c := &cobra.Command{
+		Use:   use,
+		Short: "Export original native bytes with explicit project identity (no acceptance granted)",
+		Args:  cobra.NoArgs,
+		RunE: func(cmd *cobra.Command, args []string) error {
+			if projectUUID == "" {
+				return fmt.Errorf("--project-uuid is required")
+			}
+			p := map[string]any{"projectUuid": projectUUID}
+			if pcb {
+				if pcbUUID == "" {
+					return fmt.Errorf("--pcb-uuid is required")
+				}
+				p["pcbUuid"] = pcbUUID
+			}
+			if name != "" {
+				p["fileName"] = name
+			}
+			return dispatchTimed(cfg, action, *window, p, 120*time.Second, stdout, stderr)
+		},
+	}
+	c.Flags().StringVar(&projectUUID, "project-uuid", "", "expected current project UUID (required)")
+	c.Flags().StringVar(&name, "name", "", "export file name")
+	if pcb {
+		c.Flags().StringVar(&pcbUUID, "pcb-uuid", "", "expected active PCB UUID (required)")
+	}
+	return c
+}
