{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/semantic-batch-audit-manifest-v1.json",
  "title": "Explicit semantic batch audit manifest",
  "description": "Closed, explicit inventory of hash-bound shadow semantic source sets and optional manifest-scoped inputs for conditional release assessment. Array order has no semantic authority; the auditor normalizes it before deriving the manifest digest. This manifest is not an independent policy trust root and cannot authorize release review, activation, or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "manifest_version",
    "items"
  ],
  "properties": {
    "schema": {
      "const": "cad-agent.semantic-batch-audit-manifest.v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/stableId"
    },
    "manifest_version": {
      "$ref": "#/$defs/semver"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/auditItem"
      }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "jsonAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "asset_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/projectPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "const": "application/json"
        }
      }
    },
    "jsonAssetRefSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/jsonAssetRef"
      }
    },
    "nullableJsonAssetRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/jsonAssetRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "auditItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "packages",
        "recognition_adapters",
        "competency_questions",
        "role_registry",
        "release_candidate",
        "release_policy"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/stableId"
        },
        "packages": {
          "$ref": "#/$defs/jsonAssetRefSet"
        },
        "recognition_adapters": {
          "$ref": "#/$defs/jsonAssetRefSet"
        },
        "competency_questions": {
          "$ref": "#/$defs/jsonAssetRefSet"
        },
        "role_registry": {
          "$ref": "#/$defs/nullableJsonAssetRef"
        },
        "release_candidate": {
          "$ref": "#/$defs/nullableJsonAssetRef"
        },
        "release_policy": {
          "$ref": "#/$defs/nullableJsonAssetRef"
        }
      }
    }
  }
}
