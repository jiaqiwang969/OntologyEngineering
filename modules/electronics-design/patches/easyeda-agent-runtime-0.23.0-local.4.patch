+/// <reference types="@jlceda/pro-api-types" />
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { runAction, schematicComponentsList } from './actions';
+import { decodeWireSegments, wireTreeEndpoints } from './wire-decoder';
+
+// Recorded 3.2.148 create receipts, modeled through the inspected getAll
+// flattening. This is an offline regression, not a fresh native acceptance.
+const historical = [
+	{ id: 'gnd', net: 'GND', segments: [[300,515,270,515],[300,370,300,515],[650,370,300,370],[650,410,650,370],[780,410,650,410],[780,515,780,410],[830,515,780,515]] },
+	{ id: 'in', net: 'IN', segments: [[300,525,270,525],[300,530,300,525],[430,530,300,530]] },
+	{ id: 'out', net: 'OUT', segments: [[650,530,470,530],[650,450,650,530],[720,450,650,450],[720,525,720,450],[830,525,720,525]] },
+];
+
+function wire(id: string, line: unknown, net = ''): any {
+	return { getState_PrimitiveId: () => id, getState_Line: () => line, getState_Net: () => net,
+		getState_Color: () => null, getState_LineWidth: () => null, getState_LineType: () => null };
+}
+
+function install(wires: any[], points: Array<[number, number]> = []) {
+	const component = { getState_PrimitiveId: () => 'part', getState_Designator: () => 'P', getState_ComponentType: () => 'part' };
+	(globalThis as any).eda = {
+		sch_PrimitiveComponent: {
+			getAll: async () => points.length ? [component] : [],
+			getAllPinsByPrimitiveId: async () => points.map(([x,y], i) => ({
+				getState_PrimitiveId: () => `pin${i}`, getState_PinNumber: () => String(i),
+				getState_X: () => x, getState_Y: () => y, getState_NoConnected: () => false,
+			})),
+		},
+		sch_PrimitiveWire: { getAll: async () => wires },
+		sch_ManufactureData: { getNetlistFile: async () => undefined },
+	};
+	return (globalThis as any).eda;
+}
+
+test('components.list decodes the historical getter as 15 independent segments, never 27', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	install(historical.map(w => wire(w.id, w.segments.flat(), w.net)));
+	const response: any = await schematicComponentsList({ includeWires: true });
+	assert.deepEqual(response.result.wires, historical.flatMap(w => w.segments.map(([x0,y0,x1,y1]) => ({ x0,y0,x1,y1,net:w.net }))));
+});
+
+test('historical unordered/reversed segments do not create false crossings or dangling ends', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	install(historical.map(w => wire(w.id, w.segments.flat(), w.net)), [
+		[470,530],[430,530],[650,450],[650,410],[270,525],[270,515],[830,525],[830,515],
+	]);
+	const response: any = await runAction('schematic.check', {});
+	assert.equal(response.result.summary.wireCrossings, 0);
+	assert.equal(response.result.summary.danglingWires, 0);
+});
+
+test('nested segment4 is supported without treating each group as only one point', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	install([wire('w', [[10,0,0,0],[10,0,10,10]])], [[0,0],[10,10]]);
+	const response: any = await runAction('schematic.check', {});
+	assert.equal(response.result.summary.danglingWires, 0);
+	assert.equal(response.result.summary.wireCrossings, 0);
+	install([wire('w', [[10,0,0,0],[10,0,10,10]])]);
+	const listed: any = await schematicComponentsList({ includeWires: true });
+	assert.equal(listed.result.wires.length, 2);
+});
+
+test('a real crossing and a real unconnected stub are still reported', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	install([wire('horizontal', [0,0,20,0]), wire('vertical', [10,-10,10,10])]);
+	const response: any = await runAction('schematic.check', {});
+	assert.equal(response.result.summary.wireCrossings, 1);
+	assert.equal(response.result.summary.danglingWires, 2);
+});
+
