+	await assert.rejects(projectExport({ projectUuid: 'P' }), (error: unknown) => {
+		assert.ok(error instanceof ActionError);
+		assert.equal(error.code, ErrorCodes.EDA_CALL_FAILED);
+		assert.equal(error.detail, 'project identity unavailable');
