+	const state = {
+		project: 'P', pcb: 'B', pcbProject: 'P',
+		doc: { documentType: 3, uuid: 'B', parentProjectUuid: 'P', tabId: 'T' },
+		file: new File([bytes], 'native.enet', { type: 'application/x-native-netlist' }) as File | undefined,
+		afterExport: () => {}, fail: false, calls: [] as unknown[][],
+	};
+	(globalThis as any).eda = {
+		dmt_Project: { getCurrentProjectInfo: async () => ({ uuid: state.project }) },
+		dmt_SelectControl: { getCurrentDocumentInfo: async () => ({ ...state.doc }) },
+		dmt_Pcb: { getCurrentPcbInfo: async () => ({ uuid: state.pcb, parentProjectUuid: state.pcbProject }) },
+		pcb_ManufactureData: { getNetlistFile: async (...args: unknown[]) => {
+			state.calls.push(args);
+			if (state.fail) throw new Error('native netlist unavailable');
+			state.afterExport();
+			return state.file;
+		} },
+	};
+	return { state, bytes };
+}
+
+test('PCB typed netlist action preserves original bytes, native name and MIME', async () => {
+	const { state, bytes } = fixture();
+	const r = await runAction('pcb.export.netlist', { projectUuid: 'P', pcbUuid: 'B', fileName: 'requested' });
+	assert.deepEqual(state.calls, [['requested', 'JLCEDA']]);
+	assert.deepEqual(Buffer.from(r.artifacts![0].inlineBase64!, 'base64'), Buffer.from(bytes));
+	assert.equal(r.artifacts![0].kind, 'pcb_netlist');
+	assert.equal(r.artifacts![0].fileName, 'native.enet');
+	assert.equal(r.artifacts![0].mimeType, 'application/x-native-netlist');
+	assert.equal(r.result!.size, bytes.length);
+	assert.equal(r.result!.engineeringAcceptance, 'not_granted');
+});
+
+for (const bad of ['project', 'pcb', 'pcbProject', 'docProject', 'docType', 'docUuid', 'tabMissing']) {
+	test(`PCB netlist refuses ${bad} before calling exporter`, async () => {
+		const { state } = fixture();
+		if (bad === 'project') state.project = 'other';
+		if (bad === 'pcb') state.pcb = 'other';
+		if (bad === 'pcbProject') state.pcbProject = 'other';
+		if (bad === 'docProject') state.doc.parentProjectUuid = 'other';
+		if (bad === 'docType') state.doc.documentType = 1;
+		if (bad === 'docUuid') state.doc.uuid = 'other';
+		if (bad === 'tabMissing') state.doc.tabId = '';
+		await assert.rejects(pcbExportNetlist({ projectUuid: 'P', pcbUuid: 'B' }), (e: unknown) => e instanceof ActionError && e.code === ErrorCodes.INVALID_STATE);
+		assert.equal(state.calls.length, 0);
+	});
+}
+
+test('missing identity, no File, empty File and SDK error never produce substitute netlists', async () => {
+	for (const payload of [{}, { projectUuid: 'P' }, { pcbUuid: 'B' }]) {
+		const { state } = fixture();
+		await assert.rejects(pcbExportNetlist(payload));
+		assert.equal(state.calls.length, 0);
