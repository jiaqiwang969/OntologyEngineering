--- /dev/null
+++ b/extension/src/pcb-component-properties.ts
@@ -0,0 +1,63 @@
+import { ActionError, ErrorCodes } from './protocol';
+import { describeThrown } from './util';
+
+interface PcbPropertyReader {
+	getState_OtherProperty(): unknown;
+}
+
+type Property = string | number | boolean;
+
+/**
+ * Optional public instance properties for pcb.components.list. No library
+ * lookup or inheritance reconstruction: absence is exactly getter undefined.
+ * The explicit state survives JSON, unlike an undefined dictionary field.
+ */
+export function pcbComponentProperties(
+	component: PcbPropertyReader,
+	includeProperties = false,
+): Record<string, unknown> {
+	if (!includeProperties) return {};
+
+	let raw: unknown;
+	try { raw = component.getState_OtherProperty(); }
+	catch (err) {
+		throw new ActionError(ErrorCodes.EDA_CALL_FAILED, 'Failed to read PCB component OtherProperty.', describeThrown(err));
+	}
+	if (raw === undefined) return { otherPropertyState: 'undefined' };
+	if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) {
+		throw new ActionError(ErrorCodes.INVALID_STATE, 'PCB component OtherProperty is not a public property dictionary.');
+	}
+
+	// Copy own data entries without invoking arbitrary property accessors. Reject
+	// values JSON would silently omit/coerce instead of claiming a complete read.
+	const entries: Array<[string, Property]> = [];
+	try {
+		// Permit plain dictionaries from another realm as well as null-prototype
+		// dictionaries; do not turn an empty Map/Date/class instance into {}.
+		const prototype = Object.getPrototypeOf(raw);
+		if (prototype !== null && Object.getPrototypeOf(prototype) !== null) {
+			throw new ActionError(ErrorCodes.INVALID_STATE, 'PCB component OtherProperty is not a plain property dictionary.');
+		}
+		for (const key of Reflect.ownKeys(raw)) {
+			const descriptor = Object.getOwnPropertyDescriptor(raw, key);
+			if (typeof key !== 'string' || !descriptor?.enumerable || !('value' in descriptor)) {
+				throw new ActionError(ErrorCodes.INVALID_STATE, 'PCB component OtherProperty has a non-JSON dictionary entry.');
+			}
+			const value: unknown = descriptor.value;
+			if (!(typeof value === 'string' || typeof value === 'boolean' || (typeof value === 'number' && Number.isFinite(value)))) {
+				throw new ActionError(ErrorCodes.INVALID_STATE, 'PCB component OtherProperty contains a value outside the public dictionary contract.');
+			}
+			entries.push([key, value]);
+		}
+		for (const key in raw) {
+			if (!Object.prototype.hasOwnProperty.call(raw, key)) {
+				throw new ActionError(ErrorCodes.INVALID_STATE, 'PCB component OtherProperty contains inherited enumerable entries.');
+			}
+		}
+	}
+	catch (err) {
+		if (err instanceof ActionError) throw err;
+		throw new ActionError(ErrorCodes.EDA_CALL_FAILED, 'Failed to inspect PCB component OtherProperty.', describeThrown(err));
+	}
+	return { otherPropertyState: 'present', otherProperty: Object.fromEntries(entries) };
+}
