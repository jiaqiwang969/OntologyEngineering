+
+test('native id and own tagged title are required; copied body text is insufficient', () => {
+	for (const mutate of [
+		(f: ReturnType<typeof nativeFixture>) => { f.modal.attributes.id = 'otherDialog'; },
+		(f: ReturnType<typeof nativeFixture>) => { f.heading.innerText = 'Delete project'; },
+		(f: ReturnType<typeof nativeFixture>) => { f.heading.attributes['data-test'] = 'Unrelated'; },
+		(f: ReturnType<typeof nativeFixture>) => { delete f.header.attributes['data-dialog-tagitem']; },
+	]) {
+		const f = nativeFixture(); mutate(f); f.body.innerText = 'Confirm Importing changes information';
+		assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'none'); assert.equal(f.button.clicks, 0);
+	}
+});
+
+test('native invisible or disabled targets and observation-only passes never click', () => {
+	const hidden = nativeFixture(); hidden.modal.hidden = true;
+	assert.equal(importConfirmDomStep(hidden.document, { click: true }).status, 'none');
+	const disabled = nativeFixture(); disabled.button.disabled = true;
+	assert.equal(importConfirmDomStep(disabled.document, { click: true }).status, 'disabled');
+	const observe = nativeFixture();
+	assert.equal(importConfirmDomStep(observe.document, { click: false }).status, 'open');
+	assert.deepEqual([hidden.button.clicks, disabled.button.clicks, observe.button.clicks], [0, 0, 0]);
+});
+
+test('an unrelated native modal blocks Arco and native import dialogs', () => {
+	for (const f of [fixture(), nativeFixture()]) {
+		const other = f.root.add(new ElementFixture('other'));
+		other.attributes = { id: 'errorDialog', class: 'lc_modal_RVdjQ', 'data-render': 'react', mask: 'true', esc: 'true' };
+		assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'ambiguous');
+		assert.equal(f.button.clicks, 0);
+	}
+});
+
+test('nested dialog headers and buttons do not authorize a native ancestor', () => {
+	const f = nativeFixture(); f.heading.innerText = 'Wrong title';
+	const child = f.body.add(new ElementFixture('modal')); child.add(new ElementFixture('title', 'Confirm Importing changes information'));
+	const button = child.add(new ElementFixture('button', 'Apply Changes'));
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+	assert.equal(button.clicks, 1); assert.equal(f.button.clicks, 0);
+});
+
+test('native polling clicks once and detects closure using the same host root', async () => {
+	const f = nativeFixture(); let passes = 0;
