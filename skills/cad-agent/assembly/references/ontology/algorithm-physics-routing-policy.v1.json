  "routing_rules": {
    "s9_claim_ceiling": "DIRECTION_RANKING_ONLY",
    "contact_physics_claim_ceiling": "MODELED_PHYSICS_ONLY",
    "threaded_contact_requires_dedicated_model": true,
    "physical_release_requires_fixture_trial": true,
    "unknown_route_facts_default": "HOLD"
  },
  "overclaim_guards": {
