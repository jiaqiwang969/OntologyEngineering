+test('untyped native bytes use octet-stream, not a fabricated ZIP media type', async () => {
+	const { state, bytes } = fixture(); state.file = new File([bytes], 'actual.file');
+	const r = await pcbExportNetlist({ projectUuid: 'P', pcbUuid: 'B' });
+	assert.equal(r.artifacts![0].mimeType, 'application/octet-stream');
+});
