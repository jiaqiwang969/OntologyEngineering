+	(globalThis as any).eda = {
+		dmt_Project: { getCurrentProjectInfo: async () => {
+			if (options.projectReadFail) throw new Error('project identity unavailable');
+			return { uuid: options.switchAfter && n++ > 0 ? 'other' : options.project ?? 'P' };
+		} },
+		dmt_Pcb: { getCurrentPcbInfo: async () => ({ uuid: options.pcbSwitchAfter && pcbReads++ > 0 ? 'different-pcb' : options.pcb ?? 'B' }) },
+		sys_FileManager: { getProjectFile: async (...args: unknown[]) => { calls.push(args); if(options.fail) throw new Error('permission denied'); return file; } },
+		pcb_ManufactureData: { getGerberFile: async (...args: unknown[]) => { calls.push(args); if(options.gerberFail) throw new Error('native gerber generation failed'); return file; } },
