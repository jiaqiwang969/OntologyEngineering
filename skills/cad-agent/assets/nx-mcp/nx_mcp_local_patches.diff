+def _run_sync(coroutine: Awaitable[Any]) -> Any:
+    """Run a legacy coroutine to completion on the NX journal thread.
+
+    ``asyncio.run()`` builds a ProactorEventLoop whose constructor calls ``signal.set_wakeup_fd``;
+    NX executes journals outside the main interpreter thread, so that raises
+    "set_wakeup_fd only works in main thread of the main interpreter". A selector loop has no such
+    requirement, and the legacy handlers never await real I/O.
+    """
+    loop = asyncio.SelectorEventLoop()
+    try:
+        return loop.run_until_complete(coroutine)
+    finally:
+        loop.close()
+
