@@ -0,0 +1,209 @@
+/// <reference types="@jlceda/pro-api-types" />
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { runInNewContext } from 'node:vm';
+import { pcbComponentProperties } from './pcb-component-properties';
+import { ActionError, ErrorCodes } from './protocol';
+import { runAction } from './actions';
+
+function reader(value: unknown) {
+	return { getState_OtherProperty: () => value };
+}
+
+function invalid(call: () => unknown) {
+	assert.throws(call, (error: unknown) => {
+		assert.ok(error instanceof ActionError);
+		assert.equal(error.code, ErrorCodes.INVALID_STATE);
+		return true;
+	});
+}
+
+test('default and explicit false preserve the existing list record without reading properties', () => {
+	const component = { getState_OtherProperty: () => { throw new Error('must not read'); } };
+	const before = { primitiveId: 'fixture-id', uniqueId: 'fixture-join', designator: 'fixture-ref', x: 0 };
+	for (const enabled of [undefined, false]) {
+		const after = { ...before, ...pcbComponentProperties(component, enabled) };
+		assert.deepEqual(after, before);
+		assert.equal(JSON.stringify(after), JSON.stringify(before));
+	}
+});
+
+test('undefined and empty dictionary remain distinct after wire JSON serialization', () => {
+	const missing = JSON.parse(JSON.stringify(pcbComponentProperties(reader(undefined), true)));
+	const empty = JSON.parse(JSON.stringify(pcbComponentProperties(reader({}), true)));
+	assert.deepEqual(missing, { otherPropertyState: 'undefined' });
+	assert.equal(Object.hasOwn(missing, 'otherProperty'), false);
+	assert.deepEqual(empty, { otherPropertyState: 'present', otherProperty: {} });
+});
+
+test('false, zero, empty string, Unicode and finite numeric values retain their primitive types', () => {
+	const raw = Object.freeze({ Value: '', Enabled: false, Count: 0, Negative: -2.5, Label: '电容', True: true });
+	const result = pcbComponentProperties(reader(raw), true);
+	assert.deepEqual(result, { otherPropertyState: 'present', otherProperty: raw });
+	assert.notEqual(result.otherProperty, raw);
+	assert.deepEqual(JSON.parse(JSON.stringify(result)).otherProperty, raw);
+});
+
+test('an absent Value key is not filled from the component, a library, or a default', () => {
+	const raw = { ChannelID: 'fixture-channel' };
+	const touched: PropertyKey[] = [];
+	const component = new Proxy(reader(raw), {
+		get(target, key) {
+			touched.push(key);
+			assert.equal(key, 'getState_OtherProperty');
+			return Reflect.get(target, key);
+		},
+	});
+	const result = pcbComponentProperties(component, true);
+	assert.deepEqual(result.otherProperty, raw);
+	assert.equal(Object.hasOwn(result.otherProperty as object, 'Value'), false);
+	assert.deepEqual(touched, ['getState_OtherProperty']);
+});
+
+test('reads once, retains the method receiver, and calls no mutation or other SDK methods', () => {
+	let reads = 0;
+	const raw = Object.freeze({ Value: 'fixture-only' });
+	const component = Object.freeze({
+		getState_OtherProperty() { assert.equal(this, component); reads++; return raw; },
+		setState_OtherProperty() { assert.fail('mutation forbidden'); },
+		modify() { assert.fail('mutation forbidden'); },
+	});
