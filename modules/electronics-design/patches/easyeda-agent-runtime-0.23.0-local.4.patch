+++ b/extension/src/component-modify-diagnostic.ts
@@ -0,0 +1,198 @@
+import { describeThrown } from './util';
+import { ActionError, ErrorCodes } from './protocol';
+
+type State = Record<string, unknown>;
+export interface ModifyContext {
+	projectUuid?: string;
+	documentUuid?: string;
+	tabId?: string;
+}
+export interface StateObservation { state?: State; error?: string }
+export interface ContextObservation { context?: ModifyContext; error?: string }
+const BUDGET_MS = 5000;
+const SNAPSHOT_FIELDS = [
+	'primitiveId', 'componentType', 'designator', 'name', 'x', 'y', 'rotation', 'mirror',
+	'net', 'subPartName', 'addIntoBom', 'addIntoPcb', 'uniqueId', 'manufacturer',
+	'manufacturerId', 'supplier', 'supplierId', 'component', 'device', 'symbol', 'footprint', 'otherProperty',
+];
+const PATCH_FIELDS = new Set([
+	'x', 'y', 'rotation', 'mirror', 'addIntoBom', 'addIntoPcb', 'designator', 'name',
+	'uniqueId', 'manufacturer', 'manufacturerId', 'supplier', 'supplierId', 'otherProperty',
+]);
+
+// Keep undefined and scalar types when freezing SDK getter results. JSON alone
+// would silently erase undefined, NaN, functions and cyclic/unsupported values.
+function copy(value: unknown, seen = new Set<object>()): unknown {
+	if (value === undefined || value === null || typeof value === 'string' || typeof value === 'boolean') return value;
+	if (typeof value === 'number' && Number.isFinite(value)) return value;
+	if (typeof value !== 'object' || seen.has(value!)) throw new Error('Unrepresentable or cyclic component state.');
+	if (!Array.isArray(value) && Object.prototype.toString.call(value) !== '[object Object]') throw new Error('Non-plain component state.');
+	if (Object.getOwnPropertySymbols(value).length) throw new Error('Symbol-keyed component state.');
+	for (const key of Object.getOwnPropertyNames(value)) {
+		if (Array.isArray(value) && key === 'length') continue;
+		const descriptor = Object.getOwnPropertyDescriptor(value, key)!;
+		if (!descriptor.enumerable || !('value' in descriptor)) throw new Error('Hidden or accessor-backed component state.');
+	}
+	if (Array.isArray(value) && (Object.keys(value).length !== value.length || Object.keys(value).some((key, index) => key !== String(index)))) {
+		throw new Error('Sparse or decorated array in component state.');
+	}
+	seen.add(value);
+	const out = Array.isArray(value)
+		? value.map(item => copy(item, seen))
+		: Object.fromEntries(Object.keys(value).sort().map(key => [key, copy((value as State)[key], seen)]));
+	seen.delete(value);
+	return out;
+}
+
+// Tagged canonical values distinguish missing/undefined, null, scalar types and
+// object key order. The tags never collide with a user's property values.
+function canonical(value: unknown): string {
+	if (value === undefined) return '["undefined"]';
+	if (value === null) return '["null"]';
+	if (Array.isArray(value)) return JSON.stringify(['array', value.map(canonical)]);
+	if (typeof value === 'object') return JSON.stringify(['object', Object.keys(value).sort().map(key => [key, canonical((value as State)[key])])]);
+	return JSON.stringify([typeof value, Object.is(value, -0) ? '-0' : value]);
+}
+
+function stateForDetail(state: State): { values: State; undefinedPaths: string[] } {
+	const undefinedPaths: string[] = [];
+	const visit = (value: unknown, path: string): void => {
+		if (value === undefined) undefinedPaths.push(path);
+		else if (value !== null && typeof value === 'object') {
+			for (const key of Object.keys(value).sort()) visit((value as State)[key], `${path}/${key.replace(/~/g, '~0').replace(/\//g, '~1')}`);
+		}
+	};
+	visit(state, '');
+	return { values: state, undefinedPaths };
+}
+
+export function captureModifyState(read: () => State): StateObservation {
+	try {
+		const state = copy(read()) as State;
+		assertCompleteState(state);
+		return { state };
+	}
+	catch (error) { return { error: describeThrown(error) }; }
+}
+
+function assertCompleteState(state: State): void {
+	if (!state || SNAPSHOT_FIELDS.some(field => !Object.prototype.hasOwnProperty.call(state, field))) throw new Error('Incomplete public component snapshot.');
+	if (!['x', 'y', 'rotation'].every(field => typeof state[field] === 'number' && Number.isFinite(state[field]))) throw new Error('Unavailable component position/rotation.');
+	if (!['mirror', 'addIntoBom', 'addIntoPcb'].every(field => typeof state[field] === 'boolean')) throw new Error('Unavailable component flags.');
+}
+
+async function bounded<T>(read: (expired: () => boolean) => Promise<T>, timeoutMs: number): Promise<T> {
+	let expired = false;
+	let timer: ReturnType<typeof setTimeout> | undefined;
+	try {
+		return await Promise.race([
+			Promise.resolve().then(() => read(() => expired)),
+			new Promise<never>((_, reject) => {
+				timer = setTimeout(() => { expired = true; reject(new Error('Read-only diagnostic deadline exceeded; pending SDK reads were not cancelled.')); }, timeoutMs);
+			}),
+		]);
+	}
+	finally { if (timer !== undefined) clearTimeout(timer); }
+}
+
+export async function captureModifyContext(read: () => Promise<ModifyContext>, timeoutMs = BUDGET_MS): Promise<ContextObservation> {
+	try { return { context: await bounded(async () => copy(await read()) as ModifyContext, timeoutMs) }; }
+	catch (error) { return { error: describeThrown(error) }; }
+}
+
+function validContext(context: ModifyContext | undefined): context is Required<ModifyContext> {
+	return !!context && ['projectUuid', 'documentUuid', 'tabId'].every(key => typeof context[key as keyof ModifyContext] === 'string' && context[key as keyof ModifyContext] !== '');
+}
+
+/** Public identity observations only; this cannot lock the active document. */
+export function assertModifyIdentity(before: ContextObservation, after?: ContextObservation): void {
+	if (before.error || !validContext(before.context) || (after && (after.error || !validContext(after.context) || canonical(before.context) !== canonical(after.context)))) {
+		throw new ActionError(ErrorCodes.INVALID_STATE, 'Cannot confirm the component modification target; no modification was attempted.', JSON.stringify({
+			schema: 'easyeda.component-modify-identity/v1', before, after,
+			reason: 'A complete unchanged Project/document/tab identity is required before modifying a component.',
+		}));
+	}
+}
+
+function expectedState(before: State, patch: State): State {
+	const expected = copy(before) as State;
+	for (const [key, value] of Object.entries(patch)) {
+		if (!PATCH_FIELDS.has(key) || value === undefined) throw new Error(`Unsupported diagnostic patch field: ${key}`);
+		if (key === 'otherProperty') {
+			if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new Error('Unsupported property patch.');
+			const previous = before.otherProperty ?? {};
+			if (typeof previous !== 'object' || Array.isArray(previous)) throw new Error('Unsupported previous properties.');
+			expected.otherProperty = { ...previous, ...copy(value) as State };
+		}
+		else expected[key] = copy(value);
+	}
+	// serializeComponent.device.name is derived from getState_Name, not an
+	// additional requested library mutation.
+	if ('name' in patch && expected.device && typeof expected.device === 'object') {
+		expected.device = { ...expected.device as State, name: typeof patch.name === 'string' ? patch.name : '' };
+	}
+	return expected;
+}
+
+/** Always a diagnostic of a failed SDK call, never a successful action result. */
+export async function diagnoseComponentModifyFailure(options: {
+	sdkDetail: string;
+	primitiveId: string;
+	before: StateObservation;
+	beforeContext: ContextObservation;
+	requestedPatch: State;
+	readFresh: () => Promise<State>;
+	readContext: () => Promise<ModifyContext>;
+	timeoutMs?: number;
+}): Promise<string> {
+	const detail: State = {
+		schema: 'easyeda.component-modify-failure/v1',
+		sdkDetail: options.sdkDetail,
+		mutationOutcome: 'unknown',
+		requestedFields: Object.keys(options.requestedPatch).sort(),
+		readbackAttempts: 0,
+		scope: 'Public component getters and observed project/document/tab identities; no lock, transaction cancellation, retry, save or reload.',
+	};
+	try {
+		const before = options.before.state;
+		if (!before || options.before.error) throw new Error(options.before.error ?? 'Missing before snapshot.');
+		assertCompleteState(before);
+		if (!validContext(options.beforeContext.context) || options.beforeContext.error) throw new Error(options.beforeContext.error ?? 'Incomplete before identity.');
+		if (before.primitiveId !== options.primitiveId || before.componentType !== 'part') throw new Error('Before component identity/type mismatch.');
+		const expected = expectedState(before, options.requestedPatch);
+		detail.before = stateForDetail(before);
+		detail.beforeContext = options.beforeContext.context;
+		const observation = await bounded(async expired => {
+			const beforeReadContext = await options.readContext();
+			if (expired()) throw new Error('Diagnostic expired before component read.');
+			if (!validContext(beforeReadContext) || canonical(beforeReadContext) !== canonical(options.beforeContext.context)) throw new Error('Document identity changed or unavailable before readback.');
+			detail.readbackAttempts = 1;
+			const after = copy(await options.readFresh()) as State;
+			if (expired()) throw new Error('Diagnostic expired during component read.');
+			const afterReadContext = await options.readContext();
+			if (expired()) throw new Error('Diagnostic expired during identity read.');
+			if (!validContext(afterReadContext) || canonical(afterReadContext) !== canonical(options.beforeContext.context)) throw new Error('Document identity changed or unavailable after readback.');
+			return { after, afterReadContext };
+		}, options.timeoutMs ?? BUDGET_MS);
+		const { after, afterReadContext } = observation;
+		assertCompleteState(after);
+		if (after.primitiveId !== options.primitiveId || after.componentType !== 'part') throw new Error('Fresh component identity/type mismatch.');
+		detail.after = stateForDetail(after);
+		detail.afterContext = afterReadContext;
+		const fields = [...new Set([...Object.keys(before), ...Object.keys(after), ...Object.keys(expected)])].sort();
+		const changed = fields.filter(key => canonical(before[key]) !== canonical(after[key]) || (key in before) !== (key in after));
+		const mismatched = fields.filter(key => {
+			// The SDK represents a deliberately cleared Supplier Part as null,
+			// undefined or ''. This equivalence is only for explicit clear requests.
+			if (key === 'supplierId' && (options.requestedPatch.supplierId === '' || options.requestedPatch.supplierId === null)) {
+				return after[key] !== undefined && after[key] !== null && after[key] !== '';
+			}
+			return canonical(expected[key]) !== canonical(after[key]) || (key in expected) !== (key in after);
+		});
+		detail.changedFields = changed;
+		detail.expectedMismatchFields = mismatched;
+		detail.mutationOutcome = changed.length === 0 ? 'unchanged_observed' : mismatched.length === 0 ? 'expected_state_observed' : 'partial_or_conflicting';
+	}
+	catch (error) { detail.observationError = describeThrown(error); }
+	return JSON.stringify(detail);
+}
