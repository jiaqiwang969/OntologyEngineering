{
  "$schema": "assembly-ontology.hard-film-acceptance-contract/v1",
  "contract_id": "X1-PLUS-ASSEMBLY-FILM-20260827-V001.1",
  "status": "AUDIT_PROPOSAL_NOT_SKILL_AUTHORITY",
  "decision_rule": {
    "accepted": "Every applicable check is PASS.",
    "hold_unknown": "No check is FAIL and at least one applicable check is UNKNOWN.",
    "rejected": "At least one applicable check is FAIL.",
    "fail_closed": true
  },
  "profiles": {
    "engineering-film": "A claim-bounded, occurrence-level assembly film at or above the X1 method, without claiming manufacturing release.",
    "physical-release": "engineering-film plus tool access, torque/process, harness and release-rights closure."
  },
  "packet_schema": "assembly-ontology.acceptance-packet/v1",
  "gates": [
    {
      "id": "A0_SOURCE_PROVENANCE",
      "purpose": "Freeze a named source and prove that rendering geometry has not silently replaced engineering authority.",
      "applies_to": [
        "engineering-film",
        "physical-release"
      ],
      "checks": [
        {
          "id": "A0.1",
          "path": "source.native_brep_authority",
          "operator": "eq",
          "expected": true
        },
        {
          "id": "A0.2",
          "path": "source.source_hash_frozen",
          "operator": "eq",
          "expected": true
        },
        {
          "id": "A0.3",
          "path": "source.render_geometry_traceable_to_source",
          "operator": "eq",
          "expected": true
        },
        {
          "id": "A0.4",
          "path": "source.proxy_substitutions",
          "operator": "empty"
        },
        {
          "id": "A0.5",
          "path": "artifacts",
          "operator": "artifact_hashes_valid",
          "required_roles": [
            "source",
            "frozen_state",
            "connection_graph",
            "motion_audit",
            "save_readback",
            "video",
            "media_qc",
            "human_review"
          ]
        }
      ]
    },
    {
      "id": "A1_OCCURRENCE_IDENTITY",
      "purpose": "One stable occurrence universe with complete world transforms and BOM binding.",
      "applies_to": [
        "engineering-film",
        "physical-release"
      ],
      "checks": [
        {
          "id": "A1.1",
          "path": "identity.stable_occurrence_ids",
          "operator": "eq",
          "expected": true
        },
        {
          "id": "A1.2",
          "path": "identity.total_occurrences",
          "operator": "gt",
          "expected": 0
        },
        {
          "id": "A1.3",
          "path": "identity.unique_occurrence_ids",
          "operator": "same_as",
          "expected_path": "identity.total_occurrences"
        },
        {
          "id": "A1.4",
          "path": "identity.world_transforms_resolved",
          "operator": "same_as",
          "expected_path": "identity.total_occurrences"
        },
        {
          "id": "A1.5",
          "path": "identity.world_transforms_independently_cross_validated",
          "operator": "same_as",
          "expected_path": "identity.total_occurrences"
        },
        {
          "id": "A1.6",
          "path": "identity.full_matrix_cross_validation",
          "operator": "eq",
          "expected": true
        },
        {
          "id": "A1.7",
          "path": "identity.bom_bound_occurrences",
          "operator": "same_as",
          "expected_path": "identity.total_occurrences"
        },
        {
          "id": "A1.8",
          "path": "identity.unresolved_identity_conflicts",
          "operator": "eq",
          "expected": 0
        }
      ]
    },
    {
      "id": "A2_COMPLETENESS",
      "purpose": "Mechanical parts, fasteners, standard parts and declared harnesses are accounted for without silent omission.",
      "applies_to": [
        "engineering-film",
        "physical-release"
      ],
      "checks": [
        {
          "id": "A2.1",
          "path": "completeness.accounted_occurrences",
          "operator": "same_as",
          "expected_path": "identity.total_occurrences"
        },
        {
          "id": "A2.2",
          "path": "completeness.fastener_occurrences",
          "operator": "same_as",
          "expected_path": "completeness.fasteners_bound"
