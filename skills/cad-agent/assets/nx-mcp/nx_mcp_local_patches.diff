+def _merge_box(box: list[float] | None, other: list[float]) -> list[float]:
+    if box is None:
+        return list(other)
+    return [
+        min(box[0], other[0]), min(box[1], other[1]), min(box[2], other[2]),
+        max(box[3], other[3]), max(box[4], other[4]), max(box[5], other[5]),
+    ]
+
+
+def _body_bounding_box(body) -> tuple[list[float] | None, str]:
+    """Return ([xmin, ymin, zmin, xmax, ymax, zmax], method) for an NXOpen.Body.
+
+    The NX Python binding has no Body.GetBoundingBox and no UF_MODL_ask_bounding_box, so union the
+    per-face boxes reported by UF_MODL_ask_face_data; fall back to edge vertices (approximate for
+    curved faces) when that call is unavailable.
+    """
+    box: list[float] | None = None
+    try:
+        import NXOpen.UF
+
+        ask_face_data = getattr(NXOpen.UF.UFSession.GetUFSession().Modl, "AskFaceData", None)
+    except Exception:
+        ask_face_data = None
+    if ask_face_data is not None:
+        try:
+            for face in body.GetFaces():
+                data = ask_face_data(face.Tag)  # (type, point, dir, box[6], radius, rad_data, norm_dir)
+                face_box = data[3]
+                box = _merge_box(box, [face_box[i] for i in range(6)])
+            if box is not None:
+                return box, "uf_face_data"
+        except Exception:
+            box = None
+    for edge in body.GetEdges():
+        for point in edge.GetVertices():
+            box = _merge_box(box, [point.X, point.Y, point.Z, point.X, point.Y, point.Z])
+    return box, "edge_vertices_approx"
+
+
