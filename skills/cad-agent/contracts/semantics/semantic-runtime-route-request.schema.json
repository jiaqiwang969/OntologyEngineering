{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/semantic-runtime-route-request-v1.json",
  "title": "CAD Agent semantic runtime route request",
  "description": "Domain-neutral, shadow-only request that binds raw task text to one reproducible semantic build. Problem classification is emitted by a compiled candidate-only recognition profile; callers cannot supply retrieval semantics or select an operational package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "evaluation_time",
    "build_report",
    "raw_task",
    "problem_id"
  ],
  "properties": {
    "schema": {
      "const": "cad-agent.semantic-runtime-route-request.v1"
    },
    "request_id": {
      "$ref": "#/$defs/stableId"
    },
    "evaluation_time": {
      "type": "string",
      "format": "date-time"
    },
    "build_report": {
      "$ref": "#/$defs/assetRef"
    },
    "raw_task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    },
    "problem_id": {
      "$ref": "#/$defs/stableId"
    },
    "grounded_preflight_request": {
      "description": "Optional content-addressed semantic-preflight request. Its selected_package_id is treated as an untrusted placeholder and is replaced only after unique full-build retrieval.",
      "$ref": "#/$defs/assetRef"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticIri": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:https://|urn:)[^\\s]+$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/projectPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "const": "application/json"
        }
      }
    },
    "uniqueIris": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/semanticIri"
      }
    },
    "nonEmptyUniqueIris": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/semanticIri"
      }
    }
  }
}
