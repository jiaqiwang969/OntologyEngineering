{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/semantic-observer-adapter-registry-manifest-v1.json",
  "title": "CAD Agent candidate observer/adapter registry manifest",
  "description": "Repository-contained, content-addressed inventory for candidate observer and adapter registry entries. This manifest is not an activation or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "registry_version",
    "registry_class",
    "candidate_status",
    "entries",
    "inventory_sha256",
    "activation_authorized",
    "execution_authorized",
    "runtime_routing_changed"
  ],
  "properties": {
    "schema": {
      "const": "cad-agent.semantic-observer-adapter-registry-manifest.v1"
    },
    "registry_id": {
      "$ref": "#/$defs/stableId"
    },
    "registry_version": {
      "$ref": "#/$defs/semver"
    },
    "registry_class": {
      "const": "ObserverAdapterCandidateRegistry"
    },
    "candidate_status": {
      "const": "Candidate"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entryRef"
      }
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "activation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "runtime_routing_changed": {
      "const": false
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "entryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "entry_kind",
        "path",
        "sha256",
        "media_type"
      ],
      "properties": {
        "entry_id": {
          "$ref": "#/$defs/stableId"
        },
        "entry_kind": {
          "enum": [
            "Observer",
            "Adapter"
          ]
        },
        "path": {
          "$ref": "#/$defs/projectPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "const": "application/json"
        }
      }
    }
  }
}
