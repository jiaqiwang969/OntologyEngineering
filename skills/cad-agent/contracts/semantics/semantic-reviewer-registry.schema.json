{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/semantic-reviewer-registry-v1.json",
  "title": "Independent semantic lifecycle reviewer registry",
  "description": "Externally resolved reviewer-role inventory used only to assess decision independence. It does not authorize activation or execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "registry_id",
    "registry_version",
    "authority_manifest_sha256",
    "reviewers",
    "activation_authorized",
    "execution_authorized",
    "runtime_routing_changed"
  ],
  "properties": {
    "schema": {"const": "cad-agent.semantic-reviewer-registry.v1"},
    "registry_id": {"$ref": "#/$defs/stableId"},
    "registry_version": {"$ref": "#/$defs/semver"},
    "authority_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reviewer"}
    },
    "activation_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "runtime_routing_changed": {"const": false}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_id", "roles", "conflicts_with_principal_ids"],
      "properties": {
        "reviewer_id": {"$ref": "#/$defs/stableId"},
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["ReleaseAcceptanceReviewer", "ActivationReviewer"]}
        },
        "conflicts_with_principal_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        }
      }
    }
  }
}
