---
to: out/validation-plan.json
sparql:
  cases_0: 'SELECT ?name ?behavior ?rustPath ?oracle ?scope ?module ?constraint ?requirement ?checkerModule ?checker ?checkerPath WHERE { ?v <urn:oev2:design:module> ?validationOwner ; <urn:oev2:design:validates> ?c . ?validationOwner <urn:oev2:design:name> ?module . ?c <urn:oev2:design:name> ?constraint ; <urn:oev2:design:requirement> ?r ; <urn:oev2:design:module> ?checkerOwner ; <urn:oev2:design:check> ?checker ; <urn:oev2:design:checkerPath> ?checkerPath . ?checkerOwner <urn:oev2:design:name> ?checkerModule . BIND(STRAFTER(STR(?r), "urn:oev2:design:") AS ?requirement) ?v <urn:oev2:design:kind> "Validation" ; <urn:oev2:design:name> ?name ; <urn:oev2:design:behavior> ?behavior ; <urn:oev2:design:rustPath> ?rustPath ; <urn:oev2:design:oracle> ?oracle ; <urn:oev2:design:scope> ?scope . FILTER(REGEX(SUBSTR(SHA256(STR(?name)), 1, 1), "^[0-3]$")) } ORDER BY ?name'
