{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/runtime-trust-bundle-v1.json",
  "title": "Runtime trust bundle candidate",
  "description": "Immutable candidate binding an accepted semantic release to exact bundle, observer/adapter, action-link, tool ABI, CQ regression, and rollback evidence. It is a planning input and cannot activate itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trust_bundle_id",
    "trust_bundle_version",
    "document_role",
    "origin_manifest_sha256",
    "created_by_principal_ids",
    "bindings",
    "rollback_plan",
    "automatic_activation",
    "activation_authorized",
    "execution_authorized",
    "runtime_routing_changed"
  ],
  "properties": {
    "schema": {"const": "cad-agent.runtime-trust-bundle.v1"},
    "trust_bundle_id": {"$ref": "#/$defs/stableId"},
    "trust_bundle_version": {"$ref": "#/$defs/semver"},
    "document_role": {"const": "RuntimeTrustBundleCandidate"},
    "origin_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "created_by_principal_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "rollback_plan": {"$ref": "#/$defs/rollbackPlan"},
    "automatic_activation": {"const": false},
    "activation_authorized": {"const": false},
    "execution_authorized": {"const": false},
    "runtime_routing_changed": {"const": false}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256"],
      "properties": {
        "schema": {"type": "string", "minLength": 2, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_candidate",
        "release_assessment",
        "release_policy",
        "rollback_target_release",
        "current_bundle",
        "target_bundle",
        "tool_abi_registry",
        "observer_adapter_registry_manifest",
        "observer_adapter_registry_assessment",
        "action_link_registry",
        "action_link_assessment",
        "cq_regression_report",
        "rollback_canary_report",
        "activation_policy",
        "reviewer_registry"
      ],
      "properties": {
        "release_candidate": {"$ref": "#/$defs/artifactBinding"},
        "release_assessment": {"$ref": "#/$defs/artifactBinding"},
        "release_policy": {"$ref": "#/$defs/artifactBinding"},
        "rollback_target_release": {"$ref": "#/$defs/artifactBinding"},
        "current_bundle": {"$ref": "#/$defs/artifactBinding"},
        "target_bundle": {"$ref": "#/$defs/artifactBinding"},
        "tool_abi_registry": {"$ref": "#/$defs/artifactBinding"},
        "observer_adapter_registry_manifest": {"$ref": "#/$defs/artifactBinding"},
        "observer_adapter_registry_assessment": {"$ref": "#/$defs/artifactBinding"},
        "action_link_registry": {"$ref": "#/$defs/artifactBinding"},
        "action_link_assessment": {"$ref": "#/$defs/artifactBinding"},
        "cq_regression_report": {"$ref": "#/$defs/artifactBinding"},
        "rollback_canary_report": {"$ref": "#/$defs/artifactBinding"},
        "activation_policy": {"$ref": "#/$defs/artifactBinding"},
        "reviewer_registry": {"$ref": "#/$defs/artifactBinding"}
      }
    },
    "releaseTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "release_version", "sha256"],
      "properties": {
        "release_id": {"$ref": "#/$defs/stableId"},
        "release_version": {"$ref": "#/$defs/semver"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "bundleTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_id", "bundle_version", "sha256"],
      "properties": {
        "bundle_id": {"$ref": "#/$defs/stableId"},
        "bundle_version": {"$ref": "#/$defs/semver"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "rollbackPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "target_release",
        "target_bundle",
        "canary_report",
        "canary_suite_ids",
        "trigger_conditions",
        "disposition"
      ],
      "properties": {
        "plan_id": {"$ref": "#/$defs/stableId"},
        "target_release": {"$ref": "#/$defs/releaseTarget"},
        "target_bundle": {"$ref": "#/$defs/bundleTarget"},
        "canary_report": {"$ref": "#/$defs/artifactBinding"},
        "canary_suite_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "trigger_conditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ActivationCanaryFailure",
              "RuntimeCompatibilityFailure",
              "CompetencyQuestionRegression",
              "OperatorDirectedRollback"
            ]
          }
        },
        "disposition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["failed_release", "evidence", "active_pointer"],
          "properties": {
            "failed_release": {"const": "Quarantine"},
            "evidence": {"const": "RetainAppendOnly"},
            "active_pointer": {"const": "RestoreExactTargetAfterCanaryPass"}
          }
        }
      }
    }
  }
}
