+package app
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestNativeExportCommandsCarryExplicitIdentity(t *testing.T) {
+	for _, pcb := range []bool{false, true} {
+		cfg, cap, cleanup := newCapturingDaemon(t)
+		var stdout, stderr bytes.Buffer
+		cmd := newProjectCmd(cfg, &stdout, &stderr)
+		args, want := []string{"export", "--project-uuid", "P", "--name", "sample.epro2"}, "project.export"
+		if pcb {
+			cmd = newPcbCmd(cfg, &stdout, &stderr)
+			args, want = []string{"export-gerber", "--project-uuid", "P", "--pcb-uuid", "B", "--name", "sample.zip"}, "pcb.export.gerber"
+		}
+		cmd.SetArgs(args)
+		if err := cmd.Execute(); err != nil {
+			t.Fatal(err)
+		}
+		cap.mu.Lock()
+		if cap.action != want || cap.payload["projectUuid"] != "P" {
+			t.Errorf("wrong export dispatch: %s %+v", cap.action, cap.payload)
+		}
+		if pcb && cap.payload["pcbUuid"] != "B" {
+			t.Error("PCB identity missing")
+		}
+		cap.mu.Unlock()
+		cleanup()
+	}
+}
+
+func TestNativeExportCommandsRejectUnboundRequests(t *testing.T) {
+	for _, pcb := range []bool{false, true} {
+		var stdout, stderr bytes.Buffer
+		window := ""
+		cmd := newNativeExportCmd(&appConfig{}, &window, pcb, &stdout, &stderr)
+		cmd.SetArgs(nil)
+		if err := cmd.Execute(); err == nil {
+			t.Fatal("export without project identity accepted")
+		}
+		if pcb {
+			cmd = newNativeExportCmd(&appConfig{}, &window, true, &stdout, &stderr)
+			cmd.SetArgs([]string{"--project-uuid", "P"})
+			if err := cmd.Execute(); err == nil {
+				t.Fatal("Gerber without PCB identity accepted")
+			}
+		}
+	}
+}
