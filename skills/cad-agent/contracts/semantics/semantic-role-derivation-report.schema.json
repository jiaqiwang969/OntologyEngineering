{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/semantic-role-derivation-report-v1.json",
  "title": "CAD Agent semantic-role derivation report",
  "description": "Deterministic, non-authorizing RDF/RDFS and named-equivalent-class derivation of controlled roles from local hash-bound Turtle assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "inference_profile",
    "inference_rules",
    "status",
    "source_assets",
    "role_class_iris",
    "targets",
    "registry_role_assertions",
    "issues",
    "activation_authorized",
    "execution_authorized",
    "runtime_routing_changed",
    "report_sha256"
  ],
  "properties": {
    "schema": {
      "const": "cad-agent.semantic-role-derivation-report.v1"
    },
    "inference_profile": {
      "const": "rdf-type-rdfs-subclass-named-equivalent-class-v1"
    },
    "inference_rules": {
      "const": [
        "ExplicitRdfType",
        "TargetClassIdentity",
        "RdfsSubClassOfTransitiveClosure",
        "NamedOwlEquivalentClassIdentity"
      ]
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "source_assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceAsset"
      }
    },
    "role_class_iris": {
      "$ref": "#/$defs/reportedRoleBindings"
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/targetResult"
      }
    },
    "registry_role_assertions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/roleAssertion"
      }
    },
    "issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "activation_authorized": {
      "const": false
    },
    "execution_authorized": {
      "const": false
    },
    "runtime_routing_changed": {
      "const": false
    },
    "report_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "PASS"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_assets": {
            "minItems": 1,
            "items": {
              "properties": {
                "verified": {
                  "const": true
                },
                "parsed": {
                  "const": true
                }
              },
              "required": [
                "verified",
                "parsed"
              ]
            }
          },
          "role_class_iris": {
            "$ref": "#/$defs/completeRoleBindings"
          },
          "targets": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "registry_role_assertions": {
            "minItems": 1
          },
          "issues": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNRESOLVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "source_assets": {
            "minItems": 1,
            "items": {
              "properties": {
                "verified": {
                  "const": true
                },
                "parsed": {
                  "const": true
                }
              },
              "required": [
                "verified",
                "parsed"
              ]
            }
          },
          "role_class_iris": {
            "$ref": "#/$defs/completeRoleBindings"
          },
          "targets": {
            "minItems": 1,
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "UNRESOLVED"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "contains": {
              "properties": {
                "status": {
                  "const": "UNRESOLVED"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "registry_role_assertions": {
            "maxItems": 0
          },
          "issues": {
            "minItems": 1,
            "contains": {
              "properties": {
                "code": {
                  "const": "SRD-TARGET-ROLE-UNRESOLVED"
                }
              },
              "required": [
                "code"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "FAIL"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "registry_role_assertions": {
            "maxItems": 0
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semanticIri": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:https://|urn:)[^\\s]+$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "reportedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^[^\\u0000\\r\\n]+$"
    },
    "nullableReportedPath": {
      "oneOf": [
        {
          "$ref": "#/$defs/reportedPath"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableString": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "semanticRole": {
      "enum": [
        "SemanticRequirement",
        "Pattern",
        "Capability",
        "ToolOperation"
      ]
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "UNRESOLVED"
      ]
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "declared_sha256",
        "verified_sha256",
        "verified",
        "parsed",
        "triple_count"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nullableReportedPath"
        },
        "media_type": {
          "$ref": "#/$defs/nullableString"
        },
        "declared_sha256": {
          "$ref": "#/$defs/nullableString"
        },
        "verified_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "verified": {
          "type": "boolean"
        },
        "parsed": {
          "type": "boolean"
        },
        "triple_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verified": {
                "const": true
              }
            },
            "required": [
              "verified"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "$ref": "#/$defs/projectPath"
              },
              "media_type": {
                "enum": [
                  "text/turtle",
                  "application/turtle",
                  "application/x-turtle"
                ]
              },
              "declared_sha256": {
                "$ref": "#/$defs/sha256"
              },
              "verified_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "parsed": {
                "const": true
              }
            },
            "required": [
              "parsed"
            ]
          },
          "then": {
            "properties": {
              "verified": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "roleClassBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "class_iri"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/semanticRole"
        },
        "class_iri": {
          "$ref": "#/$defs/semanticIri"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "SemanticRequirement"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "class_iri": {
                "const": "https://w3id.org/cad-geometry#SemanticRequirement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "Pattern"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "class_iri": {
                "const": "https://w3id.org/cad-geometry#ReusableWorkflowPattern"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "Capability"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "class_iri": {
                "const": "https://w3id.org/cad-geometry#ToolCapability"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "ToolOperation"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "class_iri": {
                "const": "https://w3id.org/cad-geometry#ToolOperation"
              }
            }
          }
        }
      ]
    },
    "reportedRoleBindings": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/roleClassBinding"
      }
    },
    "completeRoleBindings": {
      "allOf": [
        {
          "$ref": "#/$defs/reportedRoleBindings"
        },
        {
          "minItems": 4,
          "maxItems": 4,
          "contains": {
            "properties": {
              "role": {
                "const": "SemanticRequirement"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "Pattern"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "Capability"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "role": {
                "const": "ToolOperation"
              }
            },
            "required": [
              "role"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "classPathNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_class_iri",
        "equivalent_class_iris"
      ],
      "properties": {
        "canonical_class_iri": {
          "$ref": "#/$defs/semanticIri"
        },
        "equivalent_class_iris": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticIri"
          }
        }
      }
    },
    "derivationPath": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "seed_class_iri",
        "seed_evidence",
        "class_path"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/semanticRole"
        },
        "seed_class_iri": {
          "$ref": "#/$defs/semanticIri"
        },
        "seed_evidence": {
          "enum": [
            "ExplicitRdfType",
            "TargetClassIdentity"
          ]
        },
        "class_path": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/classPathNode"
          }
        }
      }
    },
    "classificationSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class_iri",
        "evidence"
      ],
      "properties": {
        "class_iri": {
          "$ref": "#/$defs/semanticIri"
        },
        "evidence": {
          "enum": [
            "ExplicitRdfType",
            "TargetClassIdentity"
          ]
        }
      }
    },
    "targetIssueCode": {
      "enum": [
        "SRD-SOURCE-UNTRUSTED",
        "SRD-TARGET-ROLE-CONFLICT",
        "SRD-TARGET-MULTIPLE-DERIVATION-PATHS",
        "SRD-TARGET-ROLE-UNRESOLVED"
      ]
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_iri",
        "classification_seeds",
        "derived_roles",
        "status",
        "derivation_paths",
        "issue_codes"
      ],
      "properties": {
        "semantic_iri": {
          "$ref": "#/$defs/semanticIri"
        },
        "classification_seeds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/classificationSeed"
          }
        },
        "derived_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/semanticRole"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "derivation_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/derivationPath"
          }
        },
        "issue_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/targetIssueCode"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "derived_roles": {
                "minItems": 1,
                "maxItems": 1
              },
              "derivation_paths": {
                "minItems": 1,
                "maxItems": 1
              },
              "issue_codes": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "derived_roles": {
                "maxItems": 0
              },
              "derivation_paths": {
                "maxItems": 0
              },
              "issue_codes": {
                "const": [
                  "SRD-TARGET-ROLE-UNRESOLVED"
                ]
              }
            }
          }
        }
      ]
    },
    "roleAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_iri",
        "role"
      ],
      "properties": {
        "semantic_iri": {
          "$ref": "#/$defs/semanticIri"
        },
        "role": {
          "$ref": "#/$defs/semanticRole"
        }
      }
    },
    "issueCode": {
      "enum": [
        "SRD-ROOT-INVALID",
        "SRD-ASSETS-SHAPE",
        "SRD-ASSET-SHAPE",
        "SRD-ASSET-EXTERNAL-GRAPH",
        "SRD-ASSET-PATH",
        "SRD-DUPLICATE-ASSET",
        "SRD-ASSET-MEDIA-TYPE",
        "SRD-ASSET-DIGEST-FORMAT",
        "SRD-ASSET-SYMLINK",
        "SRD-ASSET-MISSING",
        "SRD-ASSET-PATH-ESCAPE",
        "SRD-ASSET-UNREADABLE",
        "SRD-ASSET-DIGEST-MISMATCH",
        "SRD-ASSET-PARSE",
        "SRD-TARGETS-SHAPE",
        "SRD-TARGET-IRI",
        "SRD-IMPORTS-FORBIDDEN",
        "SRD-IDENTITY-AXIOM-FORBIDDEN",
        "SRD-UNSUPPORTED-SEMANTIC-AXIOM",
        "SRD-UNSUPPORTED-CLASS-EXPRESSION",
        "SRD-EXTERNAL-CLASS-REFERENCE",
        "SRD-ROLE-ROOT-UNDECLARED",
        "SRD-ROLE-TAXONOMY-CONFLICT",
        "SRD-CLASS-HIERARCHY-CYCLE",
        "SRD-SOURCE-UNTRUSTED",
        "SRD-TARGET-ROLE-CONFLICT",
        "SRD-TARGET-MULTIPLE-DERIVATION-PATHS",
        "SRD-TARGET-ROLE-UNRESOLVED"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/issueCode"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      }
    }
  }
}
