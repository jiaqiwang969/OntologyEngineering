---
to: out/contracts.rs
sparql:
  types: 'SELECT ?type ?name ?meaning WHERE { ?type <urn:oev2:design:kind> "Type" ; <urn:oev2:design:contractGroup> "engineering" ; <urn:oev2:design:name> ?name ; <urn:oev2:design:meaning> ?meaning } ORDER BY ?name'
  fields: 'SELECT ?owner ?name ?rustType ?meaning ?format ?required ?jsonIdentity ?jsonOptional (EXISTS { ?field <urn:oev2:design:allowedValueRust> ?declaredValue } AS ?declaredAllowedValues) WHERE { ?owner <urn:oev2:design:kind> "Type" ; <urn:oev2:design:contractGroup> "engineering" . ?field <urn:oev2:design:owner> ?owner ; <urn:oev2:design:name> ?name ; <urn:oev2:design:rustType> ?rustType ; <urn:oev2:design:meaning> ?meaning ; <urn:oev2:design:format> ?format ; <urn:oev2:design:required> ?required ; <urn:oev2:design:jsonIdentity> ?jsonIdentity ; <urn:oev2:design:jsonOptional> ?jsonOptional } ORDER BY ?owner ?name'
  machines: 'SELECT ?machine ?name ?initial WHERE { ?machine <urn:oev2:design:kind> "Machine" ; <urn:oev2:design:name> ?name ; <urn:oev2:design:initial> ?initial } ORDER BY ?name'
  states: 'SELECT ?machine ?state WHERE { ?machine <urn:oev2:design:state> ?state } ORDER BY ?machine ?state'
  transitions: 'SELECT ?machine ?from ?event ?to ?guardRust WHERE { ?machine <urn:oev2:design:transition> ?t . ?t <urn:oev2:design:from> ?from ; <urn:oev2:design:event> ?event ; <urn:oev2:design:to> ?to ; <urn:oev2:design:guardRust> ?guardRust } ORDER BY ?machine ?from ?event'
  interfaces: 'SELECT ?name ?method ?input ?output ?error WHERE { ?i <urn:oev2:design:kind> "Interface" ; <urn:oev2:design:contractGroup> "engineering" ; <urn:oev2:design:name> ?name ; <urn:oev2:design:method> ?method ; <urn:oev2:design:input> ?input ; <urn:oev2:design:output> ?output ; <urn:oev2:design:error> ?error } ORDER BY ?name'
  external: 'SELECT DISTINCT ?name WHERE { ?owner <urn:oev2:design:contractGroup> "engineering" ; <urn:oev2:design:field> ?field . ?field <urn:oev2:design:referencedType> ?target . ?target <urn:oev2:design:contractGroup> "semantic" ; <urn:oev2:design:name> ?name } ORDER BY ?name'
  errors: 'SELECT ?name ?code ?meaning ?phase ?retryable WHERE { ?e <urn:oev2:design:kind> "Error" ; <urn:oev2:design:name> ?name ; <urn:oev2:design:code> ?code ; <urn:oev2:design:meaning> ?meaning ; <urn:oev2:design:phase> ?phase ; <urn:oev2:design:retryable> ?retryable } ORDER BY ?code'
  allowed: 'SELECT ?owner ?name ?value WHERE { ?owner <urn:oev2:design:kind> "Type" ; <urn:oev2:design:contractGroup> "engineering" . ?f <urn:oev2:design:owner> ?owner ; <urn:oev2:design:name> ?name ; <urn:oev2:design:allowedValueRust> ?value } ORDER BY ?owner ?name ?value'
---
// Generated by official ggen SPARQL/Tera. Edit specs/engineering.toml.
{% for dependency in external %}pub use semantica_contracts::{{ dependency.name }};
{% endfor %}
/// Field identities and Rust mappings queried from the same design model as DTOs.
/// Consumers must reject unsupported mappings instead of assuming a schema.
pub const CONTRACT_FIELDS: &[(&str, &str, &str)] = &[
{% for t in types %}{% for f in fields %}{% if f.owner == t.type %}    ("{{ t.name }}", "{{ f.name }}", "{{ f.rustType }}"),
{% endif %}{% endfor %}{% endfor %}];
/// Enumerated values queried from the design model; third values are escaped Rust literals.
pub const CONTRACT_ALLOWED: &[(&str, &str, &str)] = &[
{% for t in types %}{% for a in allowed %}{% if a.owner == t.type %}    ("{{ t.name }}", "{{ a.name }}", {{ a.value }}),
{% endif %}{% endfor %}{% endfor %}];
#[derive(Debug, Clone, Copy, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
pub enum ErrorCode {
{% for e in errors %}    /// {{ e.meaning }}
    #[serde(rename = "{{ e.code }}")]
    {{ e.name }},
{% endfor %}}
impl ErrorCode {
    pub fn code(self) -> &'static str {match self {
{% for e in errors %}        Self::{{ e.name }} => "{{ e.code }}",
{% endfor %}    }}
}
{% for t in types %}
/// {{ t.meaning }}
#[derive(Debug, Clone, PartialEq, serde::Serialize, serde::Deserialize)]
#[serde(deny_unknown_fields)]
pub struct {{ t.name }} {
{% for f in fields %}{% if f.owner == t.type %}    /// {{ f.meaning }}
{% if f.jsonIdentity == "preserved" %}    #[serde({% if f.jsonOptional == "true" %}default, {% endif %}deserialize_with = "semantica_contracts::json::deserialize_preserved")]
{% endif %}    pub {{ f.name }}: {{ f.rustType }},
{% endif %}{% endfor %}}
impl {{ t.name }} {
    pub fn validate(&self) -> Result<(), Vec<String>> {
        #[allow(unused_mut)]
        let mut failures = Vec::new();
{% for f in fields %}{% if f.owner == t.type %}{% if f.rustType == "String" %}{% if f.format == "sha256" %}        if self.{{ f.name }}.len() != 64 || !self.{{ f.name }}.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { failures.push("{{ t.name }}.{{ f.name }}:sha256".into()); }
{% elif f.format != "raw_utf8" %}        if self.{{ f.name }}.trim().is_empty() { failures.push("{{ t.name }}.{{ f.name }}:required".into()); }
{% endif %}{% elif f.rustType == "Option<String>" and f.format == "sha256" %}        if let Some(value) = &self.{{ f.name }} { if value.len() != 64 || !value.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase()) { failures.push("{{ t.name }}.{{ f.name }}:sha256".into()); } }
{% elif f.rustType == "f64" %}        if !self.{{ f.name }}.is_finite() { failures.push("{{ t.name }}.{{ f.name }}:finite".into()); }
{% elif f.rustType == "std::collections::BTreeMap<String, Vec<String>>" %}        if self.{{ f.name }}.is_empty() || self.{{ f.name }}.iter().any(|(key, values)| key.trim().is_empty() || values.is_empty() || values.iter().any(|value| value.trim().is_empty())) { failures.push("{{ t.name }}.{{ f.name }}:scope_map".into()); }
{% elif f.rustType == "std::collections::BTreeMap<String, ArtifactReference>" %}        if self.{{ f.name }}.is_empty() { failures.push("{{ t.name }}.{{ f.name }}:source_map".into()); }
        for (key, value) in &self.{{ f.name }} { if key.trim().is_empty() { failures.push("{{ t.name }}.{{ f.name }}:source_id".into()); } if let Err(errors) = value.validate() { failures.extend(errors); } }
{% elif f.format == "object" %}{% if f.rustType is starting_with("Option<") %}        if let Some(value) = &self.{{ f.name }} { if let Err(errors) = value.validate() { failures.extend(errors); } }
{% else %}        if let Err(errors) = self.{{ f.name }}.validate() { failures.extend(errors); }
{% endif %}
{% elif f.format == "page" %}        if self.{{ f.name }} == Some(0) { failures.push("{{ t.name }}.{{ f.name }}:one_based_page".into()); }
{% endif %}{% endif %}{% endfor %}
{% for f in fields %}{% if f.owner == t.type %}{% if f.format == "status" or f.declaredAllowedValues == true %}{% if f.rustType == "Option<String>" %}        if let Some(value) = &self.{{ f.name }} { if ![{% for a in allowed %}{% if a.owner == t.type and a.name == f.name %}{{ a.value }},{% endif %}{% endfor %}].contains(&value.as_str()) { failures.push("{{ t.name }}.{{ f.name }}:{% if f.format == "status" %}status{% else %}allowed_values{% endif %}".into()); } }
{% else %}        if ![{% for a in allowed %}{% if a.owner == t.type and a.name == f.name %}{{ a.value }},{% endif %}{% endfor %}].contains(&self.{{ f.name }}.as_str()) { failures.push("{{ t.name }}.{{ f.name }}:{% if f.format == "status" %}status{% else %}allowed_values{% endif %}".into()); }
{% endif %}{% endif %}{% endif %}{% endfor %}        if failures.is_empty() { Ok(()) } else { Err(failures) }
    }
}
{% endfor %}
{% for m in machines %}
#[derive(Debug, Clone, Copy, Default, PartialEq, Eq, serde::Serialize, serde::Deserialize)]
#[serde(rename_all = "snake_case")]
pub enum {{ m.name }} {
{% for s in states %}{% if s.machine == m.machine %}{% if s.state == m.initial %}    #[default]
{% endif %}    {{ s.state }},
{% endif %}{% endfor %}}
impl {{ m.name }} {
    /// Caller must prove the returned guard; this function grants no authority.
    pub fn transition(self, event: &str) -> Option<(Self, &'static str)> {
        match (self, event) {
{% for t in transitions %}{% if t.machine == m.machine %}            (Self::{{ t.from }}, "{{ t.event }}") => Some((Self::{{ t.to }}, {{ t.guardRust }})),
{% endif %}{% endfor %}            _ => None,
        }
    }
}
{% endfor %}
{% for i in interfaces %}
pub trait {{ i.name }} {
    fn {{ i.method }}(&self, input: &{{ i.input }}) -> Result<{{ i.output }}, {{ i.error }}>;
}
{% endfor %}
