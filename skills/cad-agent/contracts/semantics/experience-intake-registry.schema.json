{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/experience-intake-registry-v1.json",
  "title": "Append-only experience intake registry target",
  "description": "Candidate-only, digest-bound view of explicitly manifested experience records, gates, ingestion reports, and optional pattern candidates. The embedded CAS plan never performs the append or updates an index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assessor_version",
    "registry_id",
    "registry_version",
    "generation",
    "predecessor_committed_snapshot_sha256",
    "state_kind",
    "committed",
    "status",
    "registry_state",
    "source_manifest_id",
    "source_manifest_sha256",
    "entries",
    "registry_snapshot_sha256",
    "append_plan",
    "append_only",
    "activation_authorized",
    "index_update_performed",
    "runtime_routing_changed",
    "issues"
  ],
  "properties": {
    "schema": {"const": "cad-agent.experience-intake-registry.v1"},
    "assessor_version": {"const": "0.1.0"},
    "registry_id": {"$ref": "#/$defs/stableId"},
    "registry_version": {"$ref": "#/$defs/stableId"},
    "generation": {"type": "integer", "minimum": 1},
    "predecessor_committed_snapshot_sha256": {"$ref": "#/$defs/nullableSha256"},
    "state_kind": {"const": "PLANNED_TARGET"},
    "committed": {"const": false},
    "status": {"$ref": "#/$defs/status"},
    "registry_state": {
      "enum": ["APPEND_PLAN_READY", "APPEND_PLAN_REJECTED", "NO_CHANGES"]
    },
    "source_manifest_id": {"$ref": "#/$defs/stableId"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    },
    "registry_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "append_plan": {"$ref": "#/$defs/appendPlan"},
    "append_only": {"const": true},
    "activation_authorized": {"const": false},
    "index_update_performed": {"const": false},
    "runtime_routing_changed": {"const": false},
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "nullableString": {"type": ["string", "null"]},
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "status": {"enum": ["PASS", "FAIL"]},
    "assetVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "declared_sha256",
        "observed_sha256",
        "declared_schema",
        "observed_schema",
        "media_type",
        "status"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "declared_sha256": {"$ref": "#/$defs/sha256"},
        "observed_sha256": {"$ref": "#/$defs/nullableSha256"},
        "declared_schema": {"type": "string", "minLength": 1},
        "observed_schema": {"$ref": "#/$defs/nullableString"},
        "media_type": {"const": "application/json"},
        "status": {
          "enum": [
            "VERIFIED",
            "MISSING",
            "UNSAFE_PATH",
            "UNREADABLE",
            "INVALID_JSON",
            "DIGEST_MISMATCH",
            "SCHEMA_MISMATCH",
            "UNSUPPORTED_SCHEMA",
            "SCHEMA_INVALID"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intake_id",
        "record_id",
        "record",
        "record_status",
        "gate",
        "gate_status",
        "ingestion",
        "ingestion_status",
        "ingestion_report",
        "candidate",
        "candidate_status",
        "intake_status",
        "materialization_eligible",
        "entry_sha256"
      ],
      "properties": {
        "intake_id": {"$ref": "#/$defs/stableId"},
        "record_id": {"$ref": "#/$defs/stableId"},
        "record": {"$ref": "#/$defs/assetVerification"},
        "record_status": {
          "enum": [
            "VERIFIED",
            "MISSING",
            "UNSAFE_PATH",
            "UNREADABLE",
            "INVALID_JSON",
            "DIGEST_MISMATCH",
            "SCHEMA_MISMATCH",
            "UNSUPPORTED_SCHEMA",
            "SCHEMA_INVALID"
          ]
        },
        "gate": {"$ref": "#/$defs/assetVerification"},
        "gate_status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "ingestion": {"$ref": "#/$defs/assetVerification"},
        "ingestion_status": {"enum": ["PASS", "FAIL", "UNKNOWN"]},
        "ingestion_report": {
          "anyOf": [
            {"$ref": "#/$defs/assetVerification"},
            {"type": "null"}
          ]
        },
        "candidate": {
          "anyOf": [
            {"$ref": "#/$defs/assetVerification"},
            {"type": "null"}
          ]
        },
        "candidate_status": {
          "enum": ["ABSENT", "CANDIDATE", "REVIEWABLE", "NOT_CANDIDATE", "UNKNOWN"]
        },
        "intake_status": {
          "enum": ["RECORDED", "REVIEWABLE", "HELD", "REJECTED"]
        },
        "materialization_eligible": {"type": "boolean"},
        "entry_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "appendPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "expected_prior_registry_sha256",
        "observed_prior_registry_sha256",
        "target_registry_snapshot_sha256",
        "added_intake_ids",
        "rejected_intake_ids",
        "eligible",
        "performed"
      ],
      "properties": {
        "mode": {"const": "CompareAndSwapAppendPlanOnly"},
        "expected_prior_registry_sha256": {"$ref": "#/$defs/nullableSha256"},
        "observed_prior_registry_sha256": {"$ref": "#/$defs/nullableSha256"},
        "target_registry_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "added_intake_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "rejected_intake_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/stableId"}
        },
        "eligible": {"type": "boolean"},
        "performed": {"const": false}
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "path", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 2},
        "severity": {"enum": ["ERROR", "WARNING"]},
        "path": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
