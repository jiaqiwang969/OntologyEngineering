+	const body = dialog.add(new ElementFixture('other')); body.attributes = { 'data-dialog-tagitem': 'lc_modal_dialog__body', class: 'lc_modal_dialog__body_3-SF9' };
+	const footer = body.add(new ElementFixture('other')); footer.attributes.class = 'pop-footer-wrapper dialog-button';
+	const button = footer.add(new ElementFixture('button', label));
+	return { ...f, heading, button, header, body };
+}
+
+test('shipped lc_modal import structure is recognized without Arco or role attributes', () => {
+	for (const [title, label] of [['Confirm Importing changes information', 'Apply Changes'], ['确认导入信息', '应用修改']]) {
+		const f = nativeFixture(title, label);
+		assert.equal(f.document.querySelectorAll('.arco-modal, [role="dialog"]').length, 0);
+		assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+		assert.equal(f.button.clicks, 1);
+	}
