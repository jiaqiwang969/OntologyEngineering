# ch19 §19.5 场景：评估补上——覆盖新料触及的每条前提，低温那行在清单上
@prefix fld: <https://product-trustworthiness.local/field#> .

fld:SubReq_47 a fld:SubstitutionRequest ;
    fld:assessedBy fld:Assessment_47 .
fld:Assessment_47 a fld:DesignAssessment ;
    fld:coversPremise fld:Premise_LowTempTempco , fld:Premise_Footprint , fld:Premise_Derating .
fld:Premise_LowTempTempco fld:verdict "需实测低温曲线后再判" .
fld:Premise_Footprint     fld:verdict "封装兼容" .
fld:Premise_Derating      fld:verdict "降额裕度不变" .
