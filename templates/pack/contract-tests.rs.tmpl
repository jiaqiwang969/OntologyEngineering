---
to: out/contract-tests.rs
sparql:
  cases: 'SELECT ?name ?targetType ?inputRust ?expectedValid ?oracle WHERE { ?t <urn:oev2:design:kind> "Type" ; <urn:oev2:design:name> ?targetType ; <urn:oev2:design:contractGroup> "engineering" . ?c <urn:oev2:design:kind> "ContractCase" ; <urn:oev2:design:name> ?name ; <urn:oev2:design:targetType> ?targetType ; <urn:oev2:design:inputRust> ?inputRust ; <urn:oev2:design:expectedValid> ?expectedValid ; <urn:oev2:design:oracle> ?oracle } ORDER BY ?name'
---
// Generated by actual ggen from independently authored design examples.
{% for c in cases %}
#[test]
fn {{ c.name }}() {
    // {{ c.oracle }}
    let actual = serde_json::from_str::<oe_contracts::{{ c.targetType }}>({{ c.inputRust }}).is_ok_and(|value| value.validate().is_ok());
    let expected = {{ c.expectedValid }};
    assert_eq!(actual, expected);
}
{% endfor %}
