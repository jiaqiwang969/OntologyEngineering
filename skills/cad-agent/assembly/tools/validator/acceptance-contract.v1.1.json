        {
          "id": "A2.4",
          "path": "completeness.silent_omissions",
          "operator": "eq",
          "expected": 0
        },
        {
          "id": "A2.5",
          "path": "completeness.exceptions",
          "operator": "empty"
        }
      ]
    },
    {
