+
+function fixture(fail = false) {
+	let value = 'before';
+	const component = new Proxy({}, { get: (_target, key) => () => {
+		if (key === 'getState_OtherProperty') return { ChannelID: value };
+		if (key === 'getState_PrimitiveId') return 'component1';
+		return '';
+	} });
+	(globalThis as any).eda = {
+		dmt_Board: { getCurrentBoardInfo: async () => ({ name: 'Board', schematic: { uuid: 'S' }, pcb: { uuid: 'B' } }) },
+		pcb_PrimitiveComponent: { getAll: async () => [component], getAllPinsByPrimitiveId: async () => [] },
+		pcb_Document: { importChanges: async () => { if (fail) throw new Error('native import failed'); value = 'after'; return true; } },
