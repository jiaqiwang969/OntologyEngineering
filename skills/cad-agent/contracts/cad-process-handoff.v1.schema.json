{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ontology-engineering:cad-process-handoff:v1",
  "title": "CAD and manufacturing process evidence handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "handoff_id", "project", "sources", "features", "functions", "routes", "coverage_assertions", "claims", "questions", "assumptions", "downstream_outputs"],
  "properties": {
    "record_type": {"const": "ontology-engineering.cad-process-handoff/v1"},
    "handoff_id": {"$ref": "#/$defs/id"},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "configuration_id", "model_revision", "product_state"],
      "properties": {
        "project_id": {"$ref": "#/$defs/id"},
        "configuration_id": {"$ref": "#/$defs/id"},
        "model_revision": {"type": "string", "minLength": 1},
        "product_state": {"type": "string", "minLength": 1}
      }
    },
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
    "functions": {"type": "array", "items": {"$ref": "#/$defs/function"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "coverage_assertions": {"type": "array", "items": {"$ref": "#/$defs/coverage"}},
    "claims": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
    "questions": {"type": "array", "items": {"$ref": "#/$defs/question"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "downstream_outputs": {"type": "array", "items": {"$ref": "#/$defs/downstream_output"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "nonempty_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "sha256", "media_type", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string", "minLength": 3},
        "role": {"enum": ["native_model", "native_readback", "drawing", "simulation_input", "simulation_result", "process_record", "conversation", "test_result", "other"]},
        "embedded_source_hashes": {"type": "object", "propertyNames": {"pattern": "^/"}, "additionalProperties": {"$ref": "#/$defs/id"}}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "part_id", "kind", "statement", "geometry_state", "basis", "source_id", "source_locator"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "part_id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "geometry_state": {"type": "string", "minLength": 1},
        "basis": {"enum": ["native_geometry_readback", "drawing_review", "engineering_inference"]},
        "source_id": {"$ref": "#/$defs/id"},
        "source_locator": {"type": "string", "minLength": 1},
        "attributes": {"type": "object"}
      }
    },
    "function": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "status", "basis", "source_ids", "feature_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["required", "candidate"]},
        "basis": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "feature_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "process_type", "target_feature_ids", "intended_function_ids", "mechanism_statement", "source_ids", "validation_source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "process_type": {"type": "string", "minLength": 1},
        "target_feature_ids": {"$ref": "#/$defs/ids"},
        "intended_function_ids": {"$ref": "#/$defs/ids"},
        "mechanism_statement": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "validation_source_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "route": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "status", "source_ids", "operations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["candidate", "under_review", "adopted"]},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation"}}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "claim_id", "function_id", "operation_id", "status", "mechanism_statement", "source_ids", "validation_source_ids", "scope_checked_source_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "claim_id": {"$ref": "#/$defs/id"},
        "function_id": {"$ref": "#/$defs/id"},
        "operation_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["proposed", "verified"]},
        "mechanism_statement": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "validation_source_ids": {"$ref": "#/$defs/ids"},
        "scope_checked_source_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "maturity", "source_ids", "depends_on_function_ids", "depends_on_route_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "maturity": {"enum": ["exploration", "conditional_candidate", "batch_delivery"]},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "baseline_route_id": {"$ref": "#/$defs/id"},
        "target_route_id": {"$ref": "#/$defs/id"},
        "function_list_completeness_source_ids": {"$ref": "#/$defs/ids"},
        "function_list_completeness_scope": {"type": "string", "minLength": 1},
        "depends_on_function_ids": {"$ref": "#/$defs/ids"},
        "depends_on_route_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "direction", "text", "status", "target_ids", "source_ids", "requested_evidence"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "direction": {"enum": ["cad_to_process", "process_to_cad"]},
        "text": {"type": "string", "minLength": 1},
        "status": {"enum": ["open", "answered", "withdrawn"]},
        "target_ids": {"$ref": "#/$defs/nonempty_ids"},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "requested_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumption": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "scope", "source_ids", "applies_to_claim_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "applies_to_claim_ids": {"$ref": "#/$defs/ids"}
      }
    },
    "downstream_output": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "statement", "state", "source_ids", "depends_on_claim_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["process_plan", "inspection_plan", "cost_estimate", "delivery_commitment", "customer_response", "other"]},
        "statement": {"type": "string", "minLength": 1},
        "state": {"enum": ["draft", "conditional", "issued", "superseded"]},
        "source_ids": {"$ref": "#/$defs/nonempty_ids"},
        "depends_on_claim_ids": {"$ref": "#/$defs/nonempty_ids"}
      }
    }
  }
}
