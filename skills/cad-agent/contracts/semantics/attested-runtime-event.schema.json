{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/attested-runtime-event-v1.json",
  "title": "Attested runtime event envelope",
  "description": "A signed binding from an exact payload to one contextual role registration and, except for a clock observation itself, one separately attested clock observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "event_id",
    "event_kind",
    "payload",
    "authority_registry_sha256",
    "principal_id",
    "role_registration_id",
    "role_registration_sha256",
    "credential_id",
    "scope_id",
    "observed_at",
    "sequence",
    "uncertainty_ms",
    "clock_observation_event",
    "signature_algorithm",
    "signature_base64",
    "execution_authorized",
    "fusion_write_authorized"
  ],
  "properties": {
    "schema": {"const": "cad-agent.attested-runtime-event.v1"},
    "event_id": {"$ref": "#/$defs/stableId"},
    "event_kind": {
      "enum": [
        "ClockObservation",
        "MemoryReleaseAcceptanceDecision",
        "MemoryActivationDecision",
        "MemoryPointerTransitionReceipt",
        "MemoryPointerReopenVerification"
      ]
    },
    "payload": {"$ref": "#/$defs/assetRef"},
    "authority_registry_sha256": {"$ref": "#/$defs/sha256"},
    "principal_id": {"$ref": "#/$defs/stableId"},
    "role_registration_id": {"$ref": "#/$defs/stableId"},
    "role_registration_sha256": {"$ref": "#/$defs/sha256"},
    "credential_id": {"$ref": "#/$defs/stableId"},
    "scope_id": {"$ref": "#/$defs/stableId"},
    "observed_at": {"type": "string", "format": "date-time"},
    "sequence": {"type": "integer", "minimum": 0},
    "uncertainty_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
    "clock_observation_event": {
      "oneOf": [{"type": "null"}, {"$ref": "#/$defs/assetRef"}]
    },
    "signature_algorithm": {"const": "Ed25519"},
    "signature_base64": {
      "type": "string",
      "minLength": 86,
      "maxLength": 92,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "execution_authorized": {"const": false},
    "fusion_write_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"event_kind": {"const": "ClockObservation"}}},
      "then": {"properties": {"clock_observation_event": {"type": "null"}}},
      "else": {"properties": {"clock_observation_event": {"$ref": "#/$defs/assetRef"}}}
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema", "media_type"],
      "properties": {
        "path": {"$ref": "#/$defs/projectPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": "string", "minLength": 2, "maxLength": 256},
        "media_type": {"const": "application/json"}
      }
    }
  }
}
