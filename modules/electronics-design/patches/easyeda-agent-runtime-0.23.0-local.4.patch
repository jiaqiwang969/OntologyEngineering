+
+
+test('native identity cannot be authorized by aria labels, loose titles or header buttons', () => {
+	const fake = nativeFixture(); delete fake.header.attributes['data-dialog-tagitem'];
+	fake.modal.attributes['aria-label'] = 'Confirm Importing changes information';
+	fake.modal.add(new ElementFixture('title', 'Confirm Importing changes information'));
+	assert.equal(importConfirmDomStep(fake.document, { click: true }).status, 'none');
+	assert.equal(fake.button.clicks, 0);
