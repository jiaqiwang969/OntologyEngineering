+/** Import confirmation is an observed UI step, not proof of an applied netlist. */
+export type ImportDomRequest = { click: boolean };
+export type ImportDomResult = {
+	status: 'none' | 'open' | 'clicked' | 'no-button' | 'disabled' | 'ambiguous' | 'dom-error';
+	dialogCount: number;
+	buttonCount: number;
+	title?: string;
+	detail?: string;
+};
+export type ImportConfirmProbe = (request: ImportDomRequest) => Promise<ImportDomResult>;
+
+/**
+ * Self-contained so its emitted JS can run in the real DOM's global scope.
+ * No document-wide button search, body-text title matching, focus, or retry click.
+ */
+export function importConfirmDomStep(doc: Document, request: ImportDomRequest): ImportDomResult {
+	try {
+		// Pro 3.2.148's shipped import view uses se/hEo, not Arco. Inventory
+		// its native roots too, so unrelated covering dialogs block the click.
+		const nativeSelector = '[data-render="react"][mask][esc]';
+		const rootSelector = `.arco-modal, [role="dialog"], ${nativeSelector}`;
+		const isNativeRoot = (root: HTMLElement) => root.getAttribute('data-render') === 'react'
+			&& ['true', 'false'].includes(root.getAttribute('mask') ?? '')
+			&& ['true', 'false'].includes(root.getAttribute('esc') ?? '')
+			&& (root.getAttribute('class') ?? '').split(/\s+/).some(name => /^lc_modal_[A-Za-z0-9-]+$/.test(name));
+		const normalize = (value: string | null | undefined) => (value ?? '').replace(/\s+/g, ' ').trim().toLowerCase();
+		const titles = new Set(['确认导入信息', 'confirm importing changes information']);
+		const labels = new Set(['应用修改', 'apply changes']);
+		const visible = (element: HTMLElement) => {
+			if (!element.isConnected || element.closest('[aria-hidden="true"], [inert]')) return false;
+			const style = doc.defaultView?.getComputedStyle(element);
+			return element.getClientRects().length > 0
+				&& style?.display !== 'none' && style?.visibility !== 'hidden' && style?.visibility !== 'collapse';
+		};
+		const matches: { root: HTMLElement; title: string }[] = [];
+		const visibleRoots = Array.from(doc.querySelectorAll<HTMLElement>(rootSelector))
+			.filter(root => visible(root) && (root.matches('.arco-modal, [role="dialog"]') || isNativeRoot(root)));
+		for (const root of visibleRoots) {
+			const native = isNativeRoot(root);
+			// Copying an import title into another native dialog is insufficient.
+			if (native && root.getAttribute('id') !== 'dlgShowImportChanges') continue;
+			const names: Array<string | null> = [];
+			if (!native) {
+				names.push(root.getAttribute('aria-label'));
+				for (const id of (root.getAttribute('aria-labelledby') ?? '').split(/\s+/).filter(Boolean)) {
+					const label = doc.getElementById(id);
+					if (label && root.contains(label) && visible(label)) names.push(label.innerText);
+				}
+				for (const header of Array.from(root.querySelectorAll<HTMLElement>('.arco-modal-title, [role="heading"]'))) {
+					if (header.closest(rootSelector) === root && visible(header)) names.push(header.innerText);
+				}
+			}
+			if (native) {
+				// Actual title: translated span with canonical English data-test,
+				// inside this host root's own tagged header, not arbitrary body text.
+				for (const header of Array.from(root.querySelectorAll<HTMLElement>('[data-dialog-tagitem="lc_modal_dialog__header"]'))) {
+					if (header.closest(rootSelector) !== root || !visible(header)) continue;
+					for (const label of Array.from(header.querySelectorAll<HTMLElement>('span[data-test]'))) {
+						if (label.closest(rootSelector) === root && visible(label)
+							&& normalize(label.getAttribute('data-test')) === 'confirm importing changes information') {
+							names.push(label.innerText);
+						}
+					}
+				}
+			}
+			const title = names.map(normalize).find(value => titles.has(value));
+			if (title) matches.push({ root, title });
+		}
+		if (!matches.length) return { status: 'none', dialogCount: 0, buttonCount: 0 };
+		if (matches.length !== 1) return { status: 'ambiguous', dialogCount: matches.length, buttonCount: 0 };
+		const { root, title } = matches[0];
+		// An unrelated visible modal may cover this one. Do not click through it.
+		if (visibleRoots.some(other => other !== root && !other.contains(root))) {
+			return { status: 'ambiguous', dialogCount: visibleRoots.length, buttonCount: 0, title };
+		}
+		// Observation after the one click deliberately does not depend on a footer.
+		if (!request.click) return { status: 'open', dialogCount: 1, buttonCount: 0, title };
+		const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button')).filter(button => {
+			if (button.closest(rootSelector) !== root || !visible(button) || !labels.has(normalize(button.innerText))) return false;
+			if (!isNativeRoot(root)) return true;
+			const body = button.closest<HTMLElement>('[data-dialog-tagitem="lc_modal_dialog__body"]');
+			return !!body && body.closest(rootSelector) === root && visible(body);
+		});
+		if (!buttons.length) return { status: 'no-button', dialogCount: 1, buttonCount: 0, title };
+		if (buttons.length !== 1) return { status: 'ambiguous', dialogCount: 1, buttonCount: buttons.length, title };
+		const button = buttons[0];
+		// This host's Ie button suppresses its handler with a CSS disabled state;
+		// the native DOM button does not necessarily receive a disabled attribute.
+		const nativeDisabled = isNativeRoot(root) && (button.getAttribute('class') ?? '').split(/\s+/)
+			.some(name => /^lc_btn__type_[a-z]+_(disabled|readonly)(?:_|$)/.test(name));
+		if (button.disabled || button.getAttribute('aria-disabled') === 'true' || nativeDisabled) {
+			return { status: 'disabled', dialogCount: 1, buttonCount: 1, title };
+		}
+		button.click();
+		return { status: 'clicked', dialogCount: 1, buttonCount: 1, title };
+	}
+	catch (error) {
+		return { status: 'dom-error', dialogCount: 0, buttonCount: 0,
+			detail: error instanceof Error ? error.message : String(error) };
+	}
+}
+
+/** The existing extension sandbox hides module-scope document. No SDK debug call. */
+export function createImportConfirmProbe(): ImportConfirmProbe {
+	const AsyncFunction = Object.getPrototypeOf(async () => {}).constructor as {
+		new (argument: string, body: string): ImportConfirmProbe;
+	};
+	return new AsyncFunction('request', `return (${importConfirmDomStep.toString()})(document, request);`);
+}
+
+export type ImportConfirmStatus = 'dialog-closed' | 'no-dialog' | 'no-button' | 'button-disabled'
+	| 'ambiguous' | 'dismissed-before-click' | 'close-timeout' | 'probe-timeout' | 'dom-error';
+export type ImportConfirmResult = {
+	status: ImportConfirmStatus;
+	clicked: boolean;
+	dialogObserved: boolean;
+	dialogClosed: boolean;
+	polls: number;
+	elapsedMs: number;
+	lastObservation?: ImportDomResult;
+};
+export type ImportConfirmOptions = {
+	appearanceTimeoutMs?: number;
+	closeTimeoutMs?: number;
+	pollIntervalMs?: number;
+	probeTimeoutMs?: number;
+	/** Injected only for deterministic tests. */
+	now?: () => number;
+	sleep?: (milliseconds: number) => Promise<void>;
+};
+
+/** At most one click; every post-click probe is observation-only, with deadlines. */
+export async function confirmImportDialog(probe: ImportConfirmProbe, options: ImportConfirmOptions = {}): Promise<ImportConfirmResult> {
+	const duration = (value: number | undefined, fallback: number) => {
+		const result = value ?? fallback;
+		if (!Number.isFinite(result) || result <= 0 || result > 60_000) throw new Error('Invalid import confirmation timeout/interval');
+		return result;
+	};
+	const appearMs = duration(options.appearanceTimeoutMs, 8_000);
+	const closeMs = duration(options.closeTimeoutMs, 10_000);
+	const interval = duration(options.pollIntervalMs, 250);
+	const probeMs = duration(options.probeTimeoutMs, 2_000);
+	const now = options.now ?? Date.now;
+	const sleep = options.sleep ?? (ms => new Promise<void>(resolve => setTimeout(resolve, ms)));
+	const start = now();
+	let deadline = start + appearMs;
+	let clicked = false;
+	let observed = false;
+	let polls = 0;
+	let last: ImportDomResult | undefined;
+	const result = (status: ImportConfirmStatus): ImportConfirmResult => ({
+		status, clicked, dialogObserved: observed, dialogClosed: status === 'dialog-closed',
+		polls, elapsedMs: Math.max(0, now() - start), lastObservation: last,
+	});
+	for (;;) {
+		const remaining = deadline - now();
+		if (remaining <= 0) {
+			if (clicked) return result('close-timeout');
+			return result(last?.status === 'disabled' ? 'button-disabled' : observed ? 'no-button' : 'no-dialog');
+		}
+		let timer: ReturnType<typeof setTimeout> | undefined;
+		try {
+			const step = await Promise.race([
+				probe({ click: !clicked }),
+				new Promise<undefined>(resolve => { timer = setTimeout(() => resolve(undefined), Math.min(probeMs, remaining)); }),
+			]);
+			polls++;
+			if (!step) return result('probe-timeout');
+			last = step;
+		}
+		catch (error) {
+			last = { status: 'dom-error', dialogCount: 0, buttonCount: 0,
+				detail: error instanceof Error ? error.message : String(error) };
+			return result('dom-error');
+		}
+		finally { if (timer !== undefined) clearTimeout(timer); }
+		if (last.status === 'dom-error') return result('dom-error');
+		if (last.status === 'ambiguous') return result('ambiguous');
+		if (last.status === 'none') {
+			if (clicked) return result('dialog-closed');
+			if (observed) return result('dismissed-before-click');
+		}
+		else {
+			observed = true;
+			if (last.status === 'clicked') {
+				if (clicked) return result('dom-error'); // A probe must obey observation-only requests.
+				clicked = true;
+				deadline = now() + closeMs;
+			}
+		}
+		await sleep(Math.min(interval, Math.max(0, deadline - now())));
+	}
+}
+
+/** API true means workflow opened on the observed host. Counts/closure are not verification. */
+export function assessImportCompletion(input: {
+	apiResult: boolean | undefined;
+	confirmation: ImportConfirmResult | undefined;
+	postcondition: 'verified' | 'not-verified' | 'not-run';
+}): {
+	imported: boolean;
+	completion: 'verified' | 'applied_unverified' | 'confirmation_incomplete';
+	apiResult: boolean | undefined;
+	reason: 'postcondition-verified' | 'confirmation-incomplete' | 'postcondition-unverified';
+} {
+	if (input.confirmation?.status !== 'dialog-closed' || !input.confirmation.clicked || !input.confirmation.dialogClosed) {
+		return { imported: false, completion: 'confirmation_incomplete', apiResult: input.apiResult, reason: 'confirmation-incomplete' };
+	}
+	if (input.postcondition !== 'verified') {
+		return { imported: false, completion: 'applied_unverified', apiResult: input.apiResult, reason: 'postcondition-unverified' };
+	}
+	// The SDK can leave its promise unresolved even after applying. Keep that
+	// observation separate from an independent, explicitly scoped postcondition.
+	return { imported: true, completion: 'verified', apiResult: input.apiResult, reason: 'postcondition-verified' };
+}
