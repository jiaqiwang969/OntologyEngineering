{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/curriculum-memory-retrospective-index-v1.json",
  "title": "S01-S23 curriculum-memory retrospective index",
  "description": "A candidate-only, hash-bound, read-only projection for locating lesson episodes and deciding whether process memory already exists, needs curation, or should remain historical. It is not an intake decision, WorkflowExperienceRecord generator, active-memory pointer, or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "index_id",
    "index_version",
    "status",
    "frozen_on",
    "scope",
    "working_memory_index_asset_id",
    "assets",
    "lessons",
    "authority"
  ],
  "properties": {
    "schema": {
      "const": "cad-agent.curriculum-memory-retrospective-index.v1"
    },
    "index_id": {
      "const": "curriculum-memory-retrospective-s01-s23"
    },
    "index_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "Candidate"
    },
    "frozen_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_lesson",
        "last_lesson",
        "lesson_count",
        "selection_policy",
        "non_authorizing_purpose"
      ],
      "properties": {
        "first_lesson": {"const": "S01"},
        "last_lesson": {"const": "S23"},
        "lesson_count": {"const": 23},
        "selection_policy": {
          "const": "one evidence-bearing current episode per lesson, plus branches needed to prevent identity collapse"
        },
        "non_authorizing_purpose": {
          "const": "retrospective discovery, evidence integrity, and curation routing only"
        }
      }
    },
    "working_memory_index_asset_id": {
      "$ref": "#/$defs/stableId"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/asset"}
    },
    "lessons": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {"$ref": "#/$defs/lesson"}
    },
    "authority": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "role", "path", "sha256", "media_type"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/stableId"},
        "role": {
          "enum": [
            "EPISODE_EVIDENCE",
            "MEMORY_EVIDENCE",
            "PROJECTION_EVIDENCE",
            "WORKING_MEMORY_INDEX",
            "WORKING_MEMORY_REFERENCE"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "media_type": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128
        }
      }
    },
    "assetIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lesson_id", "working_memory_asset_id", "episodes"],
      "properties": {
        "lesson_id": {
          "type": "string",
          "pattern": "^S(?:0[1-9]|1[0-9]|2[0-3])$"
        },
        "working_memory_asset_id": {"$ref": "#/$defs/stableId"},
        "episodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/episode"}
        }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "episode_id",
        "attempt_id",
        "title",
        "summary",
        "episode_state",
        "memory_artifact_state",
        "pattern_bindings",
        "projection_state",
        "projection_detail",
        "source_asset_ids",
        "memory_asset_ids",
        "projection_asset_ids",
        "branch",
        "supersession",
        "course_credit",
        "next_action",
        "authority"
      ],
      "properties": {
        "episode_id": {
          "type": "string",
          "pattern": "^S(?:0[1-9]|1[0-9]|2[0-3])/attempt-[0-9]{4}$"
        },
        "attempt_id": {
          "type": "string",
          "pattern": "^attempt-[0-9]{4}$"
        },
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "summary": {"$ref": "#/$defs/nonEmptyText"},
        "episode_state": {
          "enum": [
            "TRACE_COMPLETE",
            "EXECUTED_NOT_DURABLE",
            "DURABLE_CHECKPOINT",
            "DURABLE_REOPENED",
            "INCOMPLETE_BRANCH"
          ]
        },
        "memory_artifact_state": {
          "enum": [
            "NO_PROCESS_MEMORY_ARTIFACT",
            "WORKFLOW_RECORD_PRESENT",
            "PATTERN_PRESENT",
            "WORKFLOW_RECORD_AND_PATTERN_PRESENT"
          ]
        },
        "pattern_bindings": {
          "$ref": "#/$defs/patternBindings"
        },
        "projection_state": {
          "enum": ["CURRENT", "STALE", "STATIC_ONLY", "UNINDEXED"]
        },
        "projection_detail": {"$ref": "#/$defs/projectionDetail"},
        "source_asset_ids": {
          "allOf": [
            {"$ref": "#/$defs/assetIds"},
            {"minItems": 1}
          ]
        },
        "memory_asset_ids": {"$ref": "#/$defs/assetIds"},
        "projection_asset_ids": {"$ref": "#/$defs/assetIds"},
        "branch": {"$ref": "#/$defs/branch"},
        "supersession": {"$ref": "#/$defs/supersession"},
        "course_credit": {"$ref": "#/$defs/courseCredit"},
        "next_action": {"$ref": "#/$defs/nextAction"},
        "authority": {"$ref": "#/$defs/authority"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "course_credit": {
                "properties": {"p2_ui_credit": {"const": true}},
                "required": ["p2_ui_credit"]
              }
            },
            "required": ["course_credit"]
          },
          "then": {
            "properties": {
              "course_credit": {
                "properties": {"p1_engineering_evidence": {"const": true}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"episode_state": {"const": "INCOMPLETE_BRANCH"}},
            "required": ["episode_state"]
          },
          "then": {
            "properties": {
              "course_credit": {
                "properties": {
                  "p1_engineering_evidence": {"const": false},
                  "p2_ui_credit": {"const": false}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"projection_state": {"const": "CURRENT"}},
            "required": ["projection_state"]
          },
          "then": {
            "properties": {
              "projection_detail": {
                "properties": {"stored_state": {"const": "CURRENT"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"projection_state": {"const": "STALE"}},
            "required": ["projection_state"]
          },
          "then": {
            "properties": {
              "projection_detail": {
                "properties": {"stored_state": {"const": "STALE"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"projection_state": {"const": "STATIC_ONLY"}},
            "required": ["projection_state"]
          },
          "then": {
            "properties": {
              "projection_detail": {
                "properties": {"stored_state": {"const": "STATIC_ONLY"}}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"projection_state": {"const": "UNINDEXED"}},
            "required": ["projection_state"]
          },
          "then": {
            "properties": {
              "projection_detail": {
                "properties": {"stored_state": {"const": "UNINDEXED"}}
              }
            }
          }
        }
      ]
    },
    "patternBindings": {
      "type": "array",
      "description": "Episode-specific RDF assertions. Merely naming a graph asset never establishes that a pattern exists for an episode; the bound relation must be present in that graph.",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/patternBinding"}
    },
    "patternBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graph_asset_id",
        "pattern_iri",
        "relation",
        "episode_iri"
      ],
      "properties": {
        "graph_asset_id": {"$ref": "#/$defs/stableId"},
        "pattern_iri": {"$ref": "#/$defs/absoluteIri"},
        "relation": {
          "enum": ["GROUNDED_IN", "APPLIED_IN", "RETRIEVED_FOR"]
        },
        "episode_iri": {"$ref": "#/$defs/absoluteIri"}
      }
    },
    "projectionDetail": {
      "type": "object",
      "description": "One episode's membership state in a named hash-bound curriculum projection. This is not a health or freshness assertion about the projection as a whole.",
      "additionalProperties": false,
      "required": [
        "scope",
        "subject_episode_id",
        "membership_source_asset_id",
        "stored_state",
        "live_recomputation_status",
        "live_recomputation_persisted",
        "note"
      ],
      "properties": {
        "scope": {"const": "EPISODE_MEMBERSHIP"},
        "subject_episode_id": {
          "type": "string",
          "pattern": "^S(?:0[1-9]|1[0-9]|2[0-3])/attempt-[0-9]{4}$"
        },
        "membership_source_asset_id": {"$ref": "#/$defs/stableId"},
        "stored_state": {
          "description": "Must equal projection_state. An indexed matching JSON lesson/attempt is CURRENT; an existing row with mismatched or explicitly unindexed attempt membership is STALE; a non-JSON basis is STATIC_ONLY; and an absent lesson row is UNINDEXED.",
          "enum": ["CURRENT", "STALE", "STATIC_ONLY", "UNINDEXED"]
        },
        "live_recomputation_status": {
          "enum": [
            "NOT_APPLICABLE",
            "NOT_RUN",
            "RECOMPUTABLE",
            "COMPILED_PROPOSALS"
          ]
        },
        "live_recomputation_persisted": {"const": false},
        "note": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "parent_episode_id", "relation_note"],
      "properties": {
        "kind": {
          "enum": [
            "MAINLINE",
            "CORRECTED_MAINLINE",
            "USER_OVERRIDE",
            "ALTERNATE",
            "INCOMPLETE_EXPERIMENT"
          ]
        },
        "parent_episode_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^S(?:0[1-9]|1[0-9]|2[0-3])/attempt-[0-9]{4}$"
            },
            {"type": "null"}
          ]
        },
        "relation_note": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes",
        "superseded_by",
        "preserves_parallel",
        "note"
      ],
      "properties": {
        "supersedes": {"$ref": "#/$defs/episodeIds"},
        "superseded_by": {"$ref": "#/$defs/episodeIds"},
        "preserves_parallel": {"$ref": "#/$defs/episodeIds"},
        "note": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "episodeIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^S(?:0[1-9]|1[0-9]|2[0-3])/attempt-[0-9]{4}$"
      }
    },
    "courseCredit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p1_engineering_evidence",
        "p2_ui_credit",
        "boundary"
      ],
      "properties": {
        "p1_engineering_evidence": {"type": "boolean"},
        "p2_ui_credit": {"type": "boolean"},
        "boundary": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "nextAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement"],
      "properties": {
        "kind": {
          "enum": [
            "NONE",
            "RETAIN_TRACE",
            "CURATE_RECORD",
            "CURATE_HISTORY",
            "RECOMPUTE_GATE",
            "REVIEW_CANDIDATE",
            "ISOLATE_HISTORICAL"
          ]
        },
        "statement": {"$ref": "#/$defs/nonEmptyText"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation_authorized",
        "candidate_admission_authorized",
        "execution_authorized",
        "record_synthesized",
        "runtime_routing_changed",
        "shared_memory_activation_authorized"
      ],
      "properties": {
        "activation_authorized": {"const": false},
        "candidate_admission_authorized": {"const": false},
        "execution_authorized": {"const": false},
        "record_synthesized": {"const": false},
        "runtime_routing_changed": {"const": false},
        "shared_memory_activation_authorized": {"const": false}
      }
    },
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "absoluteIri": {
      "type": "string",
      "format": "uri",
      "minLength": 3,
      "maxLength": 2048,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:.+$"
    }
  }
}
