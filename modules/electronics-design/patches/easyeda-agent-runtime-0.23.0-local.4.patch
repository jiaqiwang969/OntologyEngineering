+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { createContext, runInContext } from 'node:vm';
+import ts from 'typescript';
+import * as protocol from './protocol';
+import { describeThrown } from './util';
+
+test('register rejection reaches the native log while disconnected; one scan ends with all timers released', async () => {
+	// Fake time and SDK only. No GUI, real WebSocket, worker, or daemon.
+	let now = 0, sequence = 0, registrations = 0;
+	const logs: string[] = [];
+	const tasks = new Map<number, { due: number; fn: () => void; interval?: number }>();
+	const add = (fn: () => void, delay: number, interval?: number) => {
+		const id = ++sequence; tasks.set(id, { due: now + delay, fn, interval }); return id;
+	};
+	const exports: Record<string, any> = {};
+	const permissionError = '错误：未启用扩展和独立脚本的外部交互权限！';
+	const sandbox = createContext({
+		exports, console: { log() {}, warn() {}, error() {} },
+		require: (name: string) => {
+			if (name === './protocol') return protocol;
+			if (name === './util') return { describeThrown };
+			if (name === './transport-identity') return { createWebSocketId: () => 'synthetic-register-error' };
+			if (name === './eda-context') return { buildContextFrame: async () => { throw new Error('no connection expected'); }, readEasyEdaVersion: () => 'synthetic' };
+			if (name === './actions') return { runAction: async () => { throw new Error('no actions expected'); } };
+			throw new Error(`Unexpected import ${name}`);
+		},
+		setTimeout: (fn: () => void, delay: number) => add(fn, delay), clearTimeout: (id: number) => tasks.delete(id),
+		setInterval: (fn: () => void, delay: number) => add(fn, delay, delay), clearInterval: (id: number) => tasks.delete(id),
+		Blob: class {}, URL: { createObjectURL: () => { throw new Error('force timer fallback'); }, revokeObjectURL() {} },
+		eda: {
+			sys_Log: { add: (message: string) => logs.push(message) },
+			sys_WebSocket: {
+				close() {}, register() { registrations++; throw permissionError; },
+				send() { throw new Error('must not send while disconnected'); },
+			},
+		},
+	});
+	const source = readFileSync(join(__dirname, 'transport.ts'), 'utf8');
+	const compiled = ts.transpileModule(source, { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS } }).outputText;
+	runInContext(compiled, sandbox);
+	exports.reconnect();
+	for (let step = 0; step < 100; step++) {
+		for (let i = 0; i < 16; i++) await Promise.resolve();
+		const next = [...tasks.entries()].sort((a, b) => a[1].due - b[1].due)[0];
+		if (!next) break;
+		now = next[1].due;
+		if (next[1].interval) next[1].due += next[1].interval;
+		else tasks.delete(next[0]);
+		next[1].fn();
+	}
+	const failures = logs.filter(message => message.includes('WebSocket register failed'));
+	assert.equal(registrations, 10, 'exactly one bounded port scan');
+	assert.equal(failures.length, 10);
+	assert.ok(failures.every(message => message.includes(permissionError)), 'native log retains actual SDK rejection');
+	assert.match(failures[0], /port=60832 session=/);
+	assert.equal(tasks.size, 0, 'no auto-reconnect or watchdog is left running');
+	assert.equal(exports.getConnectionStatus().connected, false);
+	assert.equal(exports.getConnectionStatus().connecting, false);
+});
