@@ -0,0 +1,373 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import vm from 'node:vm';
+import { build } from 'esbuild';
+import { assessImportCompletion, confirmImportDialog, createImportConfirmProbe, importConfirmDomStep,
+	type ImportConfirmResult, type ImportDomResult } from './import-confirm';
+
+/** Minimal structural DOM fixture. No GUI, daemon, jsdom install or network. */
+class ElementFixture {
+	children: ElementFixture[] = [];
+	parent: ElementFixture | null = null;
+	attributes: Record<string, string> = {};
+	disabled = false;
+	hidden = false;
+	isConnected = true;
+	offsetParent: object | null = {};
+	clicks = 0;
+	onclick = () => {};
+	constructor(public kind: 'modal' | 'title' | 'button' | 'other', public innerText = '', public tagName = kind === 'button' ? 'button' : 'div') {}
+	matches(selector: string): boolean {
+		return selector.split(',').some(raw => {
+			let part = raw.trim();
+			if (part === '*') return true;
+			if (part === '[class*=modal]') return this.kind === 'modal' || (this.attributes.class ?? '').includes('modal');
+			const tag = part.match(/^[a-z]+/);
+			if (tag) { if (this.tagName !== tag[0]) return false; part = part.slice(tag[0].length); }
+			const klass = part.match(/^\.([\w-]+)/);
+			if (klass) {
+				const classes = this.attributes.class?.split(/\s+/) ?? (this.kind === 'modal' ? ['arco-modal'] : this.kind === 'title' ? ['arco-modal-title'] : []);
+				if (!classes.includes(klass[1])) return false;
+				part = part.slice(klass[0].length);
+			}
+			for (const match of Array.from(part.matchAll(/\[([\w-]+)(?:="([^"]*)")?\]/g))) {
+				if (!(match[1] in this.attributes) || (match[2] !== undefined && this.attributes[match[1]] !== match[2])) return false;
+				part = part.replace(match[0], '');
+			}
+			return part === '';
+		});
+	}
+	add(child: ElementFixture): ElementFixture { child.parent = this; this.children.push(child); return child; }
+	getAttribute(name: string): string | null { return this.attributes[name] ?? null; }
+	getClientRects(): unknown[] {
+		for (let p: ElementFixture | null = this; p; p = p.parent) if (p.hidden) return [];
+		return [{}];
+	}
+	contains(child: ElementFixture): boolean {
+		for (let p: ElementFixture | null = child; p; p = p.parent) if (p === this) return true;
+		return false;
+	}
+	closest(selector: string): ElementFixture | null {
+		for (let p: ElementFixture | null = this; p; p = p.parent) if (p.matches(selector)) return p;
+		return null;
+	}
+	querySelectorAll(selector: string): ElementFixture[] {
+		const all = this.children.flatMap(c => [c, ...c.querySelectorAll('*')]);
+		return all.filter(c => c.matches(selector));
+	}
+	click(): void { this.clicks++; this.onclick(); }
+}
+
+function fixture(title = 'Confirm Importing changes information', label = 'Apply Changes') {
+	const root = new ElementFixture('other');
+	const modal = root.add(new ElementFixture('modal', title));
+	const heading = modal.add(new ElementFixture('title', title));
+	const button = modal.add(new ElementFixture('button', label));
+	const document = {
+		querySelectorAll: (selector: string) => root.querySelectorAll(selector),
+		getElementById: (id: string) => root.querySelectorAll('*').find(e => e.attributes.id === id) ?? null,
+		defaultView: { getComputedStyle: (element: ElementFixture) => ({ display: element.hidden ? 'none' : 'block', visibility: 'visible' }) },
+	} as unknown as Document;
+	return { root, modal, heading, button, document };
+}
+
+// Exact released v0.23 step predicate (recorded pcb-import-locale-01 source).
+// LEGACY mode intentionally runs the new EN expectation against this old body.
+const legacyStep = new Function('document', `
+	const modals = Array.from(document.querySelectorAll('.arco-modal, [class*=modal]'))
+		.filter(e => e.offsetParent !== null && (e.innerText || '').includes('确认导入信息'));
+	if (!modals.length) return 'none';
+	const btn = modals.flatMap(m => Array.from(m.querySelectorAll('button')))
+		.find(b => (b.innerText || '').trim() === '应用修改' && b.offsetParent !== null);
+	if (!btn) return 'no-button';
+	btn.click();
+	return 'clicked';
+`) as (doc: Document) => string;
+
+test('observed EN title and Apply Changes regression', () => {
+	const f = fixture();
+	const outcome = process.env.IMPORT_CONFIRM_IMPLEMENTATION === 'legacy'
+		? legacyStep(f.document) : importConfirmDomStep(f.document, { click: true }).status;
+	assert.equal(outcome, 'clicked');
+	assert.equal(f.button.clicks, 1);
+});
+
+test('Chinese and mixed language labels are explicitly supported', () => {
+	for (const [title, button] of [['确认导入信息', '应用修改'], ['确认导入信息', 'Apply Changes'], ['Confirm Importing changes information', '应用修改']]) {
+		const f = fixture(title, button); assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+	}
+});
+
+test('normalizes case/whitespace but not unrecognized titles', () => {
+	const f = fixture('  CONFIRM  Importing\nchanges information ', ' APPLY  CHANGES ');
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+	f.heading.innerText = 'Confirm Importing changes information — unrelated';
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'none');
+});
+
+test('does not match text in modal body or an unrelated global Apply button', () => {
+	const f = fixture('Delete project');
+	f.modal.innerText = '确认导入信息';
+	f.root.add(new ElementFixture('button', 'Apply Changes'));
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'none');
+	assert.equal(f.button.clicks, 0);
+});
+
+test('hidden and aria-hidden dialog/buttons are never clicked', () => {
+	const f = fixture(); f.modal.hidden = true;
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'none');
+	f.modal.hidden = false; f.modal.attributes['aria-hidden'] = 'true';
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'none');
+	delete f.modal.attributes['aria-hidden']; f.button.hidden = true;
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'no-button');
+	assert.equal(f.button.clicks, 0);
+});
+
+test('fixed visible dialogs need not have an offsetParent', () => {
+	const f = fixture(); f.modal.offsetParent = null; f.button.offsetParent = null;
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+});
+
+test('disabled and aria-disabled Apply buttons are observed without clicks', () => {
+	const f = fixture(); f.button.disabled = true;
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'disabled');
+	f.button.disabled = false; f.button.attributes['aria-disabled'] = 'true';
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'disabled');
+	assert.equal(f.button.clicks, 0);
+});
+
+test('multiple matching dialogs or buttons fail closed', () => {
+	const f = fixture(); const other = f.root.add(new ElementFixture('modal'));
+	other.add(new ElementFixture('title', '确认导入信息'));
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'ambiguous');
+	other.hidden = true; f.modal.add(new ElementFixture('button', '应用修改'));
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'ambiguous');
+	assert.equal(f.button.clicks, 0);
+});
+
+test('nested modal title/button do not authorize clicking its ancestor', () => {
+	const f = fixture('Unrelated'); const nested = f.modal.add(new ElementFixture('modal'));
+	nested.add(new ElementFixture('title', '确认导入信息'));
+	const target = nested.add(new ElementFixture('button', '应用修改'));
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+	assert.equal(target.clicks, 1); assert.equal(f.button.clicks, 0);
+});
+
+test('an unrelated visible modal prevents clicking through an overlay', () => {
+	const f = fixture(); f.root.add(new ElementFixture('modal', 'Delete project'));
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'ambiguous');
+	assert.equal(f.button.clicks, 0);
+});
+
+test('aria-labelledby only uses an explicitly bound in-dialog visible label', () => {
+	const f = fixture(); f.heading.kind = 'other'; f.heading.attributes.id = 'import-title';
+	f.modal.attributes['aria-labelledby'] = 'import-title';
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'clicked');
+	f.heading.hidden = true;
+	assert.equal(importConfirmDomStep(f.document, { click: true }).status, 'none');
+});
+
+test('observation-only probes never click, even with an enabled Apply button', () => {
+	const f = fixture();
+	assert.equal(importConfirmDomStep(f.document, { click: false }).status, 'open');
+	assert.equal(f.button.clicks, 0);
+});
+
+test('global-scope probe factory executes the emitted function without module document', async () => {
+	const f = fixture(); const prior = Object.getOwnPropertyDescriptor(globalThis, 'document');
+	Object.defineProperty(globalThis, 'document', { configurable: true, value: f.document });
+	try { assert.equal((await createImportConfirmProbe()({ click: true })).status, 'clicked'); }
+	finally {
+		if (prior) Object.defineProperty(globalThis, 'document', prior);
+		else Reflect.deleteProperty(globalThis, 'document');
+	}
+});
+
+test('production-shaped esbuild output retains a self-contained sandbox escape', async () => {
+	const built = await build({ entryPoints: [require.resolve('./import-confirm')], bundle: true,
+		platform: 'browser', format: 'iife', globalName: 'ImportConfirmTest', target: 'esnext', minify: false, write: false });
+	for (const f of [fixture(), nativeFixture()]) {
+		const context = vm.createContext({ document: f.document });
+		vm.runInContext(built.outputFiles[0].text, context);
+		const result = await vm.runInContext('ImportConfirmTest.createImportConfirmProbe()({click:true})', context);
+		assert.equal(result.status, 'clicked'); assert.equal(f.button.clicks, 1);
+	}
+});
+
+function clock() {
+	let current = 0;
+	return { appearanceTimeoutMs: 30, closeTimeoutMs: 30, pollIntervalMs: 10, probeTimeoutMs: 30,
+		now: () => current, sleep: async (ms: number) => { current += ms; } };
+}
+const observation = (status: ImportDomResult['status']): ImportDomResult => ({ status, dialogCount: status === 'none' ? 0 : 1, buttonCount: status === 'clicked' ? 1 : 0 });
+
+test('polls for appearance, clicks once, then observes close without repeat clicks', async () => {
+	const states: ImportDomResult['status'][] = ['none', 'clicked', 'open', 'none'];
+	const requests: boolean[] = [];
+	const result = await confirmImportDialog(async request => { requests.push(request.click); return observation(states.shift()!); }, clock());
+	assert.equal(result.status, 'dialog-closed');
+	assert.deepEqual(requests, [true, true, false, false]);
+	assert.equal(result.clicked, true); assert.equal(result.dialogClosed, true);
+});
+
+test('persistent dialog gives close-timeout and is never clicked again', async () => {
+	let clicks = 0;
+	const result = await confirmImportDialog(async request => {
+		if (request.click) { clicks++; return observation('clicked'); }
+		return observation('open');
+	}, clock());
+	assert.equal(result.status, 'close-timeout'); assert.equal(clicks, 1); assert.equal(result.dialogClosed, false);
+});
+
+test('no dialog, no button and disabled button have separate terminal outcomes', async () => {
+	for (const [step, expected] of [['none', 'no-dialog'], ['no-button', 'no-button'], ['disabled', 'button-disabled']] as const) {
+		const result = await confirmImportDialog(async () => observation(step), clock());
+		assert.equal(result.status, expected); assert.equal(result.clicked, false);
+	}
+});
+
+test('button can become available while polling; cancellation is not apply', async () => {
+	const states: ImportDomResult['status'][] = ['no-button', 'disabled', 'clicked', 'none'];
+	assert.equal((await confirmImportDialog(async () => observation(states.shift()!), clock())).status, 'dialog-closed');
+	const cancelled: ImportDomResult['status'][] = ['no-button', 'none'];
+	assert.equal((await confirmImportDialog(async () => observation(cancelled.shift()!), clock())).status, 'dismissed-before-click');
+});
+
+test('DOM errors, ambiguous dialogs and unresponsive probes are bounded failures', async () => {
+	assert.equal((await confirmImportDialog(async () => { throw new Error('DOM inaccessible'); }, clock())).status, 'dom-error');
+	assert.equal((await confirmImportDialog(async () => observation('ambiguous'), clock())).status, 'ambiguous');
+	assert.equal((await confirmImportDialog(() => new Promise(() => {}), { ...clock(), probeTimeoutMs: 1 })).status, 'probe-timeout');
+});
+
+test('invalid timing configuration cannot create an unbounded polling loop', async () => {
+	for (const duration of [0, -1, Infinity, NaN, 60001]) {
+		await assert.rejects(confirmImportDialog(async () => observation('none'), { appearanceTimeoutMs: duration }));
+	}
+});
+
+const closed: ImportConfirmResult = { status: 'dialog-closed', clicked: true, dialogObserved: true, dialogClosed: true, polls: 2, elapsedMs: 1 };
+test('API true or click-and-close alone do not claim imported=true', () => {
+	assert.equal(assessImportCompletion({ apiResult: true, confirmation: undefined, postcondition: 'not-run' }).imported, false);
+	const answer = assessImportCompletion({ apiResult: true, confirmation: closed, postcondition: 'not-run' });
+	assert.equal(answer.imported, false); assert.equal(answer.completion, 'applied_unverified');
+});
+
+test('no-dialog, no-button and timeout never authorize imported=true', () => {
+	for (const status of ['no-dialog', 'no-button', 'button-disabled', 'close-timeout', 'probe-timeout', 'ambiguous', 'dismissed-before-click', 'dom-error'] as const) {
+		assert.equal(assessImportCompletion({ apiResult: true, confirmation: { ...closed, status, dialogClosed: false }, postcondition: 'verified' }).imported, false);
+	}
+});
+
+test('independent verified postcondition plus observed closure supports finite completion despite SDK timeout', () => {
+	const answer = assessImportCompletion({ apiResult: undefined, confirmation: closed, postcondition: 'verified' });
+	assert.equal(answer.imported, true); assert.equal(answer.completion, 'verified'); assert.equal(answer.apiResult, undefined);
+	assert.equal(assessImportCompletion({ apiResult: true, confirmation: closed, postcondition: 'not-verified' }).imported, false);
+});
+
+/** Source-bound structure from installed ui.js SHA 51dd88f0...7086ad.
+ * Registry id -> se/hEo root -> tagged header/span and body/Apply button.
+ * Offline structural fixture; not a captured native DOM or an EDA execution.
+ */
+function nativeFixture(title = 'Confirm Importing changes information', label = 'Apply Changes') {
+	const f = fixture(); f.modal.kind = 'other';
+	f.modal.attributes = { id: 'dlgShowImportChanges', class: 'lc_modal_RVdjQ', 'data-render': 'react', mask: 'true', esc: 'true' };
+	f.modal.children = [];
+	const box = f.modal.add(new ElementFixture('other')); box.attributes = { id: 'dlgShowImportChanges_dialog_box', class: 'lc_modal_dialog_box_5wCN6' };
+	const dialog = box.add(new ElementFixture('other')); dialog.attributes.class = 'lc_modal_dialog_zvEgQ';
+	const header = dialog.add(new ElementFixture('other')); header.attributes = { 'data-dialog-tagitem': 'lc_modal_dialog__header', class: 'lc_modal_dialog__header_HB6Bb' };
