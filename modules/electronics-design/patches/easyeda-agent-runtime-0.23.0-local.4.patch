+		await assert.rejects(pcbExportNetlist({ projectUuid: 'P', pcbUuid: 'B' }), /no file or an empty file/);
+		assert.equal(state.calls.length, 1);
+	}
+	const { state } = fixture(); state.fail = true;
+	await assert.rejects(pcbExportNetlist({ projectUuid: 'P', pcbUuid: 'B' }), (e: unknown) => {
+		assert.ok(e instanceof ActionError); assert.equal(e.detail, 'native netlist unavailable'); return true;
+	});
