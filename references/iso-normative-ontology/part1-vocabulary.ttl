@prefix isoN: <https://ontology-engineering.local/iso26262/normative#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


# Part 1 术语刻录（转述来源：本书附录 C；模态=Definition）

isoN:P1_T1 a isoN:TermDefinition ;
    isoN:clauseId "1-3.1" ; isoN:partNumber 1 ;
    rdfs:label "架构"@zh ; isoN:enLabel "architecture" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 9 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "相关项或元素的结构表示，能从中识别构造块、块的边界与接口，并包含需求到这些构造块的分配。注意它是“表示”（representation），不是实物本身；原词条说的是需求分配，不是“运行所需过程”。" .

isoN:P1_T2 a isoN:TermDefinition ;
    isoN:clauseId "1-3.2" ; isoN:partNumber 1 ;
    rdfs:label "ASIL 能力"@zh ; isoN:enLabel "ASIL capability" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 9 ; isoN:blockIndex 3 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "相关项或元素满足假设的、按给定 ASIL 分配的安全要求的能力。SEooC 的说法：“我按 D 的流程开发过”说的是能力，不是这次装车就自动合格。" .

isoN:P1_T3 a isoN:TermDefinition ;
    isoN:clauseId "1-3.3" ; isoN:partNumber 1 ;
    rdfs:label "ASIL 分解"@zh ; isoN:enLabel "ASIL decomposition" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 9 ; isoN:blockIndex 7 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "把冗余的安全要求分配到充分独立的多个元素上、服务于同一安全目标，从而降低各元素 ASIL 的做法。注意三个不可省略的限定：冗余、充分独立、同一安全目标——独立性证据不到位，分解就是自欺。" .

isoN:P1_T4 a isoN:TermDefinition ;
    isoN:clauseId "1-3.4" ; isoN:partNumber 1 ;
    rdfs:label "功能安全评估"@zh ; isoN:enLabel "assessment" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 9 ; isoN:blockIndex 13 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "对相关项或元素的特性是否达成 ISO 26262 目标的检查。对象是达成的功能安全本身；评审、审核、评估三者对象不同，不可互相顶替。" .

isoN:P1_T5 a isoN:TermDefinition ;
    isoN:clauseId "1-3.5" ; isoN:partNumber 1 ;
    rdfs:label "功能安全审核"@zh ; isoN:enLabel "audit" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 9 ; isoN:blockIndex 16 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "对已实施过程是否符合过程目标的检查。对象是过程。" .

isoN:P1_T6 a isoN:TermDefinition ;
    isoN:clauseId "1-3.6" ; isoN:partNumber 1 ;
    rdfs:label "汽车安全完整性等级"@zh ; isoN:enLabel "automotive safety integrity level, ASIL" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch04" ;
    isoN:pageIndex 9 ; isoN:blockIndex 19 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "四个等级（A 最低、D 最高）之一，用来规定相关项或元素为避免不合理风险而需适用的 ISO 26262 要求与安全措施。它把危害事件的风险分级连接到工程严谨度；原词条说的是 unreasonable risk，不是另造一个“不合理残余风险”术语。" .

isoN:P1_T8 a isoN:TermDefinition ;
    isoN:clauseId "1-3.8" ; isoN:partNumber 1 ;
    rdfs:label "基础失效率"@zh ; isoN:enLabel "base failure rate" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 9 ; isoN:blockIndex 27 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "给定应用工况下硬件元素的失效率，作为安全分析的输入。它是后续 SPFM/LFM/PMHF 计算链的最上游数字。" .

isoN:P1_T10 a isoN:TermDefinition ;
    isoN:clauseId "1-3.10" ; isoN:partNumber 1 ;
    rdfs:label "基线"@zh ; isoN:enLabel "baseline" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 10 ; isoN:blockIndex 5 ;
    isoN:taughtBy isoN:Case_cart_case ;
    isoN:zhGloss "经批准的一组工作产物、相关项或元素的版本，作为后续变更的基准。没有基线，变更管理就没有“变更前”可言。" .

isoN:P1_T13 a isoN:TermDefinition ;
    isoN:clauseId "1-3.13" ; isoN:partNumber 1 ;
    rdfs:label "分支覆盖率"@zh ; isoN:enLabel "branch coverage" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 10 ; isoN:blockIndex 21 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "测试中被执行的控制流分支百分比；100% 分支覆盖蕴含 100% 语句覆盖，反之不然。" .

isoN:P1_T15 a isoN:TermDefinition ;
    isoN:clauseId "1-3.15" ; isoN:partNumber 1 ;
    rdfs:label "标定数据"@zh ; isoN:enLabel "calibration data" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 10 ; isoN:blockIndex 30 ;
    isoN:taughtBy isoN:Case_single_factor ;
    isoN:zhGloss "软件构建完成后作为参数值写入的数据，如低怠速目标值、发动机特性曲线。改标定不改代码，但可能改安全行为。" .

isoN:P1_T16 a isoN:TermDefinition ;
    isoN:clauseId "1-3.16" ; isoN:partNumber 1 ;
    rdfs:label "候选者"@zh ; isoN:enLabel "candidate" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 11 ; isoN:blockIndex 1 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "定义和使用条件与已发布产品相同或高度一致的相关项/元素——它是“在用证明”论证的主角：想免做部分开发，先证明你是合格的候选者。" .

isoN:P1_T17 a isoN:TermDefinition ;
    isoN:clauseId "1-3.17" ; isoN:partNumber 1 ;
    rdfs:label "级联失效"@zh ; isoN:enLabel "cascading failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 11 ; isoN:blockIndex 5 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "某个相关项中的元素因内外部根因失效，进而引起同一相关项或不同相关项中的另一个或多个元素失效。A 推倒 B，关键是有传播方向，不限于同一相关项内部。" .

isoN:P1_T18 a isoN:TermDefinition ;
    isoN:clauseId "1-3.18" ; isoN:partNumber 1 ;
    rdfs:label "共因失效"@zh ; isoN:enLabel "common cause failure, CCF" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 11 ; isoN:blockIndex 10 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "两个及以上元素直接由同一个特定事件或根因导致的失效。同一电源掉电导致主备双双失效是标准例子；与级联的区别在于“同一根因直接打到多个元素”而非逐个传导。" .

isoN:P1_T19 a isoN:TermDefinition ;
    isoN:clauseId "1-3.19" ; isoN:partNumber 1 ;
    rdfs:label "共模失效"@zh ; isoN:enLabel "common mode failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 12 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "CCF 的特例：多个元素以相同方式失效；何种相似程度足以归为共模，要结合语境判断，并不要求失效表现完全相同。若两个传感器因同一批次缺陷这一共同根因而以相近方式漂移，可构成共模失效。" .

isoN:P1_T21 a isoN:TermDefinition ;
    isoN:clauseId "1-3.21" ; isoN:partNumber 1 ;
    rdfs:label "组件"@zh ; isoN:enLabel "component" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 12 ; isoN:blockIndex 12 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "非系统级、逻辑上或技术上可分离的元素，由多个硬件部件，或由一个及以上软件单元组成。硬件分支与软件分支的数量门槛不同，不要误读成两边都必须有多个。" .

isoN:P1_T22 a isoN:TermDefinition ;
    isoN:clauseId "1-3.22" ; isoN:partNumber 1 ;
    rdfs:label "配置数据"@zh ; isoN:enLabel "configuration data" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 12 ; isoN:blockIndex 17 ;
    isoN:taughtBy isoN:Case_single_factor ;
    isoN:zhGloss "在元素构建阶段赋值、控制构建过程本身的数据，如预处理器变量。与标定数据的分界在于作用时机：一个管“怎么构建”，一个管“构建完怎么调”。" .

isoN:P1_T23 a isoN:TermDefinition ;
    isoN:clauseId "1-3.23" ; isoN:partNumber 1 ;
    rdfs:label "确认措施"@zh ; isoN:enLabel "confirmation measure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 12 ; isoN:blockIndex 24 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "针对功能安全的确认评审、审核或评估的统称。执行人的独立性等级（I0–I3）随 ASIL 升高，首讲章有完整矩阵。" .

isoN:P1_T24 a isoN:TermDefinition ;
    isoN:clauseId "1-3.24" ; isoN:partNumber 1 ;
    rdfs:label "确认评审"@zh ; isoN:enLabel "confirmation review" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 12 ; isoN:blockIndex 27 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "确认某工作产物为达成功能安全提供了充分且有说服力的证据。对象是工作产物。" .

isoN:P1_T25 a isoN:TermDefinition ;
    isoN:clauseId "1-3.25" ; isoN:partNumber 1 ;
    rdfs:label "可控性"@zh ; isoN:enLabel "controllability, C" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 13 ; isoN:blockIndex 1 ;
    isoN:taughtBy isoN:Case_three_rulers ;
    isoN:zhGloss "相关人员通过及时反应（可能借助外部措施）避免特定伤害或损失的能力。相关人员可包括驾驶员、乘员或车辆外部附近人员；在具体 HARA 场景中应识别真正涉事的人，不能把定义直接缩成“典型驾驶员”。" .

isoN:P1_T26 a isoN:TermDefinition ;
    isoN:clauseId "1-3.26" ; isoN:partNumber 1 ;
    rdfs:label "耦合因素"@zh ; isoN:enLabel "coupling factors" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 13 ; isoN:blockIndex 6 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "导致多个元素失效相关联的共同特征或关系，如同一供电、同一位置、同一开发团队。DFA 可以按已声明的分析边界和耦合因素分类，系统搜索可信的相关失效路径；清单不自动代表搜索穷尽。" .

isoN:P1_T27 a isoN:TermDefinition ;
    isoN:clauseId "1-3.27" ; isoN:partNumber 1 ;
    rdfs:label "专用措施"@zh ; isoN:enLabel "dedicated measure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 13 ; isoN:blockIndex 9 ;
    isoN:taughtBy isoN:Case_goal_inherit ;
    isoN:zhGloss "确保安全目标违背概率评估中所声称失效率成立的措施，如设计特性、专项样本测试、老化筛选。声称 λ 有多低，就要有对应的专用措施撑住。" .

isoN:P1_T28 a isoN:TermDefinition ;
    isoN:clauseId "1-3.28" ; isoN:partNumber 1 ;
    rdfs:label "降级"@zh ; isoN:enLabel "degradation" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 13 ; isoN:blockIndex 13 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "相关项或元素功能或性能降低的状态或向该状态的过渡。限速跛行回家是典型降级。" .

isoN:P1_T29 a isoN:TermDefinition ;
    isoN:clauseId "1-3.29" ; isoN:partNumber 1 ;
    rdfs:label "相关失效"@zh ; isoN:enLabel "dependent failures" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 13 ; isoN:blockIndex 16 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "统计上不独立的多个失效：组合发生的概率不等于各自概率的简单乘积。冗余的算术全建立在独立假设上，相关失效就是拆这个台的。" .

isoN:P1_T30 a isoN:TermDefinition ;
    isoN:clauseId "1-3.30" ; isoN:partNumber 1 ;
    rdfs:label "相关失效引发点"@zh ; isoN:enLabel "dependent failure initiator, DFI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 13 ; isoN:blockIndex 24 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "通过耦合因素让多个元素失效的单一根因。DFA 应在声明边界内识别可信的 DFI 候选及所影响元素，并记录消除、控制或接受理由；不能从“已列清单”推出所有发起者已被找到或挡住。" .

isoN:P1_T31 a isoN:TermDefinition ;
    isoN:clauseId "1-3.31" ; isoN:partNumber 1 ;
    rdfs:label "被检出故障"@zh ; isoN:enLabel "detected fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 14 ; isoN:blockIndex 2 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "在规定时间内被安全机制检出的故障。“规定时间”通常就是时间群里的故障检测时间间隔。" .

isoN:P1_T32 a isoN:TermDefinition ;
    isoN:clauseId "1-3.32" ; isoN:partNumber 1 ;
    rdfs:label "开发接口协议"@zh ; isoN:enLabel "development interface agreement, DIA" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 14 ; isoN:blockIndex 6 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "客户与供应商之间的协议，规定分布式开发中双方各自负责执行的活动、评审的证据与交换的工作产物。安全责任在供应链上的“分界合同”。" .

isoN:P1_T33 a isoN:TermDefinition ;
    isoN:clauseId "1-3.33" ; isoN:partNumber 1 ;
    rdfs:label "诊断覆盖率"@zh ; isoN:enLabel "diagnostic coverage, DC" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 14 ; isoN:blockIndex 11 ;
    isoN:taughtBy isoN:Case_fit_400 ;
    isoN:zhGloss "硬件元素失效率中被安全机制检出或控制的百分比。它是把“装了诊断”翻译成数字的桥梁。" .

isoN:P1_T34 a isoN:TermDefinition ;
    isoN:clauseId "1-3.34" ; isoN:partNumber 1 ;
    rdfs:label "诊断点"@zh ; isoN:enLabel "diagnostic points" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 14 ; isoN:blockIndex 18 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "观察到故障被检测或纠正的元素输出信号。" .

isoN:P1_T35 a isoN:TermDefinition ;
    isoN:clauseId "1-3.35" ; isoN:partNumber 1 ;
    rdfs:label "诊断测试时间间隔"@zh ; isoN:enLabel "diagnostic test time interval, DTTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 14 ; isoN:blockIndex 23 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "安全机制两次在线诊断测试执行之间的时间，且包含一次在线诊断测试的执行时长。它描述诊断执行间隔；允许的周期或上限要由具体诊断设计、FDTI/FTTI 分配和安全要求论证，不能从 DTTI 词条单独推出。" .

isoN:P1_T36 a isoN:TermDefinition ;
    isoN:clauseId "1-3.36" ; isoN:partNumber 1 ;
    rdfs:label "分布式开发"@zh ; isoN:enLabel "distributed development" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 14 ; isoN:blockIndex 27 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "相关项或元素的开发责任在客户与供应商之间划分的开发形态。DIA 因它而生。" .

isoN:P1_T37 a isoN:TermDefinition ;
    isoN:clauseId "1-3.37" ; isoN:partNumber 1 ;
    rdfs:label "多样性"@zh ; isoN:enLabel "diversity" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 15 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_power_tree ;
    isoN:zhGloss "用不同的方案满足同一需求、以谋求独立性的做法。词条注记提醒：多样性不保证不发生共因失效，只是降低其可能。" .

isoN:P1_T39 a isoN:TermDefinition ;
    isoN:clauseId "1-3.39" ; isoN:partNumber 1 ;
    rdfs:label "双点故障/双点失效"@zh ; isoN:enLabel "dual-point fault / dual-point failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 15 ; isoN:blockIndex 12 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "需要与另一个独立故障组合才导致违背安全目标的单个故障，及两个独立故障组合直接导致的失效。“被监控功能坏了 + 监控它的机制也坏了”是一个用来解释该概念的典型组合，不代表频率排名。" .

isoN:P1_T40 a isoN:TermDefinition ;
    isoN:clauseId "1-3.40" ; isoN:partNumber 1 ;
    rdfs:label "电气/电子系统"@zh ; isoN:enLabel "electrical and/or electronic system, E/E 系统" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 15 ; isoN:blockIndex 17 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "由电气或电子元素构成的系统，包括可编程电子元素。ISO 26262 的适用范围就圈在 E/E 系统的功能异常上。" .

isoN:P1_T41 a isoN:TermDefinition ;
    isoN:clauseId "1-3.41" ; isoN:partNumber 1 ;
    rdfs:label "元素"@zh ; isoN:enLabel "element" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 15 ; isoN:blockIndex 23 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "系统、组件（硬件或软件）、硬件部件或软件单元的统称。当一句话想同时覆盖各分解层级时就用它；说“软件元素”时指软件组件或软件单元。" .

isoN:P1_T42 a isoN:TermDefinition ;
    isoN:clauseId "1-3.42" ; isoN:partNumber 1 ;
    rdfs:label "嵌入式软件"@zh ; isoN:enLabel "embedded software" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 15 ; isoN:blockIndex 28 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "完成集成、将在处理单元上执行的软件整体。Part 6 末段的“嵌入式软件测试”测的就是这个集成后的整体，而非某个单元。" .

isoN:P1_T43 a isoN:TermDefinition ;
    isoN:clauseId "1-3.43" ; isoN:partNumber 1 ;
    rdfs:label "应急运行"@zh ; isoN:enLabel "emergency operation" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 16 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_safe_state ;
    isoN:zhGloss "故障反应之后、过渡到安全状态之前，为维持安全而设的相关项运行模式。直接断电不安全的系统（如行驶中的转向助力）需要这段“降级续命”。" .

isoN:P1_T44 a isoN:TermDefinition ;
    isoN:clauseId "1-3.44" ; isoN:partNumber 1 ;
    rdfs:label "应急运行时间间隔"@zh ; isoN:enLabel "emergency operation time interval, EOTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch05" ;
    isoN:pageIndex 16 ; isoN:blockIndex 8 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "应急运行实际维持的时间段。" .

isoN:P1_T45 a isoN:TermDefinition ;
    isoN:clauseId "1-3.45" ; isoN:partNumber 1 ;
    rdfs:label "应急运行容忍时间间隔"@zh ; isoN:enLabel "emergency operation tolerance time interval, EOTTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch05" ;
    isoN:pageIndex 16 ; isoN:blockIndex 14 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "应急运行在不产生不合理风险的前提下可以维持的规定时长。EOTI 必须收敛在 EOTTI 之内；一对“实际用时 vs 容忍上限”的关系，与 FHTI/FTTI 同构。" .

isoN:P1_T46 a isoN:TermDefinition ;
    isoN:clauseId "1-3.46" ; isoN:partNumber 1 ;
    rdfs:label "错误"@zh ; isoN:enLabel "error" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 17 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "计算、观测或测量出的值/状态，与真实、规定或理论正确的值/状态之间的偏差。它是故障被激活后的中间形态。" .

isoN:P1_T47 a isoN:TermDefinition ;
    isoN:clauseId "1-3.47" ; isoN:partNumber 1 ;
    rdfs:label "专家骑手"@zh ; isoN:enLabel "expert rider" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 17 ; isoN:blockIndex 4 ;
    isoN:taughtBy isoN:Case_three_rulers ;
    isoN:zhGloss "摩托车领域中有能力基于实车操作评估可控性分级的角色。Part 12 用它校准摩托车的 C 参数。" .

isoN:P1_T48 a isoN:TermDefinition ;
    isoN:clauseId "1-3.48" ; isoN:partNumber 1 ;
    rdfs:label "暴露"@zh ; isoN:enLabel "exposure, E" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 17 ; isoN:blockIndex 12 ;
    isoN:taughtBy isoN:Case_three_rulers ;
    isoN:zhGloss "处于某个运行场景中的状态，该场景若与被分析的失效模式同时出现则可能有危害。E 参数评估的是场景出现的可能性（正文因此把这项判断称作“暴露概率”），不是失效的可能性——这是本附录要重点辨析的区别。" .

isoN:P1_T49 a isoN:TermDefinition ;
    isoN:clauseId "1-3.49" ; isoN:partNumber 1 ;
    rdfs:label "外部措施"@zh ; isoN:enLabel "external measure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 17 ; isoN:blockIndex 16 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "独立于相关项之外、能降低或缓解相关项风险的措施，如道路护栏。HARA 打分时它能救 C 参数一命，但不算相关项自己的安全机制。" .

isoN:P1_T50 a isoN:TermDefinition ;
    isoN:clauseId "1-3.50" ; isoN:partNumber 1 ;
    rdfs:label "失效"@zh ; isoN:enLabel "failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 17 ; isoN:blockIndex 19 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "由于故障显现，元素或相关项的预期行为终止。三个词按“状态→偏差→行为终止”排队，不可混用。" .

isoN:P1_T51 a isoN:TermDefinition ;
    isoN:clauseId "1-3.51" ; isoN:partNumber 1 ;
    rdfs:label "失效模式"@zh ; isoN:enLabel "failure mode" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 17 ; isoN:blockIndex 23 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "元素或相关项未能提供预期行为的方式。同一个元件可以有多种失效模式（断路、短路、漂移），安全分析按模式逐个记账。" .

isoN:P1_T52 a isoN:TermDefinition ;
    isoN:clauseId "1-3.52" ; isoN:partNumber 1 ;
    rdfs:label "失效模式覆盖率"@zh ; isoN:enLabel "failure mode coverage" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 17 ; isoN:blockIndex 26 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "某失效模式的失效率中被安全机制检出或控制的比例。DC 按元素记总账，它按失效模式记明细账。" .

isoN:P1_T53 a isoN:TermDefinition ;
    isoN:clauseId "1-3.53" ; isoN:partNumber 1 ;
    rdfs:label "失效率"@zh ; isoN:enLabel "failure rate, λ" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 17 ; isoN:blockIndex 30 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "失效概率密度除以存活概率，硬件可靠性记账的基本量，通常在使用寿命内假设为常数。" .

isoN:P1_T54 a isoN:TermDefinition ;
    isoN:clauseId "1-3.54" ; isoN:partNumber 1 ;
    rdfs:label "故障"@zh ; isoN:enLabel "fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 18 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "可能导致元素或相关项失效的异常状态。它是因果链的起点：故障可以潜伏很久而不发作。" .

isoN:P1_T55 a isoN:TermDefinition ;
    isoN:clauseId "1-3.55" ; isoN:partNumber 1 ;
    rdfs:label "故障检测时间间隔"@zh ; isoN:enLabel "fault detection time interval, FDTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 18 ; isoN:blockIndex 6 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "从故障发生到被检出的时间。" .

isoN:P1_T56 a isoN:TermDefinition ;
    isoN:clauseId "1-3.56" ; isoN:partNumber 1 ;
    rdfs:label "故障处理时间间隔"@zh ; isoN:enLabel "fault handling time interval, FHTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch05" ;
    isoN:pageIndex 18 ; isoN:blockIndex 15 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "FDTI 与 FRTI 之和，即安全机制从故障发生到完成反应的用时。Part 1 对 FDTI 的 Note 4 说明：若 FDTI + FRTI 小于相关 FTTI，则相应安全机制及时覆盖该故障；这是资料性的术语说明，项目义务仍须追到适用的规范性条款和安全要求。" .

isoN:P1_T57 a isoN:TermDefinition ;
    isoN:clauseId "1-3.57" ; isoN:partNumber 1 ;
    rdfs:label "故障注入"@zh ; isoN:enLabel "fault injection" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 18 ; isoN:blockIndex 21 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "向元素中插入故障、错误或失效，观察其反应以评估故障影响的方法。它是方法表里的常客：单元、集成、整车各层都有它的行。" .

isoN:P1_T58 a isoN:TermDefinition ;
    isoN:clauseId "1-3.58" ; isoN:partNumber 1 ;
    rdfs:label "故障模型"@zh ; isoN:enLabel "fault model" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 19 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "由故障导出失效模式的表示方法，用来评估特定故障的后果，如 stuck-at 模型。" .

isoN:P1_T59 a isoN:TermDefinition ;
    isoN:clauseId "1-3.59" ; isoN:partNumber 1 ;
    rdfs:label "故障反应时间间隔"@zh ; isoN:enLabel "fault reaction time interval, FRTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 19 ; isoN:blockIndex 4 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "从故障被检出到达到安全状态或进入应急运行的时间。" .

isoN:P1_T60 a isoN:TermDefinition ;
    isoN:clauseId "1-3.60" ; isoN:partNumber 1 ;
    rdfs:label "故障容忍"@zh ; isoN:enLabel "fault tolerance" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "在一个或多个规定故障存在的情况下，仍能交付规定功能的能力。冗余架构买的就是这个能力。" .

isoN:P1_T61 a isoN:TermDefinition ;
    isoN:clauseId "1-3.61" ; isoN:partNumber 1 ;
    rdfs:label "故障容忍时间间隔"@zh ; isoN:enLabel "fault tolerant time interval, FTTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch05" ;
    isoN:pageIndex 19 ; isoN:blockIndex 13 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "在安全机制未激活的情况下，从故障在相关项中发生到可能出现危害事件的最短时间。它是留给所有防线的总预算，属于相关项。" .

isoN:P1_T62 a isoN:TermDefinition ;
    isoN:clauseId "1-3.62" ; isoN:partNumber 1 ;
    rdfs:label "现场数据"@zh ; isoN:enLabel "field data" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 20 ; isoN:blockIndex 1 ;
    isoN:taughtBy isoN:Case_lot_recall ;
    isoN:zhGloss "相关项或元素使用中获得的数据，含累计运行小时、全部失效与在役安全异常。在用证明的原料。" .

isoN:P1_T63 a isoN:TermDefinition ;
    isoN:clauseId "1-3.63" ; isoN:partNumber 1 ;
    rdfs:label "形式化/半形式化/非形式化表示法"@zh ; isoN:enLabel "formal / semi-formal / informal notation" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 20 ; isoN:blockIndex 5 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "按语法和语义的定义完备程度递减的三档描述技术：形式化两者皆完备（如模型检查器输入语言）；半形式化语法完备、语义可不完备（如 UML 子集）；非形式化连语法都不完备（如自然语言配图）。方法表按 ASIL 调节三档的推荐度。" .

isoN:P1_T64 a isoN:TermDefinition ;
    isoN:clauseId "1-3.64" ; isoN:partNumber 1 ;
    rdfs:label "形式化/半形式化验证"@zh ; isoN:enLabel "formal / semi-formal verification" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 20 ; isoN:blockIndex 9 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "形式化验证使用形式化表示法，证明相关项或元素相对于其功能或属性规格的正确性；半形式化验证则基于半形式化表示法给出的描述实施验证，例如用半形式化模型生成测试向量并检查系统行为。两者首先区分的是表示法与方法依据，不能脱离具体方法和验证对象，把差异一概简化成“证明”与“检查”的证据等级。" .

isoN:P1_T65 a isoN:TermDefinition ;
    isoN:clauseId "1-3.65" ; isoN:partNumber 1 ;
    rdfs:label "免于干扰"@zh ; isoN:enLabel "freedom from interference, FFI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07,ch08" ;
    isoN:pageIndex 20 ; isoN:blockIndex 12 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "两个及以上元素之间不存在会导致违背安全要求的级联失效。软件分区要证明的就是它：QM 分区不得拖垮 ASIL 分区。" .

isoN:P1_T66 a isoN:TermDefinition ;
    isoN:clauseId "1-3.66" ; isoN:partNumber 1 ;
    rdfs:label "功能概念"@zh ; isoN:enLabel "functional concept" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 21 ; isoN:blockIndex 1 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "为达成期望行为而对预期功能及其交互的规格说明。它是 HARA 的输入：先说清车要干什么，才能问会怎么出事。" .

isoN:P1_T67 a isoN:TermDefinition ;
    isoN:clauseId "1-3.67" ; isoN:partNumber 1 ;
    rdfs:label "功能安全"@zh ; isoN:enLabel "functional safety" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 21 ; isoN:blockIndex 5 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "不存在由 E/E 系统功能异常表现引起的危害所导致的不合理风险。三个限定词划定了整本书的边界：对象是 E/E 系统的功能异常及其危害，目标是不存在不合理风险，不是宣称把风险消除为零。" .

isoN:P1_T68 a isoN:TermDefinition ;
    isoN:clauseId "1-3.68" ; isoN:partNumber 1 ;
    rdfs:label "功能安全概念"@zh ; isoN:enLabel "functional safety concept, FSC" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 21 ; isoN:blockIndex 8 ;
    isoN:taughtBy isoN:Case_goal_inherit ;
    isoN:zhGloss "功能安全要求的规格说明及其到相关项架构元素的分配。它回答“用什么策略兑现安全目标”。" .

isoN:P1_T69 a isoN:TermDefinition ;
    isoN:clauseId "1-3.69" ; isoN:partNumber 1 ;
    rdfs:label "功能安全要求"@zh ; isoN:enLabel "functional safety requirement, FSR" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 21 ; isoN:blockIndex 11 ;
    isoN:taughtBy isoN:Case_goal_inherit ;
    isoN:zhGloss "与实现无关的安全行为或安全措施的规格说明。判据就在“implementation-independent”这一个词上：说了“用哪种传感器”就已经不是 FSR。" .

isoN:P1_T70 a isoN:TermDefinition ;
    isoN:clauseId "1-3.70" ; isoN:partNumber 1 ;
    rdfs:label "硬件架构度量"@zh ; isoN:enLabel "hardware architectural metrics" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 21 ; isoN:blockIndex 17 ;
    isoN:taughtBy isoN:Case_fit_400 ;
    isoN:zhGloss "评价硬件架构对安全的有效性的度量，即 SPFM 与 LFM 的统称。" .

isoN:P1_T71 a isoN:TermDefinition ;
    isoN:clauseId "1-3.71" ; isoN:partNumber 1 ;
    rdfs:label "硬件部件"@zh ; isoN:enLabel "hardware part" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 21 ; isoN:blockIndex 21 ;
    isoN:taughtBy isoN:Case_fit_400 ;
    isoN:zhGloss "硬件组件第一层分解出来的部分，如微控制器里的 CPU、一只电阻、一片闪存阵列。" .

isoN:P1_T72 a isoN:TermDefinition ;
    isoN:clauseId "1-3.72" ; isoN:partNumber 1 ;
    rdfs:label "硬件基本子部件"@zh ; isoN:enLabel "hardware elementary subpart" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 21 ; isoN:blockIndex 25 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "安全分析中考虑的最小硬件颗粒，如带逻辑锥的触发器、一个寄存器。硬件度量的分母就数到这一层为止。" .

isoN:P1_T73 a isoN:TermDefinition ;
    isoN:clauseId "1-3.73" ; isoN:partNumber 1 ;
    rdfs:label "硬件子部件"@zh ; isoN:enLabel "hardware subpart" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 21 ; isoN:blockIndex 29 ;
    isoN:taughtBy isoN:Case_fit_400 ;
    isoN:zhGloss "硬件部件再往下逻辑划分的第二层及更深层，如微控制器 CPU 里的 ALU。" .

isoN:P1_T74 a isoN:TermDefinition ;
    isoN:clauseId "1-3.74" ; isoN:partNumber 1 ;
    rdfs:label "伤害"@zh ; isoN:enLabel "harm" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 22 ; isoN:blockIndex 0 ;
    isoN:zhGloss "对人的身体损伤或健康损害。注意对象只有人：撞坏护栏本身不算 harm。" .

isoN:P1_T75 a isoN:TermDefinition ;
    isoN:clauseId "1-3.75" ; isoN:partNumber 1 ;
    rdfs:label "危害"@zh ; isoN:enLabel "hazard" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 22 ; isoN:blockIndex 3 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "由相关项功能异常表现引起的潜在伤害来源。它是“可能性”而非“事件”：非预期的转向助力是危害，撞车才是事故。" .

isoN:P1_T76 a isoN:TermDefinition ;
    isoN:clauseId "1-3.76" ; isoN:partNumber 1 ;
    rdfs:label "危害分析与风险评估"@zh ; isoN:enLabel "hazard analysis and risk assessment, HARA" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 22 ; isoN:blockIndex 7 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "识别并分级相关项的危害事件、进而制定安全目标及其 ASIL 的方法。它是概念阶段的发动机。" .

isoN:P1_T77 a isoN:TermDefinition ;
    isoN:clauseId "1-3.77" ; isoN:partNumber 1 ;
    rdfs:label "危害事件"@zh ; isoN:enLabel "hazardous event" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 22 ; isoN:blockIndex 11 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "危害与运行场景的组合。同一个危害配上不同场景，严重度和可控性都可能不同——这是 HARA 按事件而非按危害逐行打分的原因。" .

isoN:P1_T78 a isoN:TermDefinition ;
    isoN:clauseId "1-3.78" ; isoN:partNumber 1 ;
    rdfs:label "独立性"@zh ; isoN:enLabel "independence" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03,ch08" ;
    isoN:pageIndex 22 ; isoN:blockIndex 14 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "两重含义：元素之间不存在会违背安全要求的相关失效；或组织之间不存在利益冲突。ASIL 分解的前提、确认措施的资格，用的都是这个词。" .

isoN:P1_T79 a isoN:TermDefinition ;
    isoN:clauseId "1-3.79" ; isoN:partNumber 1 ;
    rdfs:label "独立失效"@zh ; isoN:enLabel "independent failures" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 22 ; isoN:blockIndex 18 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "同时或相继发生的概率恰好等于各自无条件概率乘积的失效。它是相关失效的对照组，也是概率计算的前提假设。" .

isoN:P1_T81 a isoN:TermDefinition ;
    isoN:clauseId "1-3.81" ; isoN:partNumber 1 ;
    rdfs:label "继承"@zh ; isoN:enLabel "inheritance" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 22 ; isoN:blockIndex 26 ;
    isoN:taughtBy isoN:Case_goal_inherit ;
    isoN:zhGloss "开发过程中把需求属性原封不动传递到下一细化层级。ASIL 沿需求链往下传，默认走的就是继承，除非启动 ASIL 分解。" .

isoN:P1_T82 a isoN:TermDefinition ;
    isoN:clauseId "1-3.82" ; isoN:partNumber 1 ;
    rdfs:label "审查"@zh ; isoN:enLabel "inspection" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 22 ; isoN:blockIndex 29 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "遵循正式规程检查工作产物以检出安全异常。与走查同为验证手段，区别在正式程度：审查有规程、角色和进出条件。" .

isoN:P1_T83 a isoN:TermDefinition ;
    isoN:clauseId "1-3.83" ; isoN:partNumber 1 ;
    rdfs:label "预期功能"@zh ; isoN:enLabel "intended functionality" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 23 ; isoN:blockIndex 0 ;
    isoN:zhGloss "为相关项规定的行为，不含安全机制；规定的行为在整车层面描述。安全机制是为守护预期功能加上的，不算进预期功能本身。" .

isoN:P1_T84 a isoN:TermDefinition ;
    isoN:clauseId "1-3.84" ; isoN:partNumber 1 ;
    rdfs:label "相关项"@zh ; isoN:enLabel "item" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 23 ; isoN:blockIndex 4 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "在整车层面实现某个功能（或功能的一部分）、被 ISO 26262 当作记账单位的那个系统或系统组合。边界划到哪里，安全责任就算到哪里；HARA、安全目标、安全档案全都以它为单位展开。" .

isoN:P1_T85 a isoN:TermDefinition ;
    isoN:clauseId "1-3.85" ; isoN:partNumber 1 ;
    rdfs:label "潜伏故障"@zh ; isoN:enLabel "latent fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 23 ; isoN:blockIndex 8 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "在多点故障检测时间间隔内，既没被安全机制检出、也没被驾驶员感知的多点故障。它是 LFM 的分子对象：机制自己坏了而未被发现，是一个典型的教学例。" .

isoN:P1_T86 a isoN:TermDefinition ;
    isoN:clauseId "1-3.86" ; isoN:partNumber 1 ;
    rdfs:label "安全生命周期"@zh ; isoN:enLabel "lifecycle" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 23 ; isoN:blockIndex 11 ;
    isoN:zhGloss "相关项从概念到退役的全部阶段。" .

isoN:P1_T87 a isoN:TermDefinition ;
    isoN:clauseId "1-3.87" ; isoN:partNumber 1 ;
    rdfs:label "管理体系"@zh ; isoN:enLabel "management system" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 23 ; isoN:blockIndex 14 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "组织为达成目标所用的方针、程序与过程的总称。" .

isoN:P1_T88 a isoN:TermDefinition ;
    isoN:clauseId "1-3.88" ; isoN:partNumber 1 ;
    rdfs:label "功能异常表现"@zh ; isoN:enLabel "malfunctioning behaviour" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 23 ; isoN:blockIndex 17 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "相关项相对设计意图的失效或非预期行为。它比失效更宽：行为没终止但偏离了意图，也算。功能安全定义里点名的正是它。" .

isoN:P1_T89 a isoN:TermDefinition ;
    isoN:clauseId "1-3.89" ; isoN:partNumber 1 ;
    rdfs:label "最大修复时间间隔"@zh ; isoN:enLabel "maximum time to repair time interval" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 23 ; isoN:blockIndex 20 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "安全状态可以维持的规定时长；当安全状态需要靠维修才能退出时，这个窗口决定了“多久内必须修好”。" .

isoN:P1_T90 a isoN:TermDefinition ;
    isoN:clauseId "1-3.90" ; isoN:partNumber 1 ;
    rdfs:label "基于模型的开发"@zh ; isoN:enLabel "model-based development" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 23 ; isoN:blockIndex 26 ;
    isoN:zhGloss "用模型描述待开发元素行为或属性的开发方式。模型可以生成代码，也因此把工具链的置信度问题（Part 8）带进了软件章。" .

isoN:P1_T92 a isoN:TermDefinition ;
    isoN:clauseId "1-3.92" ; isoN:partNumber 1 ;
    rdfs:label "修正条件/判定覆盖率"@zh ; isoN:enLabel "modified condition/decision coverage, MC/DC" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 24 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "独立影响判定结果的单个条件取值被演练到的百分比，三档中最强，Part 6 Table 9 只对 ASIL D 给 ++。" .

isoN:P1_T94 a isoN:TermDefinition ;
    isoN:clauseId "1-3.94" ; isoN:partNumber 1 ;
    rdfs:label "摩托车安全完整性等级"@zh ; isoN:enLabel "motorcycle safety integrity level, MSIL" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 24 ; isoN:blockIndex 8 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "摩托车领域的四级风险降低等级，需按 Part 12 规则换算为 ASIL 后再套用各部要求。同名不同域，不可直接混用。" .

isoN:P1_T95 a isoN:TermDefinition ;
    isoN:clauseId "1-3.95" ; isoN:partNumber 1 ;
    rdfs:label "多核"@zh ; isoN:enLabel "multi-core" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 24 ; isoN:blockIndex 12 ;
    isoN:zhGloss "含两个及以上可相互独立运行的处理单元的硬件组件。“可独立运行”是它进入 DFA 议题的原因。" .

isoN:P1_T97 a isoN:TermDefinition ;
    isoN:clauseId "1-3.97" ; isoN:partNumber 1 ;
    rdfs:label "多点故障/多点失效"@zh ; isoN:enLabel "multiple-point fault / multiple-point failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 24 ; isoN:blockIndex 18 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "推广到 n 个独立故障组合的版本。若未被检测、未被感知，多点故障就在系统里潜伏着等队友。" .

isoN:P1_T98 a isoN:TermDefinition ;
    isoN:clauseId "1-3.98" ; isoN:partNumber 1 ;
    rdfs:label "多点故障检测时间间隔"@zh ; isoN:enLabel "multiple-point fault detection time interval, MPFDTI" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 24 ; isoN:blockIndex 22 ;
    isoN:taughtBy isoN:Case_four_100ms ;
    isoN:zhGloss "在多点故障可能凑成多点失效之前将其检出的时间窗。潜伏故障的定义就以它为限。" .

isoN:P1_T100 a isoN:TermDefinition ;
    isoN:clauseId "1-3.100" ; isoN:partNumber 1 ;
    rdfs:label "非功能性危害"@zh ; isoN:enLabel "non-functional hazard" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 24 ; isoN:blockIndex 28 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "由 E/E 功能异常之外的因素（如电击、火灾、毒性）引起的危害。ISO 26262 明确不管它们，划界时要说得出去哪儿管。" .

isoN:P1_T101 a isoN:TermDefinition ;
    isoN:clauseId "1-3.101" ; isoN:partNumber 1 ;
    rdfs:label "观测点"@zh ; isoN:enLabel "observation points" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 24 ; isoN:blockIndex 31 ;
    isoN:zhGloss "观察到故障潜在影响的元素输出信号，如存储器的输出。诊断点看“抓没抓住”，观测点看“有没有影响”。" .

isoN:P1_T102 a isoN:TermDefinition ;
    isoN:clauseId "1-3.102" ; isoN:partNumber 1 ;
    rdfs:label "运行模式"@zh ; isoN:enLabel "operating mode" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 25 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_safe_state ;
    isoN:zhGloss "相关项或元素因使用而处的功能状态，如系统关闭、正常运行、降级运行。" .

isoN:P1_T103 a isoN:TermDefinition ;
    isoN:clauseId "1-3.103" ; isoN:partNumber 1 ;
    rdfs:label "运行时间"@zh ; isoN:enLabel "operating time" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 25 ; isoN:blockIndex 4 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "相关项或元素处于工作状态的累计时间，含降级模式。PMHF 按每小时记账，分母就是它。" .

isoN:P1_T104 a isoN:TermDefinition ;
    isoN:clauseId "1-3.104" ; isoN:partNumber 1 ;
    rdfs:label "运行场景"@zh ; isoN:enLabel "operational situation" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 25 ; isoN:blockIndex 7 ;
    isoN:taughtBy isoN:Case_context_split ;
    isoN:zhGloss "车辆生命期内可能出现的场景，如高速行驶、坡道停车、维修。它是 E 参数的评估对象。" .

isoN:P1_T105 a isoN:TermDefinition ;
    isoN:clauseId "1-3.105" ; isoN:partNumber 1 ;
    rdfs:label "其它技术"@zh ; isoN:enLabel "other technology" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 25 ; isoN:blockIndex 11 ;
    isoN:zhGloss "E/E 之外的技术，如机械、液压。标准不管它们的开发，但安全机制可以借助它们实现。" .

isoN:P1_T106 a isoN:TermDefinition ;
    isoN:clauseId "1-3.106" ; isoN:partNumber 1 ;
    rdfs:label "分区"@zh ; isoN:enLabel "partitioning" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07,ch08" ;
    isoN:pageIndex 25 ; isoN:blockIndex 16 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "为实现某种设计而对功能或元素做的分隔；可用于故障遏制，避免级联失效，是免于干扰的常用手段。" .

isoN:P1_T108 a isoN:TermDefinition ;
    isoN:clauseId "1-3.108" ; isoN:partNumber 1 ;
    rdfs:label "被感知故障"@zh ; isoN:enLabel "perceived fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 25 ; isoN:blockIndex 23 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "通过整车层面的行为偏差被间接察觉的故障，如方向盘变沉。项目若要用驾驶员感知支持故障分类，应说明在所主张的场景中行为偏差可被感知、代表性人员能识别并作出响应，且感知和响应时间满足相关 MPFDTI、FTTI 或其他已规定时间窗口。它也可影响诊断、HMI、警告与服务策略的假设；词条本身不使这些假设自动成立。" .

isoN:P1_T109 a isoN:TermDefinition ;
    isoN:clauseId "1-3.109" ; isoN:partNumber 1 ;
    rdfs:label "永久故障"@zh ; isoN:enLabel "permanent fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 25 ; isoN:blockIndex 26 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "发生后一直存在、直到移除或修复的故障，如 stuck-at、桥接。" .

isoN:P1_T110 a isoN:TermDefinition ;
    isoN:clauseId "1-3.110" ; isoN:partNumber 1 ;
    rdfs:label "阶段"@zh ; isoN:enLabel "phase" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 25 ; isoN:blockIndex 30 ;
    isoN:zhGloss "安全生命周期中由 Part 3–7 规定的阶段，如概念阶段、系统层开发。" .

isoN:P1_T113 a isoN:TermDefinition ;
    isoN:clauseId "1-3.113" ; isoN:partNumber 1 ;
    rdfs:label "处理单元"@zh ; isoN:enLabel "processing element" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 26 ; isoN:blockIndex 14 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "提供数据处理功能的硬件部件，通常含寄存器组、执行单元和控制单元。多核、半导体讨论的基本单位。" .

isoN:P1_T114 a isoN:TermDefinition ;
    isoN:clauseId "1-3.114" ; isoN:partNumber 1 ;
    rdfs:label "可编程逻辑器件"@zh ; isoN:enLabel "programmable logic device, PLD" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 26 ; isoN:blockIndex 20 ;
    isoN:zhGloss "出厂时电路功能未定义、在集成阶段才配置的硬件组件或部件，如 FPGA。" .

isoN:P1_T115 a isoN:TermDefinition ;
    isoN:clauseId "1-3.115" ; isoN:partNumber 1 ;
    rdfs:label "在用证明论证/在用证明信用"@zh ; isoN:enLabel "proven in use argument / proven in use credit, PiU" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09,ch10" ;
    isoN:pageIndex 26 ; isoN:blockIndex 24 ;
    isoN:taughtBy isoN:Case_cart_case ;
    isoN:zhGloss "前者是基于候选者现场数据分析所得的证据，用来说明任何可能损害安全目标的候选者失效概率满足适用 ASIL 的要求；后者是在此论证成立后，用它及相应工作产物替代给定生命周期子阶段。不能把适用 ASIL 的整套要求缩成一个脱离语境的“低于某目标值”。" .

isoN:P1_T117 a isoN:TermDefinition ;
    isoN:clauseId "1-3.117" ; isoN:partNumber 1 ;
    rdfs:label "质量管理"@zh ; isoN:enLabel "quality management, QM" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 26 ; isoN:blockIndex 30 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "组织为质量而进行的协调指挥与控制活动。Part 1 的注记只明确两点：QM 不是 ASIL，但可以在 HARA 中指定；至于某个 HARA 结果后续适用哪些活动，应回到 Part 3 及项目适用性判断，不能从词条本身推出“无需 ISO 26262 附加措施”这一无条件结论。" .

isoN:P1_T119 a isoN:TermDefinition ;
    isoN:clauseId "1-3.119" ; isoN:partNumber 1 ;
    rdfs:label "随机硬件故障/失效"@zh ; isoN:enLabel "random hardware fault / random hardware failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 27 ; isoN:blockIndex 5 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "服从概率分布的硬件故障，及其在寿命期内不可预测地发生、但整体遵循概率分布的失效。对付它靠度量与机制（算 λ、加诊断），不靠改流程。" .

isoN:P1_T120 a isoN:TermDefinition ;
    isoN:clauseId "1-3.120" ; isoN:partNumber 1 ;
    rdfs:label "合理可预见"@zh ; isoN:enLabel "reasonably foreseeable" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 27 ; isoN:blockIndex 8 ;
    isoN:zhGloss "技术上可能、且发生率可信或可测的情形。可预见的误用要管，科幻式的滥用不用管，界线就画在这个词上。" .

isoN:P1_T122 a isoN:TermDefinition ;
    isoN:clauseId "1-3.122" ; isoN:partNumber 1 ;
    rdfs:label "冗余"@zh ; isoN:enLabel "redundancy" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch08" ;
    isoN:pageIndex 27 ; isoN:blockIndex 16 ;
    isoN:taughtBy isoN:Case_decomp_credit ;
    isoN:zhGloss "在足以完成功能的手段之外再增加的手段，如双通道采集。冗余是分解的物质基础，但冗余本身不自动等于独立。" .

isoN:P1_T123 a isoN:TermDefinition ;
    isoN:clauseId "1-3.123" ; isoN:partNumber 1 ;
    rdfs:label "回归策略"@zh ; isoN:enLabel "regression strategy" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 27 ; isoN:blockIndex 23 ;
    isoN:taughtBy isoN:Case_compiler_upgrade ;
    isoN:zhGloss "验证变更没有影响未变更且已验证部分的策略。改一行代码要不要重测全部，答案写在这里。" .

isoN:P1_T125 a isoN:TermDefinition ;
    isoN:clauseId "1-3.125" ; isoN:partNumber 1 ;
    rdfs:label "残余故障"@zh ; isoN:enLabel "residual fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 27 ; isoN:blockIndex 29 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "元素有安全机制覆盖、但机制没盖住的那一部分随机硬件故障，其自身仍导致违背安全目标。单点与残余的分界只在“有没有机制”，这也是 SPFM 分子里两项并列的原因。" .

isoN:P1_T126 a isoN:TermDefinition ;
    isoN:clauseId "1-3.126" ; isoN:partNumber 1 ;
    rdfs:label "残余风险"@zh ; isoN:enLabel "residual risk" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 28 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "部署安全措施之后剩下的风险。安全工程的目标是把残余风险压到不合理线以下，而不是压到零。" .

isoN:P1_T127 a isoN:TermDefinition ;
    isoN:clauseId "1-3.127" ; isoN:partNumber 1 ;
    rdfs:label "评审"@zh ; isoN:enLabel "review" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 28 ; isoN:blockIndex 3 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "按评审目的，对工作产物是否达成其预期目标进行的检查。" .

isoN:P1_T128 a isoN:TermDefinition ;
    isoN:clauseId "1-3.128" ; isoN:partNumber 1 ;
    rdfs:label "风险"@zh ; isoN:enLabel "risk" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 28 ; isoN:blockIndex 7 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "伤害发生概率与该伤害严重度的组合。两个因子缺一不可。" .

isoN:P1_T129 a isoN:TermDefinition ;
    isoN:clauseId "1-3.129" ; isoN:partNumber 1 ;
    rdfs:label "稳健设计"@zh ; isoN:enLabel "robust design" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 28 ; isoN:blockIndex 10 ;
    isoN:zhGloss "在无效输入或恶劣环境条件下仍能正确工作的设计；对软件即对无效输入的耐受，对硬件即对环境应力的耐受。" .

isoN:P1_T130 a isoN:TermDefinition ;
    isoN:clauseId "1-3.130" ; isoN:partNumber 1 ;
    rdfs:label "安全故障"@zh ; isoN:enLabel "safe fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 28 ; isoN:blockIndex 17 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "发生后不会显著提高违背安全目标概率的故障。名字容易误导：它不是“安全机制的故障”，而是“无关大局的故障”。" .

isoN:P1_T131 a isoN:TermDefinition ;
    isoN:clauseId "1-3.131" ; isoN:partNumber 1 ;
    rdfs:label "安全状态"@zh ; isoN:enLabel "safe state" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch05" ;
    isoN:pageIndex 28 ; isoN:blockIndex 23 ;
    isoN:taughtBy isoN:Case_safe_state ;
    isoN:zhGloss "发生失效时相关项不存在不合理风险的运行模式。时间轴的终点站。注意它是运行模式而非“关机”：对某些系统，关机恰恰不安全。" .

isoN:P1_T132 a isoN:TermDefinition ;
    isoN:clauseId "1-3.132" ; isoN:partNumber 1 ;
    rdfs:label "安全"@zh ; isoN:enLabel "safety" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 28 ; isoN:blockIndex 29 ;
    isoN:zhGloss "不存在不合理的风险。整本标准的地基只有这一句：安全不是零风险。" .

isoN:P1_T133 a isoN:TermDefinition ;
    isoN:clauseId "1-3.133" ; isoN:partNumber 1 ;
    rdfs:label "安全活动"@zh ; isoN:enLabel "safety activity" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 29 ; isoN:blockIndex 0 ;
    isoN:zhGloss "在安全生命周期一个或多个阶段/子阶段中执行的活动。" .

isoN:P1_T134 a isoN:TermDefinition ;
    isoN:clauseId "1-3.134" ; isoN:partNumber 1 ;
    rdfs:label "安全异常"@zh ; isoN:enLabel "safety anomaly" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 29 ; isoN:blockIndex 3 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "偏离预期且可能导致伤害的状况。评审、测试、现场运行中发现的“不对劲”都先记为安全异常，再决定处置。" .

isoN:P1_T135 a isoN:TermDefinition ;
    isoN:clauseId "1-3.135" ; isoN:partNumber 1 ;
    rdfs:label "安全架构"@zh ; isoN:enLabel "safety architecture" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 29 ; isoN:blockIndex 8 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "为满足安全要求而组织起来的元素集合及其交互。同一个系统的安全架构是其整体架构中承担安全的那张投影。" .

isoN:P1_T136 a isoN:TermDefinition ;
    isoN:clauseId "1-3.136" ; isoN:partNumber 1 ;
    rdfs:label "安全档案"@zh ; isoN:enLabel "safety case" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 29 ; isoN:blockIndex 11 ;
    isoN:taughtBy isoN:Case_cart_case ;
    isoN:zhGloss "论证相关项或元素已达成功能安全的论证（argument），由工作产物汇编的证据支撑。注意词性：它是论证结构，不是文件夹——把工作产物堆在一起不构成安全档案。" .

isoN:P1_T137 a isoN:TermDefinition ;
    isoN:clauseId "1-3.137" ; isoN:partNumber 1 ;
    rdfs:label "安全文化"@zh ; isoN:enLabel "safety culture" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 29 ; isoN:blockIndex 15 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "组织中持久的价值观、态度、动机与知识，使安全在决策和行为中优先于竞争性目标。它决定了流程条文在压力下是否还算数。" .

isoN:P1_T138 a isoN:TermDefinition ;
    isoN:clauseId "1-3.138" ; isoN:partNumber 1 ;
    rdfs:label "独立于环境的安全要素"@zh ; isoN:enLabel "safety element out of context, SEooC" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 29 ; isoN:blockIndex 19 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "不针对某个具体相关项开发的安全相关元素，如通用微控制器、AUTOSAR 基础软件。它靠“假设的使用条件”参与安全论证，装车时必须逐条核对假设是否成立。" .

isoN:P1_T139 a isoN:TermDefinition ;
    isoN:clauseId "1-3.139" ; isoN:partNumber 1 ;
    rdfs:label "安全目标"@zh ; isoN:enLabel "safety goal, SG" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 29 ; isoN:blockIndex 25 ;
    isoN:taughtBy isoN:Case_goal_inherit ;
    isoN:zhGloss "HARA 得出的整车层面最高层安全要求。一个安全目标可以对应多个危害事件，其 ASIL 取所涉事件中最高者。" .

isoN:P1_T140 a isoN:TermDefinition ;
    isoN:clauseId "1-3.140" ; isoN:partNumber 1 ;
    rdfs:label "安全经理"@zh ; isoN:enLabel "safety manager" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 29 ; isoN:blockIndex 29 ;
    isoN:zhGloss "负责监督并确保达成功能安全所需活动得以执行的人或组织。" .

isoN:P1_T141 a isoN:TermDefinition ;
    isoN:clauseId "1-3.141" ; isoN:partNumber 1 ;
    rdfs:label "安全措施"@zh ; isoN:enLabel "safety measure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 30 ; isoN:blockIndex 0 ;
    isoN:zhGloss "避免或控制系统性失效、检测或控制随机硬件失效或缓解其危害影响的活动或技术方案。范围很宽：编码规范、评审、看门狗都算。" .

isoN:P1_T142 a isoN:TermDefinition ;
    isoN:clauseId "1-3.142" ; isoN:partNumber 1 ;
    rdfs:label "安全机制"@zh ; isoN:enLabel "safety mechanism" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 30 ; isoN:blockIndex 5 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "由 E/E 功能/元素或其它技术实现的技术方案，用于检测并缓解或容忍故障、控制或避免失效，以保持预期功能或达到安全状态。机制是措施的真子集：只有做进产品里的技术方案才叫机制，流程活动不算。" .

isoN:P1_T143 a isoN:TermDefinition ;
    isoN:clauseId "1-3.143" ; isoN:partNumber 1 ;
    rdfs:label "安全计划"@zh ; isoN:enLabel "safety plan" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 30 ; isoN:blockIndex 12 ;
    isoN:zhGloss "管理和引导项目安全活动执行的计划，含日期、里程碑、任务、交付物与责任人。" .

isoN:P1_T144 a isoN:TermDefinition ;
    isoN:clauseId "1-3.144" ; isoN:partNumber 1 ;
    rdfs:label "安全相关元素"@zh ; isoN:enLabel "safety-related element" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 30 ; isoN:blockIndex 15 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "有潜力违背或达成某个安全目标的元素。注意双向措辞：不只是“会闯祸的”，还包括“负责兜底的”。" .

isoN:P1_T145 a isoN:TermDefinition ;
    isoN:clauseId "1-3.145" ; isoN:partNumber 1 ;
    rdfs:label "安全相关功能"@zh ; isoN:enLabel "safety-related function" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 30 ; isoN:blockIndex 19 ;
    isoN:taughtBy isoN:Case_goal_inherit ;
    isoN:zhGloss "同上的功能视角版本：有潜力违背或达成安全目标的功能。" .

isoN:P1_T147 a isoN:TermDefinition ;
    isoN:clauseId "1-3.147" ; isoN:partNumber 1 ;
    rdfs:label "安全相关特殊特性"@zh ; isoN:enLabel "safety-related special characteristic" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 30 ; isoN:blockIndex 25 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "相关项、元素或其生产过程的特性，其合理可预见的偏差可能影响、促成或引起功能安全的潜在降低。它不只覆盖会直接违背安全目标的偏差，也是安全要求从开发端伸进工厂的重要接口。" .

isoN:P1_T148 a isoN:TermDefinition ;
    isoN:clauseId "1-3.148" ; isoN:partNumber 1 ;
    rdfs:label "安全确认"@zh ; isoN:enLabel "safety validation" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 31 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_time_budget ;
    isoN:zhGloss "基于检查和试验，对安全目标是否充分，以及是否以足够完整性得到实现给出确信。它与验证的对象和判据不同：这里问的是安全目标是否适当、是否已经达成，不能简单说成“比验证高一层”。" .

isoN:P1_T154 a isoN:TermDefinition ;
    isoN:clauseId "1-3.154" ; isoN:partNumber 1 ;
    rdfs:label "严重度"@zh ; isoN:enLabel "severity, S" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "潜在危害事件中一人或多人可能受到伤害程度的估计。HARA 中取 S0–S3。" .

isoN:P1_T156 a isoN:TermDefinition ;
    isoN:clauseId "1-3.156" ; isoN:partNumber 1 ;
    rdfs:label "单点故障/单点失效"@zh ; isoN:enLabel "single-point fault / single-point failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 31 ; isoN:blockIndex 32 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "元素中没有任何安全机制覆盖、自身直接导致违背安全目标的硬件故障，及其导致的失效。注意判据有两半：直接违背 + 无机制覆盖。" .

isoN:P1_T157 a isoN:TermDefinition ;
    isoN:clauseId "1-3.157" ; isoN:partNumber 1 ;
    rdfs:label "软件组件"@zh ; isoN:enLabel "software component" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 32 ; isoN:blockIndex 1 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "一个或多个软件单元的集合。定义只有一句话，但它是软件架构分层的基本砖块。" .

isoN:P1_T158 a isoN:TermDefinition ;
    isoN:clauseId "1-3.158" ; isoN:partNumber 1 ;
    rdfs:label "软件工具"@zh ; isoN:enLabel "software tool" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 32 ; isoN:blockIndex 4 ;
    isoN:taughtBy isoN:Case_tcl_two_questions ;
    isoN:zhGloss "用于相关项或元素开发过程的计算机程序。编译器、代码生成器、静态分析器都是；它们不装车，但可能把错误注入装车的东西——这是工具置信度（TCL）议题的起点。" .

isoN:P1_T159 a isoN:TermDefinition ;
    isoN:clauseId "1-3.159" ; isoN:partNumber 1 ;
    rdfs:label "软件单元"@zh ; isoN:enLabel "software unit" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02,ch07" ;
    isoN:pageIndex 32 ; isoN:blockIndex 7 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "软件架构中可以单独测试的原子级软件组件。“能不能单独测”是判据；Part 6 的单元设计与单元验证都以它为对象。" .

isoN:P1_T160 a isoN:TermDefinition ;
    isoN:clauseId "1-3.160" ; isoN:partNumber 1 ;
    rdfs:label "语句覆盖率"@zh ; isoN:enLabel "statement coverage" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 32 ; isoN:blockIndex 10 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "测试中被执行的软件语句百分比。三种结构覆盖率中最弱的一档。" .

isoN:P1_T161 a isoN:TermDefinition ;
    isoN:clauseId "1-3.161" ; isoN:partNumber 1 ;
    rdfs:label "子阶段"@zh ; isoN:enLabel "sub-phase" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 32 ; isoN:blockIndex 13 ;
    isoN:taughtBy isoN:Case_two_nets ;
    isoN:zhGloss "阶段在某个条款中规定的细分，如 HARA 是概念阶段的一个子阶段。" .

isoN:P1_T162 a isoN:TermDefinition ;
    isoN:clauseId "1-3.162" ; isoN:partNumber 1 ;
    rdfs:label "供货协议"@zh ; isoN:enLabel "supply agreement" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 32 ; isoN:blockIndex 17 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "客户与供应商间关于活动、证据或工作产物的责任约定；量产供货语境下与 DIA 相邻但不相同。" .

isoN:P1_T163 a isoN:TermDefinition ;
    isoN:clauseId "1-3.163" ; isoN:partNumber 1 ;
    rdfs:label "系统"@zh ; isoN:enLabel "system" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 32 ; isoN:blockIndex 21 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "至少把一个传感器、一个控制器和一个执行器关联起来的组件集合。“最小三件套”是它区别于普通组件的判据：少一件，就还不配叫 system。" .

isoN:P1_T165 a isoN:TermDefinition ;
    isoN:clauseId "1-3.165" ; isoN:partNumber 1 ;
    rdfs:label "系统性故障/失效"@zh ; isoN:enLabel "systematic fault / systematic failure" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06,ch07" ;
    isoN:pageIndex 32 ; isoN:blockIndex 28 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "以确定性方式与某个原因关联、只能靠更改设计或流程才能消除的故障/失效。软件缺陷全是系统性的；对付它靠开发过程，算不出 λ。" .

isoN:P1_T166 a isoN:TermDefinition ;
    isoN:clauseId "1-3.166" ; isoN:partNumber 1 ;
    rdfs:label "目标环境"@zh ; isoN:enLabel "target environment" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 32 ; isoN:blockIndex 31 ;
    isoN:taughtBy isoN:Case_compiler_upgrade ;
    isoN:zhGloss "特定软件预期运行的环境；对应用软件而言就是那块微控制器加上系统软件。" .

isoN:P1_T167 a isoN:TermDefinition ;
    isoN:clauseId "1-3.167" ; isoN:partNumber 1 ;
    rdfs:label "技术安全概念"@zh ; isoN:enLabel "technical safety concept, TSC" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 33 ; isoN:blockIndex 0 ;
    isoN:taughtBy isoN:Case_time_budget ;
    isoN:zhGloss "技术安全要求的规格说明及其到系统元素的分配，附带实现所需的信息。" .

isoN:P1_T168 a isoN:TermDefinition ;
    isoN:clauseId "1-3.168" ; isoN:partNumber 1 ;
    rdfs:label "技术安全要求"@zh ; isoN:enLabel "technical safety requirement, TSR" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05" ;
    isoN:pageIndex 33 ; isoN:blockIndex 3 ;
    isoN:taughtBy isoN:Case_time_budget ;
    isoN:zhGloss "为实现关联的功能安全要求而导出的要求。FSR 说“要防非预期助力”，TSR 说“扭矩指令超阈值 x ms 内切断”——从策略到技术指标的翻译。" .

isoN:P1_T169 a isoN:TermDefinition ;
    isoN:clauseId "1-3.169" ; isoN:partNumber 1 ;
    rdfs:label "测试"@zh ; isoN:enLabel "testing" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 33 ; isoN:blockIndex 7 ;
    isoN:taughtBy isoN:Case_seat_cards ;
    isoN:zhGloss "为验证满足要求、检测异常、建立信心而对相关项或元素进行规划、准备、运行或施加激励的过程。" .

isoN:P1_T172 a isoN:TermDefinition ;
    isoN:clauseId "1-3.172" ; isoN:partNumber 1 ;
    rdfs:label "传感转换器"@zh ; isoN:enLabel "transducer" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:pageIndex 33 ; isoN:blockIndex 17 ;
    isoN:zhGloss "把一种能量形式转换为另一种形式的硬件部件，其灵敏度决定输出与被测输入的关系。" .

isoN:P1_T173 a isoN:TermDefinition ;
    isoN:clauseId "1-3.173" ; isoN:partNumber 1 ;
    rdfs:label "瞬态故障"@zh ; isoN:enLabel "transient fault" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch06" ;
    isoN:pageIndex 33 ; isoN:blockIndex 20 ;
    isoN:taughtBy isoN:Case_r17_chain ;
    isoN:zhGloss "发生一次随后消失的故障，如电磁干扰或粒子翻转引起的位翻转。诊断策略对永久/瞬态故障的假设完全不同。" .

isoN:P1_T176 a isoN:TermDefinition ;
    isoN:clauseId "1-3.176" ; isoN:partNumber 1 ;
    rdfs:label "不合理风险"@zh ; isoN:enLabel "unreasonable risk" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch02" ;
    isoN:pageIndex 33 ; isoN:blockIndex 33 ;
    isoN:taughtBy isoN:Case_asil_language ;
    isoN:zhGloss "依据当时有效的社会道德观念，在特定情境下被判定为不可接受的风险。注意判据是社会共识而非工程计算——它解释了为什么“安全”没有全球统一的数值阈值。" .

isoN:P1_T178 a isoN:TermDefinition ;
    isoN:clauseId "1-3.178" ; isoN:partNumber 1 ;
    rdfs:label "车辆功能"@zh ; isoN:enLabel "vehicle function" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 34 ; isoN:blockIndex 4 ;
    isoN:zhGloss "由一个或多个相关项实现、顾客可观察到的车辆行为，如自适应巡航。功能是顾客视角，相关项是工程记账视角。" .

isoN:P1_T179 a isoN:TermDefinition ;
    isoN:clauseId "1-3.179" ; isoN:partNumber 1 ;
    rdfs:label "车辆运行状态"@zh ; isoN:enLabel "vehicle operating state" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch04" ;
    isoN:pageIndex 34 ; isoN:blockIndex 8 ;
    isoN:taughtBy isoN:Case_safe_state ;
    isoN:zhGloss "运行模式与运行场景的组合。场景在车外、模式在车内，两者合起来才描述“车此刻的处境”。" .

isoN:P1_T180 a isoN:TermDefinition ;
    isoN:clauseId "1-3.180" ; isoN:partNumber 1 ;
    rdfs:label "验证"@zh ; isoN:enLabel "verification" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch05,ch10" ;
    isoN:pageIndex 34 ; isoN:blockIndex 12 ;
    isoN:taughtBy isoN:Case_v_model ;
    isoN:zhGloss "判定被检对象是否满足其规定要求。问的是“做得对不对”（against spec）。" .

isoN:P1_T181 a isoN:TermDefinition ;
    isoN:clauseId "1-3.181" ; isoN:partNumber 1 ;
    rdfs:label "验证评审"@zh ; isoN:enLabel "verification review" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 34 ; isoN:blockIndex 21 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "确保开发活动结果满足项目要求或技术要求的验证活动。" .

isoN:P1_T182 a isoN:TermDefinition ;
    isoN:clauseId "1-3.182" ; isoN:partNumber 1 ;
    rdfs:label "走查"@zh ; isoN:enLabel "walk-through" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch07" ;
    isoN:pageIndex 34 ; isoN:blockIndex 27 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "系统地过一遍工作产物以检出安全异常，形式比审查轻。方法表里两者是备选关系（Part 6 Table 7 的 1a/1c）。" .

isoN:P1_T183 a isoN:TermDefinition ;
    isoN:clauseId "1-3.183" ; isoN:partNumber 1 ;
    rdfs:label "警告与降级策略"@zh ; isoN:enLabel "warning and degradation strategy" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch09" ;
    isoN:pageIndex 35 ; isoN:blockIndex 2 ;
    isoN:taughtBy isoN:Case_safe_state ;
    isoN:zhGloss "规定如何提醒驾驶员功能可能降低、以及如何提供降级功能以到达安全状态的规格说明。时间轴上“人”这条支线的剧本。" .

isoN:P1_T184 a isoN:TermDefinition ;
    isoN:clauseId "1-3.184" ; isoN:partNumber 1 ;
    rdfs:label "久经考验"@zh ; isoN:enLabel "well-trusted" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch10" ;
    isoN:pageIndex 35 ; isoN:blockIndex 11 ;
    isoN:zhGloss "曾在可比应用中使用且无已知安全异常，如久经考验的设计原则、工具、软件模块。口语的“用过很多年”必须落到“可比应用 + 无已知异常”两个判据上。" .

isoN:P1_T185 a isoN:TermDefinition ;
    isoN:clauseId "1-3.185" ; isoN:partNumber 1 ;
    rdfs:label "工作产物"@zh ; isoN:enLabel "work product" ;
    isoN:modality isoN:Definition ; isoN:glossStatus "glossed" ;
    isoN:servesChapter "ch03" ;
    isoN:pageIndex 35 ; isoN:blockIndex 15 ;
    isoN:taughtBy isoN:Case_three_confirmations ;
    isoN:zhGloss "由 ISO 26262 一个或多个相关要求产生的文档化结果；它可以是一份完整文档，也可以由多份文档共同承载。是否充分证明活动已执行，要结合相应要求、过程记录和评审判断，不能把“没文档等于没做”当成词条定义的一部分。" .

isoN:Coverage_P1 a isoN:CoverageDeclaration ; isoN:partNumber 1 ;
    isoN:coversRange "1-3.1 至 1-3.185" ; isoN:unitCount 153 ;
    rdfs:comment "本层 Part 1 收录以上词条；范围外词条号未收录，请回标准原文核对。"@zh .