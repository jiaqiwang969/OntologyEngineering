diff --git a/extension/src/native-exports.ts b/extension/src/native-exports.ts
new file mode 100644
index 0000000..c82b5c1
--- /dev/null
+++ b/extension/src/native-exports.ts
@@ -0,0 +1,89 @@
+/// <reference types="@jlceda/pro-api-types" />
+import { ActionError, ErrorCodes, type ActionResult } from './protocol';
+import { blobToBase64, describeThrown, newArtifactId, optionalString, requireString } from './util';
+
+type Payload = Record<string, unknown>;
+
+async function nativeCall<T>(operation: () => Promise<T>, message: string): Promise<T> {
+	try { return await operation(); }
+	catch (error) {
+		if (error instanceof ActionError) throw error;
+		throw new ActionError(ErrorCodes.EDA_CALL_FAILED, message, describeThrown(error));
+	}
+}
+
+async function requireProject(payload: Payload): Promise<string> {
+	const expected = requireString(payload, 'projectUuid');
+	const current = await nativeCall(() => eda.dmt_Project.getCurrentProjectInfo(), 'Failed to read the current export project.');
+	if (!current || current.uuid !== expected) {
+		throw new ActionError(ErrorCodes.INVALID_STATE, 'Current project does not match export projectUuid.');
+	}
+	return expected;
+}
+
+async function exported(file: File | undefined, kind: string, fallback: string, details: Record<string, unknown>, fallbackMime = 'application/zip'): Promise<ActionResult> {
+	if (!file || !file.size) throw new ActionError(ErrorCodes.EDA_CALL_FAILED, 'Official export returned no file or an empty file.');
+	const id = newArtifactId();
+	const inlineBase64 = await nativeCall(() => blobToBase64(file), 'Failed to read the official export file bytes.');
+	return {
+		result: { ...details, artifactId: id, fileName: file.name || fallback, size: file.size, engineeringAcceptance: 'not_granted' },
+		artifacts: [{ id, kind, fileName: file.name || fallback, mimeType: file.type || fallbackMime, inlineBase64 }],
+	};
+}
+
+/** Native PCB netlist bytes, with no SCH/DSN fallback or JSON reserialization. */
+export async function pcbExportNetlist(payload: Payload): Promise<ActionResult> {
+	const pcbUuid = requireString(payload, 'pcbUuid');
+	const projectUuid = await requireProject(payload);
+	const assertTarget = async () => {
+		await requireProject(payload);
+		const doc = await nativeCall(() => eda.dmt_SelectControl.getCurrentDocumentInfo(), 'Failed to read the active PCB document.');
+		if (!doc || doc.documentType !== 3 || doc.uuid !== pcbUuid || doc.parentProjectUuid !== projectUuid || !doc.tabId)
+			throw new ActionError(ErrorCodes.INVALID_STATE, 'Active PCB document does not match export projectUuid/pcbUuid.');
+		const pcb = await nativeCall(() => eda.dmt_Pcb.getCurrentPcbInfo(), 'Failed to read the current export PCB.');
+		if (!pcb || pcb.uuid !== pcbUuid || pcb.parentProjectUuid !== projectUuid)
+			throw new ActionError(ErrorCodes.INVALID_STATE, 'Current PCB does not match export projectUuid/pcbUuid.');
+		return doc.tabId;
+	};
+	const tabId = await assertTarget();
+	const name = optionalString(payload, 'fileName') || 'pcb-netlist';
+	const format = 'JLCEDA' as Parameters<typeof eda.pcb_ManufactureData.getNetlistFile>[1];
+	const file = await nativeCall(() => eda.pcb_ManufactureData.getNetlistFile(name, format), 'Official PCB netlist export failed.');
+	const result = await exported(file, 'pcb_netlist', name, {
+		projectUuid, pcbUuid, tabId, requestedFormat: 'JLCEDA', api: 'pcb_ManufactureData.getNetlistFile',
+		identityCheck: 'before-and-after-byte-read',
+	}, 'application/octet-stream');
+	if (await assertTarget() !== tabId)
+		throw new ActionError(ErrorCodes.INVALID_STATE, 'Active PCB tab changed during netlist export.');
+	return result;
+}
+
+/** Explicit current-project assertion avoids the by-UUID SDK's cloud-only origin. */
+export async function projectExport(payload: Payload): Promise<ActionResult> {
+	const projectUuid = await requireProject(payload);
+	const name = optionalString(payload, 'fileName') || 'project.epro2';
+	const file = await nativeCall(() => eda.sys_FileManager.getProjectFile(name, undefined, 'epro2'), 'Official current-project export failed.');
+	await requireProject(payload);
+	return exported(file, 'project_epro2', name, { projectUuid, fileType: 'epro2', api: 'sys_FileManager.getProjectFile' });
+}
+
+/** Original manufacturing bytes, native production default layers/objects (including pours). */
+export async function pcbExportGerber(payload: Payload): Promise<ActionResult> {
+	const projectUuid = await requireProject(payload);
+	const pcbUuid = requireString(payload, 'pcbUuid');
+	const assertPcb = async () => {
+		const current = await nativeCall(() => eda.dmt_Pcb.getCurrentPcbInfo(), 'Failed to read the current export PCB.');
+		if (current?.uuid !== pcbUuid)
+			throw new ActionError(ErrorCodes.INVALID_STATE, 'Current PCB does not match export pcbUuid.');
+	};
+	await assertPcb();
+	const name = optionalString(payload, 'fileName') || 'gerber.zip';
+	const unit = 'mm' as Parameters<typeof eda.pcb_ManufactureData.getGerberFile>[2];
+	const format = { integerNumber: 4, decimalNumber: 6 };
+	const other = { metallicDrillingInformation: true, nonMetallicDrillingInformation: true, drillTable: false, flyingProbeTestingFile: true };
+	// Omit filters: the SDK's documented default includes CopperFilled and PlaneZone.
+	const file = await nativeCall(() => eda.pcb_ManufactureData.getGerberFile(name, false, unit, format, other), 'Official Gerber export failed.');
+	await requireProject(payload);
+	await assertPcb();
+	return exported(file, 'pcb_gerber', name, { projectUuid, pcbUuid, unit, digitalFormat: format, other, layers: 'native-default-production', objects: 'native-default-production', api: 'pcb_ManufactureData.getGerberFile' });
+}
