isoN:P3_6_4_1_2 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.1.2" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 13 ; isoN:blockIndex 10 ;
    isoN:zhGloss "初始危害分析与风险评估不计入相关项内部拟实现的安全机制；不能先假设\"反正有监控\"再据此降低其自身的完整性要求。" ;
    isoN:keywords "HARA、不计入内部机制" ;
    isoN:servesChapter "ch04 §4.4.2" ;
    isoN:glossStatus "glossed" .

