+	const mutations: Array<{ id: string; patch: Record<string, unknown> }> = [];
+	(globalThis as any).eda = {
+		dmt_Project: { getCurrentProjectInfo: async () => ({ uuid: 'modify-project' }) },
+		dmt_SelectControl: { getCurrentDocumentInfo: async () => ({ uuid: 'modify-page', tabId: 'modify-page@modify-project' }) },
+		sch_PrimitiveComponent: {
+			get: async () => primitive(), getAll: async () => [primitive()],
+			create: async () => primitive(),
+			modify: async (id: string, patch: Record<string, unknown>) => {
+				mutations.push({ id, patch: structuredClone(patch) });
+				if (id !== state.PrimitiveId) throw new Error('only part primitives can be modified');
+				let supplier = patch.supplierId;
+				if (!supplier && supplier !== null) supplier = state.SubPartName;
+				state.SupplierId = supplier ?? undefined;
+				// SDK replaces the extra-property map even when it was omitted.
+				state.OtherProperty = { ...(patch.otherProperty as object ?? {}) };
+				for (const key of ['x', 'y', 'designator']) {
+					if (key in patch) state[key[0].toUpperCase() + key.slice(1)] = patch[key];
+				}
+				return primitive();
+			},
+		},
+		sch_PrimitiveWire: { getAll: async () => [] },
+		lib_Device: { get: async () => ({ property: { supplierId: 'C21190' } }) },
+	};
+	return { state, primitive, mutations, sdk: (globalThis as any).eda };
+}
+
+test('geometry-only modify retains the original Supplier Part and complete properties', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture();
+	await schematicComponentModify({ primitiveId: 'part-1', patch: { x: 110 } });
+	assert.equal(fx.state.SupplierId, 'C21190');
+	assert.deepEqual(fx.state.OtherProperty, { Value: '1k', Description: 'retain', zero: 0, flag: false });
+	assert.equal(fx.state.X, 110);
+});
+
+test('partial property modify retains Supplier Part and unrelated properties', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture();
+	await schematicComponentModify({ primitiveId: 'part-1', patch: { customAttributes: { Value: '2k' } } });
+	assert.equal(fx.state.SupplierId, 'C21190');
+	assert.deepEqual(fx.state.OtherProperty, { Value: '2k', Description: 'retain', zero: 0, flag: false });
+});
+
+test('explicit supplier change retains properties; explicit blank must not become subPartName', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture();
+	await schematicComponentModify({ primitiveId: 'part-1', patch: { supplierId: 'C14663' } });
+	assert.equal(fx.state.SupplierId, 'C14663');
+	assert.equal((fx.state.OtherProperty as any).Description, 'retain');
+	await schematicComponentModify({ primitiveId: 'part-1', patch: { supplierId: '' } });
+	assert.equal(fx.mutations.at(-1)!.patch.supplierId, null);
+	assert.equal(fx.state.SupplierId, undefined);
+});
+
+test('missing supplier identity remains empty on an unrelated edit', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture({ SupplierId: undefined });
+	await schematicComponentModify({ primitiveId: 'part-1', patch: { x: 110 } });
+	assert.equal(fx.state.SupplierId, undefined);
+});
+
+test('unrepresentable existing properties reject before mutation instead of dropping them', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture({ OtherProperty: { Value: '1k', structured: { retain: true } } });
+	await assert.rejects(schematicComponentModify({ primitiveId: 'part-1', patch: { x: 110 } }), /propert/i);
+	assert.equal(fx.mutations.length, 0);
+});
+
+test('place designator assignment and supplier backfill retain original metadata', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture({ SupplierId: '0603WAF1001T5E.1' });
+	await schematicComponentPlace({ libraryUuid: 'lib', uuid: 'device', x: 100, y: 200, designator: 'R9' });
+	assert.equal(fx.state.Designator, 'R9');
+	assert.equal(fx.state.SupplierId, 'C21190');
+	assert.equal((fx.state.OtherProperty as any).Value, '1k');
+});
+
+test('group move rejects a later marker before moving any earlier part', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture();
+	fx.sdk.sch_PrimitiveComponent.getAll = async () => [fx.primitive(), fx.primitive({
+		PrimitiveId: 'marker-1', ComponentType: 'netport', X: 150, Y: 200,
+	})];
+	await assert.rejects(runAction('schematic.group.move', { primitiveIds: ['part-1', 'marker-1'], dx: 10, dy: 0 }), /part|marker|netport/i);
+	assert.equal(fx.mutations.length, 0);
+	assert.equal(fx.state.X, 100);
+});
+
+test('group move rejects a missing requested id before mutating resolved members', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture();
+	await assert.rejects(runAction('schematic.group.move', { primitiveIds: ['part-1', 'missing'], dx: 10, dy: 0 }), /missing|not found|resolve/i);
+	assert.equal(fx.mutations.length, 0);
+});
+
+test('part-only group move retains supplier and properties', async t => {
+	t.after(() => { delete (globalThis as any).eda; });
+	const fx = fixture();
+	await runAction('schematic.group.move', { primitiveIds: ['part-1'], dx: 10, dy: 5 });
+	assert.equal(fx.state.SupplierId, 'C21190');
+	assert.equal((fx.state.OtherProperty as any).Value, '1k');
+	assert.equal(fx.state.X, 110);
+	assert.equal(fx.state.Y, 205);
+});
diff --git a/extension/src/component-modify.ts b/extension/src/component-modify.ts
new file mode 100644
index 0000000..aa348a5
--- /dev/null
+++ b/extension/src/component-modify.ts
@@ -0,0 +1,56 @@
+import { ActionError, ErrorCodes } from './protocol';
+
+type Property = string | number | boolean;
+type Properties = Record<string, Property>;
+interface ComponentState {
+	getState_SupplierId(): unknown;
+	getState_OtherProperty(): unknown;
+}
+
+function properties(value: unknown, field: string): Properties {
+	if (value === undefined) return {};
+	if (typeof value !== 'object' || value === null || Array.isArray(value)) {
+		throw new ActionError(ErrorCodes.INVALID_STATE, `${field} must be a complete property object; refusing a lossy component modification.`);
+	}
+	const entries = Object.entries(value);
+	for (const [key, item] of entries) {
+		if (!(typeof item === 'string' || typeof item === 'boolean' || (typeof item === 'number' && Number.isFinite(item)))) {
+			throw new ActionError(ErrorCodes.INVALID_STATE, `${field}.${key} cannot be preserved by the SDK property contract; refusing modification.`);
+		}
+	}
+	return Object.fromEntries(entries) as Properties;
+}
+
+/**
+ * 3.2 SDK modify defaults omitted supplierId to subPartName and replaces omitted
+ * otherProperty with {}. Always supply the complete current state plus requested
+ * changes. Read the instance getters, never substitute a library lookup or MPN.
+ */
+export function prepareComponentModifyPatch(current: ComponentState, patch: Record<string, unknown>): {
+	patch: Record<string, unknown> & { supplierId: string | null; otherProperty: Properties };
+	before: { supplierId: string | null | undefined; otherProperty: Properties };
+} {
+	let supplier: unknown, extra: unknown;
+	try { supplier = current.getState_SupplierId(); extra = current.getState_OtherProperty(); }
+	catch (err) {
+		throw new ActionError(ErrorCodes.EDA_CALL_FAILED, 'Cannot read complete component properties before modification.', String(err));
+	}
+	if (supplier !== undefined && supplier !== null && typeof supplier !== 'string') {
+		throw new ActionError(ErrorCodes.INVALID_STATE, 'Current supplierId is not a string or empty; refusing modification.');
+	}
+	const before = { supplierId: supplier, otherProperty: properties(extra, 'current.otherProperty') };
+	const wanted = patch.supplierId === undefined ? supplier : patch.supplierId;
+	if (wanted !== undefined && wanted !== null && typeof wanted !== 'string') {
+		throw new ActionError(ErrorCodes.MISSING_PAYLOAD_FIELD, 'Component supplierId must be a string or null.');
+	}
+	return {
+		before,
+		patch: {
+			...patch,
+			// SDK treats '' like omission; explicit null suppresses the subPartName
+			// fallback for an unnumbered part or an explicitly cleared supplier.
+			supplierId: wanted === '' || wanted === undefined ? null : wanted,
+			otherProperty: { ...before.otherProperty, ...properties(patch.otherProperty, 'patch.otherProperty') },
+		},
+	};
+}
