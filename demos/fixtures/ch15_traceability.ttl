# ch15 §15.6 场景：理由锚在传感器刷新参数上的三条追溯边 + 一条无关干扰边
@prefix req: <https://product-trustworthiness.local/requirements#> .

req:edge_0 req:rationale req:rationale_0 ; req:toReq req:FSR_TorqueLimit .
req:rationale_0 req:dependsOnAspect req:Param_SensorUpdate ;
    req:justification "最坏刷新时间参与其超时预算推导" .

req:edge_1 req:rationale req:rationale_1 ; req:toReq req:TSR_WatchdogWindow .
req:rationale_1 req:dependsOnAspect req:Param_SensorUpdate ;
    req:justification "看门狗窗口以传感器刷新为下界" .

req:edge_2 req:rationale req:rationale_2 ; req:toReq req:SwReq_PlausibilityCheck .
req:rationale_2 req:dependsOnAspect req:Param_SensorUpdate ;
    req:justification "似真性检查周期引用了该刷新承诺" .

# 干扰项：理由锚在电源参数上——传感器换代不应牵出它
req:edge_power req:rationale req:rationale_power ; req:toReq req:HwReq_Brownout .
req:rationale_power req:dependsOnAspect req:Param_SupplyRail ;
    req:justification "欠压阈值与传感器刷新无关" .
