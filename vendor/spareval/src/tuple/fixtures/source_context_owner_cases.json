    "source_contract": {
      "row": "FrozenBindings has an immutable local mapping snapshot and a reference to its real QueryContext owner. Local domain/hash/equality ignore owner bindings.",
      "lookup": "Frozen lookup reads local then owner.initBindings only. QueryContext lookup reads current context.bindings and maps missing to None.",
      "owner_lifetime": "A frozen row holds the same live owner even if owner.bindings subsequently receives a new assignment; immutable row local cells do not change.",
      "clone_thaw": "QueryContext.clone/thaw choose supplied mapping only if locally nonempty, else the receiver current bindings; constructor then updates immutable initial in place and appends only new initial keys. A new QueryContext is created.",
      "row_producers": "project/remember/forget create fresh row identity preserving self.ctx. merge preserves left ctx and local right overwrite order. QueryContext.solution creates a fresh row with self ctx. Group outputs use the aggregate call ctx. VALUES push creates a fresh ctx per attempted row.",
      "opaque_value_objects": "Copying binding cells preserves RDF cache/source payload object identity, None and original ErrorValue identity; copying a frozen row for transport preserves its row identity/hash cache.",
      "immutable_initial_scope": "Sealed execution has one immutable initial mapping shared across owners; raw API CO11 explicitly distinguishes receiver and frozen owners without broadening sealed initial mutation support.",
      "excluded": "Graph switching/dataset/time/prologue/bnodes are not qualified by this binding owner baseline. Context token/name alone is not evidence of complete QueryContext parity."
    },
