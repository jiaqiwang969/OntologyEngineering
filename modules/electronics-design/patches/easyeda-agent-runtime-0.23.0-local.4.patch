+
+test('a delayed scheduler can overshoot a wall-clock deadline without a second click', async () => {
+	let current = 0; let polls = 0;
+	const result = await confirmImportDialog(async () => { polls++; return observation('none'); }, {
+		now: () => current, sleep: async () => { current += 33445; },
+	});
+	assert.equal(result.status, 'no-dialog'); assert.equal(result.polls, 1);
+	assert.equal(result.elapsedMs, 33445); assert.equal(result.clicked, false); assert.equal(polls, 1);
+});
+
+
+test('host CSS disabled/readonly button states cannot be mistaken for a completed click', () => {
+	for (const klass of ['lc_btn__type_primary_disabled_rjDZo', 'lc_btn__type_default_disabled_zWib3', 'lc_btn__type_primary_readonly_00LoZ']) {
