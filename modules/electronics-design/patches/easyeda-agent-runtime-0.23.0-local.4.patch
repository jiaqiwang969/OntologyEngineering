@@ -0,0 +1,163 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { createContext, runInContext } from 'node:vm';
+import ts from 'typescript';
+import * as protocol from './protocol';
+import { describeThrown } from './util';
+
+// Actual entry + transport source, with fake SDK/time only: no UI, sockets,
+// workers, daemon or native EDA calls. An explicit frozen root enables old-red.
+const sourceRoot = process.env.EASYEDA_MENU_TEST_SOURCE_ROOT ?? join(__dirname, '..');
+const source = (file: string): string => readFileSync(join(sourceRoot, file), 'utf8');
+
+function harness(autoHandshake = true) {
+	let now = 0, serial = 0, activation = 0, windowSequence = 0;
+	let registrations = 0, closes = 0, actionFinish: (() => void) | undefined;
+	const timers = new Map<number, { due: number; fn: () => void; interval?: number }>();
+	const sockets = new Map<string, (event: { data: string }) => Promise<void>>();
+	const sent: Array<Record<string, any>> = [];
+	const add = (fn: () => void, delay: number, interval?: number): number => {
+		const id = ++serial; timers.set(id, { due: now + delay, fn, interval }); return id;
+	};
+	const flush = async (): Promise<void> => { for (let i = 0; i < 24; i++) await Promise.resolve(); };
+	const context = createContext({
+		console: { log() {}, warn() {}, error() {} },
+		crypto: { randomUUID: () => `synthetic-window-${++windowSequence}` },
+		setTimeout: (fn: () => void, delay: number) => add(fn, delay), clearTimeout: (id: number) => timers.delete(id),
+		setInterval: (fn: () => void, delay: number) => add(fn, delay, delay), clearInterval: (id: number) => timers.delete(id),
+		Blob: class {}, URL: { createObjectURL() { throw new Error('fake fallback driver'); }, revokeObjectURL() {} },
+		eda: {
+			sys_Log: { add() {} }, sys_Message: { showToastMessage() {} }, sys_I18n: { text: (value: string) => value },
+			sys_Dialog: { showInformationMessage() {} },
+			sys_WebSocket: {
+				close(id: string) { closes++; sockets.delete(id); },
+				register(id: string, _url: string, callback: (event: { data: string }) => Promise<void>) {
+					registrations++; sockets.set(id, callback);
+					if (autoHandshake) void callback({ data: JSON.stringify({ type: 'handshake', service: protocol.SERVICE_ID }) });
+				},
+				send(id: string, data: string) {
+					const callback = sockets.get(id); if (!callback) throw new Error('fake closed socket');
+					const frame = JSON.parse(data); sent.push(frame);
+					if (frame.type === 'ping') void callback({ data: JSON.stringify({ type: 'pong', id: frame.id }) });
+				},
+			},
+		},
+	});
+	function module(file: string, requireModule: (name: string) => unknown): Record<string, any> {
+		const code = ts.transpileModule(source(file), { compilerOptions: { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.CommonJS } }).outputText;
+		const output: Record<string, any> = {};
+		runInContext(`(function(exports,require){${code}\n})`, context)(output, requireModule);
+		return output;
+	}
+	function menu() {
+		const socketId = `synthetic-socket-${++activation}`;
+		const transport = module('src/transport.ts', (name) => {
+			if (name === './protocol') return protocol;
+			if (name === './util') return { describeThrown };
+			if (name === './transport-identity') return { createWebSocketId: () => socketId };
+			if (name === './eda-context') return {
+				readEasyEdaVersion: () => 'synthetic',
+				buildContextFrame: async (windowId: string) => ({ type: 'context', windowId, projectUuid: 'synthetic-project', documentUuid: 'synthetic-doc' }),
+			};
+			if (name === './actions') return { runAction: () => new Promise(resolve => { actionFinish = () => resolve({ result: { synthetic: true } }); }) };
+			throw new Error(`Unexpected transport import ${name}`);
+		});
+		const entry = module('src/index.ts', (name) => {
+			if (name === './transport') return transport;
+			if (name === '../extension.json') return JSON.parse(source('extension.json'));
+			throw new Error(`Unexpected entry import ${name}`);
+		});
+		return {
+			entry, transport,
+			// The old combined menu is deliberately exercised under old-red.
+			connect: () => (entry.connect ?? entry.reconnect)(),
+			force: () => (entry.forceReconnect ?? entry.reconnect)(),
+		};
+	}
+	async function advance(ms: number): Promise<void> {
+		const end = now + ms; await flush();
+		for (;;) {
+			const next = [...timers.entries()].sort((a, b) => a[1].due - b[1].due)[0];
+			if (!next || next[1].due > end) break;
+			now = next[1].due;
+			if (next[1].interval) next[1].due += next[1].interval; else timers.delete(next[0]);
+			next[1].fn(); await flush();
+		}
+		now = end; await flush();
+	}
+	const state = () => ({ registrations, closes, sockets: sockets.size, timers: timers.size, registerFrames: sent.filter(x => x.type === 'register').length });
+	return {
+		menu, advance, flush, state, sent,
+		request: async () => {
+			assert.equal(sockets.size, 1);
+			const done = [...sockets.values()][0]({ data: JSON.stringify({ type: 'request', id: 'synthetic-pending', action: 'synthetic.action' }) });
+			await flush(); return { finish: async () => { assert.ok(actionFinish); actionFinish(); await done; await flush(); } };
+		},
+	};
+}
+
+test('all six editor menus expose idempotent Connect and separate Force Reconnect', () => {
+	const config = JSON.parse(source('extension.json'));
+	assert.equal(config.activationEvents.onStartupFinished, false);
+	assert.deepEqual(Object.keys(config.headerMenus).sort(), ['blank', 'footprint', 'home', 'pcb', 'sch', 'symbol']);
+	for (const groups of Object.values(config.headerMenus) as any[]) {
+		const items = groups.flatMap((group: any) => group.menuItems);
+		assert.equal(items.filter((x: any) => x.registerFn === 'connect' && x.title === 'Connect').length, 1);
+		assert.equal(items.filter((x: any) => x.registerFn === 'forceReconnect' && x.title === 'Force Reconnect').length, 1);
+		assert.equal(items.filter((x: any) => x.registerFn === 'stopConnection').length, 1);
+		assert.equal(items.filter((x: any) => x.registerFn === 'about').length, 1);
+	}
+});
+
+test('activation and compatibility preference stay passive', async () => {
+	const h = harness(); const m = h.menu(); m.entry.activate('onStartupFinished'); await m.entry.toggleAutoConnect(); await h.advance(30000);
+	assert.deepEqual(h.state(), { registrations: 0, closes: 0, sockets: 0, timers: 0, registerFrames: 0 });
+});
+
+test('Connect on a live owner is idempotent in same and freshly evaluated menus', async () => {
+	const h = harness(); const m = h.menu(); m.connect(); await h.advance(200);
+	const before = h.state(), windowId = m.transport.getConnectionStatus().windowId;
+	assert.equal(m.transport.getConnectionStatus().connected, true);
+	m.connect(); h.menu().connect(); m.entry.reconnect(); h.menu().entry.reconnect(); await h.advance(200);
+	assert.deepEqual(h.state(), before, 'no close/unregister, new socket, register frame or driver');
+	assert.equal(m.transport.getConnectionStatus().windowId, windowId);
+	m.entry.stopConnection();
+});
+
+test('Connect during an in-flight scan leaves its exact timer/socket ownership intact', async () => {
+	const h = harness(false); const m = h.menu(); m.connect(); await h.advance(200);
+	assert.equal(m.transport.getConnectionStatus().connecting, true); const before = h.state();
+	m.connect(); h.menu().connect(); await h.flush(); assert.deepEqual(h.state(), before);
+	m.entry.stopConnection(); await h.advance(30000); assert.equal(h.state().timers, 0);
+});
+
+test('Force Reconnect retains explicit replacement of an idle live connection', async () => {
+	const h = harness(); const m = h.menu(); m.connect(); await h.advance(200);
+	const oldWindow = m.transport.getConnectionStatus().windowId, before = h.state();
+	h.menu().force(); await h.advance(200);
+	assert.equal(h.state().registerFrames, before.registerFrames + 1);
+	assert.ok(h.state().closes > before.closes);
+	assert.notEqual(m.transport.getConnectionStatus().windowId, oldWindow);
+	assert.equal(h.state().sockets, 1); assert.equal(h.state().timers, 1);
+	m.entry.stopConnection();
+});
+
+test('pending action blocks Force Reconnect and blocks Connect after Stop until drain', async () => {
+	const h = harness(); const m = h.menu(); m.connect(); await h.advance(200);
+	const request = await h.request(); assert.equal(m.transport.getConnectionStatus().pendingActions, 1);
+	const before = h.state(); h.menu().force(); h.menu().connect(); await h.flush(); assert.deepEqual(h.state(), before);
+	m.entry.stopConnection(); const stopped = h.state(); h.menu().connect(); h.menu().force(); await h.advance(30000);
+	assert.deepEqual(h.state(), stopped, 'no replacement while an accepted action drains');
+	await request.finish(); assert.equal(h.sent.filter(x => x.id === 'synthetic-pending').length, 0, 'old response must not escape after Stop');
+	h.menu().connect(); await h.advance(200); assert.equal(h.state().registerFrames, before.registerFrames + 1);
+	m.entry.stopConnection();
+});
+
+test('Stop never resurrects connection; a later explicit Connect starts one flow', async () => {
+	const h = harness(); const m = h.menu(); m.connect(); await h.advance(200); m.entry.stopConnection();
+	const stopped = h.state(); await h.advance(60000); assert.deepEqual(h.state(), stopped); assert.equal(stopped.timers, 0);
+	h.menu().connect(); await h.advance(200); assert.equal(h.state().registerFrames, 2); assert.equal(h.state().timers, 1);
+	m.entry.stopConnection();
+});
