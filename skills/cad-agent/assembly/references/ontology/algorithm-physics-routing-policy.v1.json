  "planning_admission_invariants": [
    {
      "id": "PAB-01",
      "name": "authoritative_q0",
      "statement": "Bind the assembled q0 to the authoritative final product pose."
    },
    {
      "id": "PAB-02",
      "name": "identity_units_frames_hashes",
      "statement": "Pin geometry identity, mover and fixed identities, units, frames, and consumed source hashes."
    },
    {
      "id": "PAB-03",
      "name": "one_rigid_transition",
      "statement": "Move one rigid occurrence or one explicitly declared rigid subassembly per transition and partition deformables separately."
    },
    {
      "id": "PAB-04",
      "name": "ordered_absolute_states",
      "statement": "Persist ordered absolute states, state count, and a canonical state digest."
    },
    {
      "id": "PAB-05",
      "name": "continuous_model_consistency",
      "statement": "Check q0, every admitted state, and every path edge against one declared mover and fixed model; label sampling as sampled."
    },
    {
      "id": "PAB-06",
      "name": "terminal_goal",
      "statement": "Persist the disassembled terminal goal and label any convex-hull or other proxy goal as a proxy."
    },
    {
      "id": "PAB-07",
      "name": "reverse_state_order_only",
      "statement": "Form assembly by reversing state order, never by negating absolute translations, Euler angles, or transforms."
    },
    {
      "id": "PAB-08",
      "name": "connector_path",
      "statement": "Verify a connector path when the incoming pose differs from the reversed disassembly terminal."
    },
    {
      "id": "PAB-09",
      "name": "sbdp_reproduction_boundary",
      "statement": "Claim SBDP reproduction only after translation exhaustion before rotation; otherwise label the path inspired or external."
    },
    {
      "id": "PAB-10",
      "name": "partition_update",
      "statement": "Update moving and fixed partitions at every real fastening, release, or removal boundary."
    },
    {
      "id": "PAB-11",
      "name": "saved_scene_readback",
      "statement": "Reopen the saved source scene and compare every admitted state before requesting a render."
    },
    {
      "id": "PAB-12",
      "name": "claim_caps_and_canonical_hash",
      "statement": "Persist claim caps; reject canonical-hash drift; never promote paper statistics, probes, proxies, or deferred deformables to target success."
    }
  ],
