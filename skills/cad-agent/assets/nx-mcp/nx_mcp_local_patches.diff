+_MASS_UNIT_NAMES = ["SquareMilliMeter", "CubicMilliMeter", "Kilogram", "MilliMeter", "MilliMeter", "Newton"]
+
+
+def _body_mass_properties(work_part, body) -> tuple[float, float | None]:
+    """(volume_mm3, mass_kg or None) via MeasureManager.NewMassProperties.
+
+    NXOpen.Body has no GetMassProperties in the Python binding. Mass uses the density NX assigns to
+    the body (a default when no material is assigned), so treat it as indicative only.
+    """
+    units = [work_part.UnitCollection.FindObject(name) for name in _MASS_UNIT_NAMES]
+    measure = work_part.MeasureManager.NewMassProperties(units, 0.99, [body])
+    try:
+        volume = float(measure.Volume)
+        try:
+            mass = float(measure.Mass)
+        except Exception:
+            mass = None
+        return volume, mass
+    finally:
+        try:
+            measure.Dispose()
+        except Exception:
+            pass
+
+
