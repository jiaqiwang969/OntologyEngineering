{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/cad-geometry/schema/semantic-activation-policy-v1.json",
  "title": "Independent semantic activation policy",
  "description": "Externally governed exact-digest trust closure for one or more release identifiers. A policy from the candidate origin manifest is not an independent trust root.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "policy_id",
    "version",
    "authority_manifest_sha256",
    "applies_to_release_ids",
    "trusted_artifacts",
    "reviewer_registry_sha256",
    "required_release_reviewer_roles",
    "required_activation_reviewer_roles",
    "unknown_policy",
    "review_model",
    "reviewer_separation_required",
    "rollback_required",
    "automatic_activation"
  ],
  "properties": {
    "schema": {"const": "cad-agent.semantic-activation-policy.v1"},
    "policy_id": {"$ref": "#/$defs/stableId"},
    "version": {"$ref": "#/$defs/semver"},
    "authority_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "applies_to_release_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stableId"}
    },
    "trusted_artifacts": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/trustedArtifact"}
    },
    "reviewer_registry_sha256": {"$ref": "#/$defs/sha256"},
    "required_release_reviewer_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "ReleaseAcceptanceReviewer"}
    },
    "required_activation_reviewer_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "ActivationReviewer"}
    },
    "unknown_policy": {"const": "Block"},
    "review_model": {"const": "SeparatedIndependentReviewers"},
    "reviewer_separation_required": {"const": true},
    "rollback_required": {"const": true},
    "automatic_activation": {"const": false}
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "role": {
      "enum": [
        "release_candidate",
        "release_assessment",
        "release_policy",
        "rollback_target_release",
        "current_bundle",
        "target_bundle",
        "tool_abi_registry",
        "observer_adapter_registry_manifest",
        "observer_adapter_registry_assessment",
        "action_link_registry",
        "action_link_assessment",
        "cq_regression_report",
        "rollback_canary_report"
      ]
    },
    "trustedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "schema", "sha256"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "schema": {"type": "string", "minLength": 2, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
