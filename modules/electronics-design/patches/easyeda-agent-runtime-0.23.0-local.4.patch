+
+test('Gerber SDK exceptions keep their original detail and never return an artifact', async () => {
+	const calls = mock({ gerberFail: true });
+	await assert.rejects(pcbExportGerber({ projectUuid: 'P', pcbUuid: 'B' }), (error: unknown) => {
+		assert.ok(error instanceof ActionError);
+		assert.equal(error.code, ErrorCodes.EDA_CALL_FAILED);
+		assert.equal(error.detail, 'native gerber generation failed');
+		return true;
+	});
+	assert.equal(calls.length, 1);
+});
+
+test('PCB context drift after export rejects bytes instead of returning the requested identity', async () => {
+	const calls = mock({ pcbSwitchAfter: true });
+	await assert.rejects(pcbExportGerber({ projectUuid: 'P', pcbUuid: 'B' }), (error: unknown) => {
+		assert.ok(error instanceof ActionError);
+		assert.equal(error.code, ErrorCodes.INVALID_STATE);
+		assert.match(error.message, /Current PCB does not match/);
+		return true;
