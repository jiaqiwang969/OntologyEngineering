  "paper_algorithm_routes": [
    {
      "id": "AAMERI_STATIC_SEMANTICS",
      "name": "Aameri-Cheong-Beck static assembly semantics",
      "applicability": [
        "Occurrence identity, boundary entity, incidence, mating-feature, connection, and relative-configuration modeling."
      ],
      "required_inputs": [
        "Occurrence-resolved BOM",
        "Boundary and mating-feature identities",
        "Connection-tree evidence"
      ],
      "produces": [
        "Static assembly relation semantics",
        "Connection and relative-configuration records"
      ],
      "does_not_prove": [
        "Fusion Joint frames or limits",
        "Current mechanism state",
        "Executable collision-free path",
        "Physical buildability"
      ],
      "capability_status": "LOCAL_ADAPTER",
      "claim_ceiling": "STATIC_ASSEMBLY_SEMANTICS_ONLY",
      "branch_refs": [
        "S7_GEOMETRY"
      ]
    },
    {
      "id": "AGRAWALA_ACTION_GRAPH",
      "name": "Agrawala action graph and exploded guidance",
      "applicability": [
        "Stepwise presentation after engineering order and certified states exist."
      ],
      "required_inputs": [
        "Certified partial order",
        "Certified state ledger",
        "Occurrence-complete connection tree"
      ],
      "produces": [
        "Action-graph presentation candidate",
        "Exploded-view guidance candidate"
      ],
      "does_not_prove": [
        "Missing occurrence recovery",
        "Engineering process order",
        "Clearance",
        "Force or physical release"
      ],
      "capability_status": "LITERATURE_ONLY",
      "claim_ceiling": "PRESENTATION_ORDER_CANDIDATE_ONLY",
      "branch_refs": [
        "S7_GEOMETRY"
      ]
    },
    {
      "id": "LI_DAG_SHORT_ESCAPE",
      "name": "Li DAG and unblocked short-escape removal",
      "applicability": [
        "Rigid exploded-layout partial-order and local direction candidate generation."
      ],
      "required_inputs": [
        "Occurrence-level interference relations",
        "Candidate directions",
        "Current fixed and moving partition"
      ],
      "produces": [
        "DAG partial-order candidate",
        "Unblocked short-escape candidate"
      ],
      "does_not_prove": [
        "Shop-floor process truth",
        "Continuous full-path clearance",
        "Stability or physical release"
      ],
      "capability_status": "LITERATURE_ONLY",
      "claim_ceiling": "PARTIAL_ORDER_AND_DIRECTION_CANDIDATE_ONLY",
      "branch_refs": [
        "S7_GEOMETRY",
        "S9_DIRECTION_PROBE"
      ]
    },
    {
      "id": "ATA_REVERSE_DISASSEMBLY",
      "name": "Assemble Them All reverse-disassembly state sequence",
      "applicability": [
        "Rigid disassembly candidate generation followed by exact reversal of ordered absolute states."
      ],
      "required_inputs": [
        "Authoritative q0",
        "Mover and fixed identities",
        "Ordered absolute disassembly states",
        "PAB-01 through PAB-12"
      ],
      "produces": [
        "Ordered disassembly-state candidate",
        "Reverse-ordered assembly-state candidate"
      ],
      "does_not_prove": [
        "Independent continuous geometry clearance",
        "Contact-force validity",
        "Physical buildability"
      ],
      "capability_status": "CASE_PROVEN_NOT_GENERALIZED",
      "claim_ceiling": "ORDERED_STATE_CANDIDATE_ONLY",
      "branch_refs": [
        "S7_GEOMETRY"
      ]
    },
    {
      "id": "ASAP_STABILITY",
      "name": "ASAP gravity, support, and finite-hold stability",
      "applicability": [
        "Sequence candidates whose gravity, support, or finite holding stability affects feasibility."
      ],
      "required_inputs": [
        "Sequence candidate",
        "Gravity and support model",
        "Finite holding assumptions"
      ],
      "produces": [
        "Sequence-stability candidate classification"
      ],
      "does_not_prove": [
        "Continuous geometric path",
        "Contact transfer",
        "Fixture-qualified physical release"
      ],
      "capability_status": "LITERATURE_ONLY",
      "claim_ceiling": "SEQUENCE_STABILITY_CANDIDATE_ONLY",
      "branch_refs": [
        "P_CONTACT_PHYSICS",
        "S11_PHYSICAL"
      ]
    },
    {
      "id": "SBDP_DBG_INSPIRED",
      "name": "SBDP direction-blocking-graph inspired planner",
      "applicability": [
        "Rigid planning candidate using state memory, direction-blocking priors, translation before rotation, and fixed-set updates."
      ],
      "required_inputs": [
        "Authoritative q0",
        "Direction-blocking relations",
        "Translation-exhaustion record",
        "Partition updates",
        "PAB-01 through PAB-12"
      ],
      "produces": [
        "SBDP-inspired path candidate"
      ],
      "does_not_prove": [
        "Full SBDP reproduction",
        "Transfer of paper benchmark success rate",
        "Continuous path or physical success"
      ],
      "capability_status": "LOCAL_ADAPTER",
      "claim_ceiling": "INSPIRED_PATH_CANDIDATE_ONLY",
      "branch_refs": [
        "S7_GEOMETRY"
      ]
    },
    {
      "id": "IPC_LIBUIPC",
      "name": "IPC and libuipc contact simulation",
      "applicability": [
        "Short-prefix rigid direction probing or separately contracted rigid/deformable contact transfer."
      ],
      "required_inputs": [
        "Hash-bound world poses",
        "SI units and body roles",
        "Error-bounded solver geometry",
        "Version-pinned solver contract",
        "S9-FC or CP checks for the selected branch"
      ],
      "produces": [
        "Direction-only response evidence",
        "Modeled contact-transfer evidence when the P-level contract is complete"
      ],
      "does_not_prove": [
        "Global assembly planning",
        "Exact B-Rep clearance",
        "Motor capacity from servo strength",
        "Mechanical relock",
        "Physical release"
      ],
      "capability_status": "CASE_PROVEN_NOT_GENERALIZED",
      "claim_ceiling": "MODELED_PHYSICS_ONLY",
      "branch_refs": [
        "S9_DIRECTION_PROBE",
        "P_CONTACT_PHYSICS"
      ]
    },
    {
      "id": "FACTORY_THREADED_CONTACT",
      "name": "Factory or equivalent threaded-contact model",
      "applicability": [
        "Thread engagement, nut-bolt insertion, screw driving, seating torque, or cross-thread claims."
      ],
      "required_inputs": [
        "Thread geometry and state",
        "Friction and controller model",
        "Torque model",
        "Target-hardware calibration"
      ],
      "produces": [
        "Dedicated threaded-contact candidate evidence"
      ],
      "does_not_prove": [
        "Target threaded-contact success before project qualification",
        "Physical release"
      ],
      "capability_status": "LITERATURE_ONLY",
      "claim_ceiling": "THREADED_CONTACT_CANDIDATE_ONLY",
      "branch_refs": [
        "THREADED_CONTACT"
      ]
    }
  ],
