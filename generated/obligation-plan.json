{"obligations": [
  {
    "constraint": "md_drawing_route",
    "obligation": "ob_drawing_converter_identity",
    "requirement": "req_md_drawing_route",
    "statement": "Only the locked converter runs: its repository, commit and digest match the compiled lock and its local record and its reported version matches the lock before it runs, and the conversion runs without fonts"
  },
  {
    "constraint": "md_review_page",
    "obligation": "ob_drawing_faithful_page",
    "requirement": "req_md_drawing_route",
    "statement": "The review page embeds the frozen graph and the neutral rendering unchanged, refuses active rendering content and passes its browser checks in every display mode"
  },
  {
    "constraint": "md_engineering_expression",
    "obligation": "ob_drawing_no_invented_target",
    "requirement": "req_md_engineering_expression",
    "statement": "No expression names a part feature, face or requirement target; targets stay unknown until separately supported"
  },
  {
    "constraint": "md_engineering_expression",
    "obligation": "ob_drawing_partial_intervals_on_lines",
    "requirement": "req_md_engineering_expression",
    "statement": "A member covers part of a source only when the source is a qualified LINE; every other source is used whole, in the graph and on the page"
  },
  {
    "constraint": "md_drawing_route",
    "obligation": "ob_drawing_recorded_run",
    "requirement": "req_md_drawing_route",
    "statement": "Each run records the digests of its inputs and outputs, the executable, the converter lock and the fixed environment, stops at the first failure, and the drawing is unchanged at the end"
  },
  {
    "constraint": "md_engineering_expression",
    "obligation": "ob_drawing_source_conservation",
    "requirement": "req_md_engineering_expression",
    "statement": "Every model-space graphic root of the source is kept with its native type, layer, owner and native members, and every source domain is covered by member intervals"
  },
  {
    "constraint": "md_drawing_route",
    "obligation": "ob_drawing_source_only_worker",
    "requirement": "req_md_drawing_route",
    "statement": "Classification sees only the DXF bytes: an isolated worker under a deny-default sandbox receives them on stdin with no path, Project, request, reference or answer, and the worker that ran is identified"
  },
  {
    "constraint": "md_engineering_expression",
    "obligation": "ob_drawing_structural_lines",
    "requirement": "req_md_engineering_expression",
    "statement": "Every outline member outside a section profile and every inferred span is in exactly one structural line of its own view and outline class, and each line is drawn once with inferred spans at their source end points"
  }
],
