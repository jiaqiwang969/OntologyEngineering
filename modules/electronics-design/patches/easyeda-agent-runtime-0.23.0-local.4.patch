index 0000000..35feca9
--- /dev/null
+++ b/extension/src/wire-decoder.ts
@@ -0,0 +1,97 @@
+import { ActionError, ErrorCodes } from './protocol';
+
+export type WireSegment = [number, number, number, number];
+export type WirePoint = [number, number];
+
+/**
+ * Read encoding inspected in EasyEDA Pro 3.2.148: get/getAll flatten independent
+ * segment4 groups; create may return nested segment4 groups. Neither is a
+ * continuous point traversal. Do not use this decoder for a caller's polyline.
+ */
+export function decodeWireSegments(line: unknown): WireSegment[] {
+	if (!Array.isArray(line)) throw invalid('wire line is not an array');
+	if (line.length === 0) return [];
+	let groups: unknown[];
+	if (Array.isArray(line[0])) groups = line;
+	else {
+		if (line.length % 4 !== 0) throw invalid('wire getter requires independent segment4 groups');
+		groups = [];
+		for (let i = 0; i < line.length; i += 4) groups.push(line.slice(i, i + 4));
+	}
+	return groups.map(segment => {
+		if (!Array.isArray(segment) || segment.length !== 4 || !segment.every(v => typeof v === 'number' && Number.isFinite(v))) {
+			throw invalid('wire segment must contain exactly four finite coordinates');
+		}
+		return [...segment] as WireSegment;
+	});
+}
+
+function invalid(message: string): ActionError {
+	return new ActionError(ErrorCodes.INVALID_STATE, `Unsupported schematic wire geometry: ${message}.`);
+}
+
+/**
+ * Termini of an unordered/reversed segment tree. Deliberately rejects graphs
+ * whose topology is not represented by explicit segment endpoints. A rejection
+ * means this checker cannot classify that encoding, not that the circuit is bad.
+ */
+export function wireTreeEndpoints(segments: WireSegment[], epsilon: number): WirePoint[] {
+	const nodes: Array<{ point: WirePoint; adjacent: Set<number> }> = [];
+	const node = (x: number, y: number): number => {
+		let i = nodes.findIndex(n => Math.hypot(n.point[0] - x, n.point[1] - y) <= epsilon);
+		if (i < 0) { i = nodes.length; nodes.push({ point: [x, y], adjacent: new Set() }); }
+		return i;
+	};
+	const edges: Array<[number, number]> = [];
+	for (const [x0, y0, x1, y1] of segments) {
+		const a = node(x0, y0), b = node(x1, y1);
+		if (a === b) continue; // whole-group zero length is reported by the caller
+		if (nodes[a].adjacent.has(b)) throw invalid('duplicate/overlapping wire segment');
+		nodes[a].adjacent.add(b); nodes[b].adjacent.add(a); edges.push([a, b]);
+	}
+	if (!edges.length) return nodes.map(n => n.point);
+	for (const [a, b] of edges) {
+		const [x0, y0] = nodes[a].point, [x1, y1] = nodes[b].point;
+		const dx = x1 - x0, dy = y1 - y0, length = Math.hypot(dx, dy);
+		if (!Number.isFinite(length)) throw invalid('wire coordinates exceed finite geometry range');
+		for (let i = 0; i < nodes.length; i++) {
+			if (i === a || i === b) continue;
+			const [x, y] = nodes[i].point;
+			const t = ((x - x0) * dx + (y - y0) * dy) / (length * length);
+			if (t > 0 && t < 1 && Math.abs((x - x0) * dy - (y - y0) * dx) <= epsilon * length) {
+				throw invalid('unsplit junction/overlapping wire segment');
+			}
+		}
+	}
+	// A bow-tie can be an acyclic endpoint graph while crossing in the middle.
+	// Do not guess whether that unsplit intersection is electrically joined.
+	for (let i = 0; i < edges.length; i++) {
+		const [a, b] = edges[i], [ax, ay] = nodes[a].point, [bx, by] = nodes[b].point;
+		for (let j = i + 1; j < edges.length; j++) {
+			const [c, d] = edges[j];
+			if (a === c || a === d || b === c || b === d) continue;
+			const [cx, cy] = nodes[c].point, [dx, dy] = nodes[d].point;
+			const rx = bx - ax, ry = by - ay, sx = dx - cx, sy = dy - cy;
+			const cross = rx * sy - ry * sx;
+			if (!Number.isFinite(cross)) throw invalid('wire intersection exceeds finite geometry range');
+			if (cross === 0) continue;
+			const t = ((cx - ax) * sy - (cy - ay) * sx) / cross;
+			const u = ((cx - ax) * ry - (cy - ay) * rx) / cross;
+			if (!Number.isFinite(t) || !Number.isFinite(u)) throw invalid('wire intersection exceeds finite geometry range');
+			const tolA = epsilon / Math.hypot(rx, ry), tolB = epsilon / Math.hypot(sx, sy);
+			if (t > tolA && t < 1 - tolA && u > tolB && u < 1 - tolB) {
+				throw invalid('unsplit interior crossing inside a wire group');
+			}
+		}
+	}
+	const seen = new Set<number>(), pending = [edges[0][0]];
+	while (pending.length) {
+		const i = pending.pop()!;
+		if (seen.has(i)) continue;
+		seen.add(i); pending.push(...nodes[i].adjacent);
+	}
+	if (seen.size !== nodes.length || edges.length !== nodes.length - 1) {
+		throw invalid('disconnected or cyclic wire group is outside the tree endpoint profile');
+	}
+	return nodes.filter(n => n.adjacent.size === 1).map(n => n.point);
+}
