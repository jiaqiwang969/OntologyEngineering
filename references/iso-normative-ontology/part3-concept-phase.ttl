isoN:P3_6_4_2_2 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.2.2" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 13 ; isoN:blockIndex 18 ;
    isoN:zhGloss "危害须被系统地识别（可用 HAZOP 引导词、FMEA 类方法等）；头脑风暴、检查表、质量履历与现场研究可以补网，但不能单独证明网外已空。" ;
    isoN:keywords "危害识别、系统方法、HAZOP" ;
    isoN:servesChapter "ch04 §4.4.2" ;
    isoN:glossStatus "glossed" .

isoN:P3_6_4_2_3 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.2.3" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 13 ; isoN:blockIndex 21 ;
    isoN:glossStatus "pending" .

isoN:P3_6_4_2_4 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.2.4" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 14 ; isoN:blockIndex 1 ;
    isoN:zhGloss "电击、烟雾、火灾、毒性等危害只有当由相关项的电子电气失常引发时才进入本标准范围，否则按组织其他程序分流。" ;
    isoN:keywords "范围边界、非失常危害" ;
    isoN:servesChapter "ch04 §4.4.2" ;
    isoN:glossStatus "glossed" .

isoN:P3_6_4_2_5 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.2.5" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 14 ; isoN:blockIndex 3 ;
    isoN:glossStatus "pending" .

isoN:P3_6_4_2_6 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.2.6" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 14 ; isoN:blockIndex 4 ;
    isoN:zhGloss "危害事件的后果须被识别；一个失常同时带走多个功能时须评估组合效应，不得拆行各自判完。" ;
    isoN:keywords "后果、组合效应" ;
    isoN:servesChapter "ch04 §4.4.2" ;
    isoN:glossStatus "glossed" .

isoN:P3_6_4_2_7 a isoN:NormativeUnit ;
    isoN:clauseId "3-6.4.2.7" ; isoN:partNumber 3 ;
    isoN:modality isoN:Shall ;
    isoN:pageIndex 14 ; isoN:blockIndex 8 ;
    isoN:zhGloss "不得为降低暴露概率而把一个运行情形切分成没有机理差异的子场景；有证据意义的区分（如干湿路面改变可控性）才允许。" ;
    isoN:keywords "运行情形、切分纪律、暴露概率" ;
    isoN:servesChapter "ch04 §4.4.2" ;
    isoN:glossStatus "glossed" .

